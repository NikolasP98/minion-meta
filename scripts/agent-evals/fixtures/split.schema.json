{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://minion.ai/schemas/eval-split-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "entries"],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episodeId",
          "clusterId",
          "leakageGroupId",
          "contentSha256",
          "episodeSha256",
          "labelSha256",
          "split",
          "body",
          "labels"
        ],
        "properties": {
          "episodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "clusterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "leakageGroupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "episodeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "labelSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "split": {
            "enum": ["development", "holdout"]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "labels": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
