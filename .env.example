# Minion Meta-Repo — required secret variable names
# See packages/env/README.md for authentication and secret locations.
# @minion/env validates required vars and reports missing ones.

# Infisical machine-identity auth (for @minion/env)
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Infisical cache mode: disk (default, machine-sealed cross-process cache),
# memory (process memo only), or off (never cache; use on CI and shared machines).
# MINION_ENV_CACHE=disk

# Optional operator key for the disk cache. Must be canonical standard base64
# that decodes to exactly 32 bytes. If unset, Minion creates a local cache.key.
# MINION_ENV_CACHE_KEY=

# App-level secret encryption (@minion-stack/db crypto — sealed OAuth refresh
# tokens, gateway tokens, channel credentials). Required in EVERY environment
# that seals or opens secrets; without it sealSecret()/openSecret() throw.
ENCRYPTION_KEY=

# LOCAL DEVELOPMENT ONLY — never set in a deployed environment. `1` or `true`
# accepts the built-in, source-visible development key instead of a real
# ENCRYPTION_KEY. Refused outright under NODE_ENV=production.
# MINION_ALLOW_DEV_CRYPTO_KEY=
