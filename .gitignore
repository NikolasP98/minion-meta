# ============================================================
# Minion Meta-Repo — Root .gitignore
# Subprojects are INDEPENDENT git repos and are ignored here.
# Meta-repo tracks only orchestration, specs, and shared packages — see
# AGENTS.md for the authoritative inventory.
# ============================================================

# ---- Dependencies ----
node_modules/
.pnpm-store/
.yarn/
.npm/

# ---- Build outputs ----
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/

# ---- SvelteKit / Vite ----
.svelte-kit/
vite.config.ts.timestamp-*

# ---- TypeScript ----
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---- Bun ----
bun.lockb

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.defaults

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.serena/

# ---- Logs ----
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ---- Coverage & test outputs ----
coverage/
.nyc_output/
playwright-report/
test-results/

# ---- Turbo (not used but defensive) ----
.turbo/

# ---- Docker ----
*.env.docker

# ---- Drizzle / DB ----
*.db
*.db-shm
*.db-wal
data/
.pglite/

# ---- LanceDB (memory extension) ----
*.lance/
lancedb/

# ---- Generated files ----
minion/src/channels/_generated/
minion/packages/plugin-sdk/dist/

# ---- Fly.io ----
fly.toml.bak

# ============================================================
# Subprojects — independent repos, intentionally ignored
# ============================================================
minion/
minion_hub/
minion_site/
minion_plugins/
paperclip-minion/
pixel-agents/
omnisearch/
minion_base/
minion_factory/
# Post-Phase-1 worktrees (already removed — defensive anti-resurrection entries):
paperclip-pi-fallback/
paperclip-meta-repair/

# ============================================================
# Local agent config directories
# ============================================================
.claude/
.claudian/
.obsidian/
/.firstmate/

# ============================================================
# Ephemeral / cloned projects inside meta-repo
# ============================================================
agent-chat-ui/
deep-agents-ui/
minion.worktrees/
utec-ia-productos
drone/
.hermes/
.prototypes/
supabase/.branches/
supabase/.temp/
packages/.understand-anything/
packages/db/*.tgz

# ============================================================
# Local config files
# ============================================================
.mcp.json
nodes.md

# ============================================================
# VAULT symlinks (point at ~/Documents/VAULT/MINION/*)
# ============================================================
ai-studio
docs
Minion Docs/
knowledge/

# Synology Drive / rclone sync artifacts
.SynologyWorkingDirectory/
RCLONE_TEST

# ============================================================
# Root one-off state files NOT tracked in meta-repo
# ============================================================
entities.json
mempalace.yaml
mascot.png
agents/
# DB/state backups + generated reports (never tracked)
turso-*.sql
memory-architecture-report.html
recon-openclaw-hermes-agentzero-2026-06-10.md
# Patient/clinic data + financial reports — PII, never commit
Historia Clinica (Respuestas).xlsx
*.xlsx

# ============================================================
# .playwright-mcp / .playwright-cli ephemeral browser state
# ============================================================
.playwright-mcp/
.playwright-cli/

# local business-data exports (FACES SUSII) — keep out of git
export*.csv
export (*.csv
/.lavish/
/.worktrees/

# graphify render output — 131MB of generated artefacts, never a source input
/graphify-out/
# curl/httpie cookie jars: these hold live session credentials. Not ignoring
# them means one `git add -A` publishes a working session to the remote.
cookies.txt
**/cookies.txt
