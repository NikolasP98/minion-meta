+    const start = page.getByRole('button', { name: 'Call your agent', exact: true });
+    expect((await start.boundingBox())?.height).toBe(40);
+    await start.focus();
+    await page.keyboard.press('Enter');
+    const mute = page.getByRole('button', { name: 'Mute', exact: true });
