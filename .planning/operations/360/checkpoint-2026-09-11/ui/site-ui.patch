@@ -0,0 +1,33 @@
+import { env } from '$env/dynamic/private';
+import { getAuth } from '$lib/auth/auth';
+import type { RequestEvent } from '@sveltejs/kit';
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+type LogoutEvent = Pick<RequestEvent, 'request' | 'url'> & {
+  locals: { supabase?: { auth: Pick<SupabaseClient['auth'], 'signOut'> } };
+};
+
+function result(success: boolean, status = 200) {
+  return Response.json({ success }, { status, headers: { 'cache-control': 'no-store' } });
+}
+
+/** Revoke the current request session through the provider selected by server hooks. */
+export async function POST({ request, url, locals }: LogoutEvent): Promise<Response> {
+  if (request.method !== 'POST') return result(false, 405);
+  if (request.headers.get('origin') !== url.origin) return result(false, 403);
+
+  try {
+    if (env.AUTH_PROVIDER === 'supabase') {
+      if (!locals.supabase) return result(false, 503);
+      const { error } = await locals.supabase.auth.signOut({ scope: 'local' });
+      return result(!error, error ? 502 : 200);
+    }
+
+    // TODO(handoff): Qualify durable revocation with disposable provider sessions;
+    // Better Auth can report success after a storage deletion failure. See 13-09-PLAN.md.
+    // Preserve the provider's cookie deletions, status and body as one response.
+    return await getAuth().api.signOut({ headers: request.headers, asResponse: true });
+  } catch {
+    return result(false, 502);
+  }
+}
