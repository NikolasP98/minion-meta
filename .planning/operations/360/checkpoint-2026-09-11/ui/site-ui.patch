index 0000000..e581a4f
--- /dev/null
+++ after/src/lib/components/members/AppBar.test.ts
@@ -0,0 +1,129 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mount, tick, unmount } from 'svelte';
+import { resetMemberState } from '$lib/state/member.svelte';
+import { setLanguageTag } from '$lib/paraglide/runtime';
+import AppBar from './AppBar.svelte';
+
+const legacy = vi.hoisted(() => ({ signOut: vi.fn() }));
+vi.mock('$lib/auth/auth-client', () => ({ authClient: legacy }));
+let target: HTMLDivElement;
+let component: ReturnType<typeof mount> | undefined;
+let redirects: string[];
+const request = vi.fn<typeof fetch>();
+const response = (success: boolean, status = 200) =>
+  new Response(JSON.stringify({ success }), {
+    status,
+    headers: { 'content-type': 'application/json' },
+  });
+const button = () => target.querySelector('button')!;
+async function start() {
+  component = mount(AppBar, {
+    target,
+    props: {
+      user: { id: 'fixture-user', email: 'fixture@example.invalid', displayName: 'Fixture User' },
+    },
+  });
+  await tick();
+}
+beforeEach(() => {
+  vi.resetAllMocks();
+  resetMemberState();
+  setLanguageTag('en');
+  target = document.createElement('div');
+  document.body.append(target);
+  redirects = [];
+  vi.spyOn(window.location, 'assign').mockImplementation((url) => {
+    redirects.push(String(url));
+  });
+  vi.spyOn(window.location, 'href', 'set').mockImplementation((url) => {
+    redirects.push(url);
+  });
+  vi.stubGlobal('fetch', request);
+  request.mockResolvedValue(response(true));
+  legacy.signOut.mockResolvedValue({ data: { success: true } });
+});
+afterEach(async () => {
+  if (component) await unmount(component);
+  component = undefined;
+  target.remove();
+  resetMemberState();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe('AppBar logout uses the selected server provider', () => {
+  it('renders actual member identity and a sign-out control', async () => {
+    await start();
+    expect(target.textContent).toContain('Fixture User');
+    expect(button().textContent).toContain('Sign out');
+  });
+  it('uses the same-origin endpoint and navigates only after reported success', async () => {
+    await start();
+    button().click();
+    await vi.waitFor(() => expect(redirects).toEqual(['/login']));
+    expect(request).toHaveBeenCalledWith(
+      '/auth/logout',
+      expect.objectContaining({ method: 'POST', credentials: 'same-origin' }),
+    );
+    expect(legacy.signOut).not.toHaveBeenCalled();
+  });
+  it('admits one request during a deferred attempt, including two clicks before a render', async () => {
+    let finish!: (value: Response) => void;
+    request.mockReturnValue(
+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+    );
+    await start();
+    button().click();
+    button().click();
+    await tick();
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(button().disabled).toBe(true);
+    expect(button().getAttribute('aria-busy')).toBe('true');
+    expect(redirects).toEqual([]);
+    finish(response(true));
+    await vi.waitFor(() => expect(redirects).toEqual(['/login']));
+  });
+  it('keeps a failed session in place and offers a visible retry', async () => {
+    request.mockResolvedValueOnce(response(false, 503)).mockResolvedValueOnce(response(true));
+    await start();
+    button().click();
+    await vi.waitFor(() =>
+      expect(target.querySelector('[role="alert"]')?.textContent).toContain(
+        "Couldn't sign out. Try again.",
+      ),
+    );
+    expect(redirects).toEqual([]);
+    expect(button().disabled).toBe(false);
+    button().click();
+    await vi.waitFor(() => expect(redirects).toEqual(['/login']));
+    expect(request).toHaveBeenCalledTimes(2);
+  });
+  it.each([
+    ['network rejection', () => Promise.reject(new Error('private provider canary'))],
+    ['false success', () => Promise.resolve(response(false))],
+    ['malformed response', () => Promise.resolve(new Response('private provider canary'))],
+  ])('does not redirect or show raw details after %s', async (_name, result) => {
+    request.mockImplementation(result);
+    await start();
+    button().click();
+    await vi.waitFor(() => expect(target.querySelector('[role="alert"]')).not.toBeNull());
+    expect(target.textContent).not.toContain('private provider canary');
+    expect(redirects).toEqual([]);
+    expect(button().disabled).toBe(false);
+  });
+  it('announces a localized Spanish failure and permits retry', async () => {
+    setLanguageTag('es');
+    request.mockResolvedValue(response(false, 502));
+    await start();
+    expect(button().textContent).toContain('Cerrar sesión');
+    button().click();
+    await vi.waitFor(() =>
+      expect(target.querySelector('[role="alert"]')?.textContent).toContain(
+        'No se pudo cerrar la sesión. Inténtalo de nuevo.',
+      ),
+    );
+    expect(redirects).toEqual([]);
+  });
+});
