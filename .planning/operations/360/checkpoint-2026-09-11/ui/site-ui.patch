+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { flushSync, mount, tick, unmount } from 'svelte';
+import { memberState, resetMemberState } from '$lib/state/member.svelte';
+import FilesTab from './FilesTab.svelte';
+
+const gateway = vi.hoisted(() => ({ fetchFiles: vi.fn(), sendReq: vi.fn() }));
+vi.mock('$lib/services/member-gateway.svelte', () => gateway);
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+let target: HTMLDivElement;
+let component: ReturnType<typeof mount> | undefined;
+const button = (path: string) =>
+  [...target.querySelectorAll('button')].find((el) => el.textContent?.trim() === path)!;
+async function start() {
+  component = mount(FilesTab, { target });
+  await tick();
+  await vi.waitFor(() => expect(button('A.txt')).toBeDefined());
+}
+beforeEach(() => {
+  vi.resetAllMocks();
+  resetMemberState();
+  memberState.agentId = 'agent-a';
+  memberState.connected = true;
+  gateway.fetchFiles.mockResolvedValue({ files: [{ path: 'A.txt' }, { path: 'B.txt' }] });
+  target = document.createElement('div');
+  document.body.append(target);
+});
+afterEach(async () => {
+  if (component) await unmount(component);
+  component = undefined;
+  target.remove();
+  resetMemberState();
+});
+
+describe('FilesTab owns each asynchronous selection', () => {
+  it('renders a selected file through the actual component', async () => {
+    gateway.sendReq.mockResolvedValue({ content: 'Current content' });
+    await start();
+    button('A.txt').click();
+    await vi.waitFor(() =>
+      expect(target.querySelector('pre')?.textContent).toBe('Current content'),
+    );
+    expect(gateway.sendReq).toHaveBeenCalledWith('agent.file.read', {
+      agentId: 'agent-a',
+      path: 'A.txt',
+    });
+  });
+  it('does not publish A after B has become the selected file', async () => {
+    const a = deferred<string>();
+    const b = deferred<string>();
+    gateway.sendReq.mockReturnValueOnce(a.promise).mockReturnValueOnce(b.promise);
+    await start();
+    button('A.txt').click();
