+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { flushSync, mount, tick, unmount } from 'svelte';
+import { memberState, resetMemberState } from '$lib/state/member.svelte';
+import { setLanguageTag } from '$lib/paraglide/runtime';
+import ChatTab from './ChatTab.svelte';
+
+const gateway = vi.hoisted(() => ({ sendChatMsg: vi.fn() }));
+vi.mock('$lib/services/member-gateway.svelte', () => gateway);
+let target: HTMLDivElement;
+let component: ReturnType<typeof mount> | undefined;
+const scroll = vi.fn();
+const listeners = new Set<(event: MediaQueryListEvent) => void>();
+let reduced = true;
+let originalScroll: PropertyDescriptor | undefined;
+let removes: number;
+
+async function start() {
+  component = mount(ChatTab, { target });
+  await tick();
+  await tick();
+}
+function input() {
+  return target.querySelector('textarea')!;
+}
+function key(options: KeyboardEventInit = {}) {
+  const event = new KeyboardEvent('keydown', {
+    key: 'Enter',
+    bubbles: true,
+    cancelable: true,
+    ...options,
+  });
+  input().dispatchEvent(event);
+  return event;
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  resetMemberState();
+  setLanguageTag('en');
+  memberState.agentId = 'fixture-agent';
+  memberState.connected = true;
+  memberState.chat.inputText = 'Hello';
+  target = document.createElement('div');
+  document.body.append(target);
+  originalScroll = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'scrollIntoView');
+  Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', {
+    configurable: true,
+    value: scroll,
+  });
+  reduced = true;
+  removes = 0;
+  listeners.clear();
+  vi.stubGlobal(
+    'matchMedia',
+    vi.fn(() => ({
+      get matches() {
+        return reduced;
+      },
+      media: '(prefers-reduced-motion: reduce)',
+      onchange: null,
+      addEventListener: (_name: string, listener: (event: MediaQueryListEvent) => void) =>
+        listeners.add(listener),
+      removeEventListener: (_name: string, listener: (event: MediaQueryListEvent) => void) => {
+        listeners.delete(listener);
+        removes++;
+      },
+      addListener: vi.fn(),
+      removeListener: vi.fn(),
+      dispatchEvent: vi.fn(),
+    })),
+  );
+});
+afterEach(async () => {
+  if (component) await unmount(component);
+  component = undefined;
+  target.remove();
+  resetMemberState();
+  if (originalScroll)
+    Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', originalScroll);
+  else Reflect.deleteProperty(HTMLElement.prototype, 'scrollIntoView');
+  vi.unstubAllGlobals();
+});
+
+describe('member chat input and rendering', () => {
+  it('preserves ordinary Enter activation and Shift+Enter editing', async () => {
+    await start();
+    expect(key({ shiftKey: true }).defaultPrevented).toBe(false);
+    expect(gateway.sendChatMsg).not.toHaveBeenCalled();
+    expect(key().defaultPrevented).toBe(true);
+    expect(gateway.sendChatMsg).toHaveBeenCalledTimes(1);
+  });
+  it.each([{ isComposing: true }, { keyCode: 229 }])(
+    'does not submit composition input %j',
+    async (options) => {
+      await start();
+      expect(key(options).defaultPrevented).toBe(false);
+      expect(gateway.sendChatMsg).not.toHaveBeenCalled();
+    },
+  );
+  it('exposes a localized accessible composer name', async () => {
+    await start();
+    expect(input().getAttribute('aria-label')).toBe('Message your agent');
+  });
+  it.each([false, true])(
+    'renders an incoming stream with no history while loading=%s',
+    async (loading) => {
+      memberState.chat.loading = loading;
+      memberState.chat.stream = 'First streamed reply';
+      await start();
+      expect(target.textContent).toContain('First streamed reply');
+      expect(target.textContent).not.toContain('No messages yet');
+    },
+  );
+  it('preserves text-only historical content and does not interpret markup', async () => {
+    memberState.chat.messages = [
+      {
+        role: 'assistant',
+        content: [
+          { type: 'text', text: '<script>fixture</script>' },
+          { type: 'image', source: 'not-displayed' },
+        ],
+      },
+    ];
+    await start();
+    expect(target.textContent).toContain('<script>fixture</script>');
+    expect(target.textContent).not.toContain('not-displayed');
+    expect(target.querySelector('script')).toBeNull();
+  });
+  it('projects gateway errors into fixed localized feedback', async () => {
+    memberState.chat.lastError = 'private-provider-token-canary';
+    await start();
+    expect(target.textContent).not.toContain('private-provider-token-canary');
+    expect(target.querySelector('[role="alert"]')?.textContent).toContain(
+      "Couldn't complete the conversation. Try again.",
+    );
+  });
+  it('keeps empty and disconnected submit controls unavailable', async () => {
+    memberState.chat.inputText = '';
+    await start();
+    expect(target.querySelector('button')?.disabled).toBe(true);
+    memberState.connected = false;
+    await tick();
+    expect(input().disabled).toBe(true);
+  });
+  it('respects reduced motion and responds to a preference change', async () => {
+    await start();
+    expect(scroll).toHaveBeenLastCalledWith({ behavior: 'auto', block: 'end' });
+    reduced = false;
+    for (const listener of listeners) listener({ matches: false } as MediaQueryListEvent);
+    memberState.chat.stream = 'More text';
+    await tick();
+    await tick();
+    expect(scroll).toHaveBeenLastCalledWith({ behavior: 'smooth', block: 'end' });
+    await unmount(component!);
+    component = undefined;
+    expect(listeners.size).toBe(0);
+    expect(removes).toBeGreaterThan(0);
+  });
+  it('does not scroll a retired component after a scheduled tick', async () => {
+    component = mount(ChatTab, { target });
+    flushSync();
+    const closing = unmount(component);
+    component = undefined;
+    await closing;
+    await tick();
+    expect(scroll).not.toHaveBeenCalled();
+  });
+});
