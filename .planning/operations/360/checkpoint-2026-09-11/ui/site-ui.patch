+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+import net from 'node:net';
+import tls from 'node:tls';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const root = await fs.realpath(path.resolve(here, '../../..'));
+const allowedBase = path.resolve(root, '../chat-output');
+const outDir = path.resolve(process.argv[2] ?? path.join(allowedBase, 'v1'));
+if (!outDir.startsWith(allowedBase + path.sep)) throw Error('Output outside private chat-output');
+for (let current = outDir; current !== path.dirname(current); current = path.dirname(current)) {
+  const info = await fs.lstat(current).catch((error) => {
+    if (error.code !== 'ENOENT') throw error;
+  });
+  if (info?.isSymbolicLink()) throw Error('Linked output ancestor');
+}
+await fs.mkdir(outDir, { recursive: true });
+if ((await fs.readdir(outDir)).length) throw Error('Use a fresh output directory');
+let networkAttempts = 0;
+const deny = () => {
+  networkAttempts++;
+  throw Error('Native network forbidden in fixture build');
+};
+net.Socket.prototype.connect = deny;
+tls.connect = deny;
+globalThis.fetch = deny;
+const [{ build }, { svelte }, { default: tailwindcss }] = await Promise.all([
+  import('vite'),
+  import('@sveltejs/vite-plugin-svelte'),
+  import('@tailwindcss/vite'),
+]);
+const digest = (value) => createHash('sha256').update(value).digest('hex');
+const entry = '\0member-chat-entry';
+const gateway = '\0member-chat-gateway';
+const pageStore = '\0member-chat-page-store';
+const statePath = path.join(root, 'src/lib/state/member.svelte.ts');
+const gatewaySource = `
+import {memberState,pushChatMessage} from ${JSON.stringify(statePath)};
+const calls=[];
+export function wsConnect(){calls.push({method:'connect',url:memberState.serverUrl});memberState.connected=true;}
+export function wsDisconnect(){calls.push({method:'disconnect'});memberState.connected=false;}
+export function sendChatMsg(){
+ calls.push({method:'activate-send',text:memberState.chat.inputText});
+ const chat=memberState.chat;
+ if(!memberState.connected||!memberState.agentId||chat.sending||!chat.inputText.trim())return;
+ pushChatMessage({role:'user',content:chat.inputText.trim()});chat.inputText='';chat.sending=true;
+}
+export async function fetchFiles(){calls.push({method:'files'});return {files:[]};}
+export async function fetchKGSnapshot(){calls.push({method:'graph'});return {nodes:[],edges:[]};}
+export async function sendReq(method){if(method!=='agent.file.read')throw Error('Unexpected fixture method');calls.push({method});return '';}
+export const controls={
+ calls:()=>calls.map(call=>({...call})),
+ input:text=>{memberState.chat.inputText=text;},
+ stream:(text,loading=false)=>{memberState.chat.messages=[];memberState.chat.stream=text;memberState.chat.loading=loading;},
+ history:text=>{memberState.chat.messages=[{role:'assistant',content:text}];memberState.chat.stream=null;memberState.chat.loading=false;},
+ error:text=>{memberState.chat.lastError=text;memberState.chat.sending=false;},
+ connected:value=>{memberState.connected=value;},
+ finish:()=>{memberState.chat.sending=false;},
+};`;
+const authority = [
+  'src/routes/(app)/members/+page.svelte',
+  'src/lib/components/members/ChatTab.svelte',
+  'src/lib/components/members/TabBar.svelte',
+  'src/lib/components/members/AppBar.svelte',
+  'src/lib/state/member.svelte.ts',
+  'src/app.css',
+  'node_modules/@minion-stack/ui/dist/Button.svelte',
+];
+const before = new Map(
+  await Promise.all(
+    authority.map(async (relative) => {
+      const physical = await fs.realpath(path.join(root, relative));
+      return [physical, digest(await fs.readFile(physical))];
+    }),
+  ),
+);
+const compiled = new Set();
+await build({
+  root,
+  configFile: false,
+  envDir: false,
+  cacheDir: path.join(outDir, '.cache'),
+  plugins: [
+    {
+      name: 'member-chat-owned-fixture',
+      resolveId(id) {
+        if (id === 'member-chat-entry') return entry;
+        if (id === '$app/stores') return pageStore;
+        if (id === '$lib/services/member-gateway.svelte') return gateway;
+      },
+      load(id) {
+        if (id === gateway) return gatewaySource;
+        if (id === pageStore)
+          return `import {writable} from 'svelte/store'; export const page=writable({data:{user:{id:'fixture-user',email:'fixture@example.invalid',displayName:'Fixture member'},servers:[{serverId:'fixture-server',serverName:'Fixture',serverUrl:'https://fixture.invalid',serverToken:'synthetic-only'}],agents:[{agentId:'fixture-agent',serverId:'fixture-server'}]}});`;
+        if (id === entry)
+          return `import {mount} from 'svelte'; import Fixture from ${JSON.stringify(path.join(here, 'Fixture.svelte'))}; import {setLanguageTag} from ${JSON.stringify(path.join(root, 'src/lib/paraglide/runtime.js'))}; import {controls} from '$lib/services/member-gateway.svelte'; import ${JSON.stringify(path.join(root, 'src/app.css'))}; setLanguageTag(new URL(location.href).searchParams.get('lang')==='es'?'es':'en'); window.memberChatFixture=controls; mount(Fixture,{target:document.getElementById('app')});`;
+      },
+      transform(_source, id) {
+        const clean = id.split('?')[0];
+        if (before.has(clean)) compiled.add(clean);
+      },
+      generateBundle() {
+        for (const name of before.keys())
+          if (!compiled.has(name)) throw Error('Actual authority module missing: ' + name);
+      },
+    },
+    svelte({ configFile: false, hot: false }),
+    tailwindcss(),
+  ],
+  resolve: {
+    conditions: ['browser', 'svelte'],
+    alias: [
+      {
+        find: /^\$lib\/(?!services\/member-gateway\.svelte)(.*)$/,
+        replacement: path.join(root, 'src/lib') + '/$1',
+      },
+    ],
+  },
+  build: {
+    outDir,
+    emptyOutDir: false,
+    minify: false,
+    rollupOptions: {
+      input: 'member-chat-entry',
+      output: {
+        entryFileNames: 'fixture.js',
+        chunkFileNames: 'chunks/[name]-[hash].js',
+        assetFileNames: (asset) =>
+          asset.name?.endsWith('.css') ? 'fixture.css' : '[name][extname]',
+      },
+    },
+  },
+});
+const css = await fs.readFile(path.join(root, 'src/app.css'), 'utf8');
+const fonts = [
+  ...new Set([...css.matchAll(/url\(['"]?(\/fonts\/[^)'"\s]+)/g)].map((match) => match[1])),
+];
+for (const font of fonts) {
+  const target = path.join(outDir, font);
+  await fs.mkdir(path.dirname(target), { recursive: true });
+  await fs.copyFile(path.join(root, 'static', font), target);
+}
+await fs.copyFile(path.join(root, 'static/mascot-nav.png'), path.join(outDir, 'mascot-nav.png'));
+const fontLicense = path.join(root, 'static/fonts/barlow-LICENSE.txt');
+await fs.copyFile(fontLicense, path.join(outDir, 'barlow-LICENSE.txt'));
+await fs.writeFile(
+  path.join(outDir, 'index.html'),
+  '<!doctype html><html lang="en" data-minion-theme="concourse"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Member chat fixture</title><link rel="icon" href="data:,"><link rel="stylesheet" href="/fixture.css"><div id="app"></div><script type="module" src="/fixture.js"></script></html>',
+);
+const files = [];
+async function inventory(directory) {
+  for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
+    if (entry.isSymbolicLink()) throw Error('Linked artifact');
+    const target = path.join(directory, entry.name);
+    if (entry.isDirectory()) await inventory(target);
+    else {
+      const bytes = await fs.readFile(target);
+      files.push({
+        path: path.relative(outDir, target),
+        bytes: bytes.length,
+        sha256: digest(bytes),
+      });
+    }
+  }
+}
+await inventory(outDir);
+const bytes = files.reduce((sum, file) => sum + file.bytes, 0);
+if (files.length > 550 || bytes > 50 * 1024 * 1024)
+  throw Error('Fixture artifact capacity exceeded');
+for (const [name, hash] of before)
+  if (digest(await fs.readFile(name)) !== hash) throw Error('Source changed during build');
+if (networkAttempts) throw Error('Build attempted network');
+const receipt = {
+  root,
+  outDir,
+  networkAttempts,
+  files: files.sort((a, b) => a.path.localeCompare(b.path)),
+  bytes,
+  staticFontsCopied: fonts,
+  fontLicense: { path: 'barlow-LICENSE.txt', sha256: digest(await fs.readFile(fontLicense)) },
+  emittedFonts: files
+    .filter((file) => /\.(woff2?|ttf|otf)$/.test(file.path))
+    .map((file) => file.path),
+  authority: [...before].map(([file, sha256]) => ({
+    path: path.relative(root, file),
+    sha256,
+    compiled: compiled.has(file),
+  })),
+  gatewaySourceHash: digest(gatewaySource),
+};
+await fs.writeFile(path.join(outDir, 'manifest.json'), JSON.stringify(receipt, null, 2) + '\n');
+console.log(JSON.stringify({ outDir, files: files.length, bytes, networkAttempts }));
