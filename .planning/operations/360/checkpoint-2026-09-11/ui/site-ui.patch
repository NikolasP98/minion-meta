+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { RequestEvent } from '@sveltejs/kit';
+import type { CookieOptions } from '@supabase/ssr';
+
+const provider = vi.hoisted(() => ({
+  env: { AUTH_PROVIDER: '' },
+  signOut: vi.fn(),
+  getAuth: vi.fn(),
+  createServerClient: vi.fn(),
+}));
+vi.mock('$env/dynamic/private', () => ({ env: provider.env }));
+vi.mock('$lib/auth/auth', () => ({ getAuth: provider.getAuth }));
+vi.mock('@supabase/ssr', () => ({ createServerClient: provider.createServerClient }));
+vi.mock('$env/static/public', () => ({
+  PUBLIC_SUPABASE_URL: 'https://supabase.fixture.invalid',
+  PUBLIC_SUPABASE_ANON_KEY: 'synthetic-public-key',
+}));
+
+describe('server logout selects the current request provider', () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+    provider.env.AUTH_PROVIDER = '';
+    provider.signOut.mockResolvedValue(Response.json({ success: true }));
+    provider.getAuth.mockReturnValue({ api: { signOut: provider.signOut } });
+  });
+
+  async function invoke(
+    options: {
+      origin?: string | null;
+      method?: string;
+      signOut?: () => Promise<{ error: null }>;
+    } = {},
+  ) {
+    const { POST } = await import('./+server');
+    const url = new URL('https://fixture.invalid/auth/logout');
+    const headers = new Headers({ cookie: 'fixture-session=synthetic' });
+    if (options.origin !== null) headers.set('origin', options.origin ?? url.origin);
+    const request = new Request(url, { method: options.method ?? 'POST', headers });
+    const locals = options.signOut ? { supabase: { auth: { signOut: options.signOut } } } : {};
+    return { response: await POST({ request, url, locals }), request };
+  }
+
+  it('preserves Better Auth response identity and all Set-Cookie headers', async () => {
+    const response = Response.json({ success: true });
+    response.headers.append('set-cookie', 'fixture-session=; Path=/; Max-Age=0; HttpOnly');
+    response.headers.append('set-cookie', 'fixture-secondary=; Path=/; Max-Age=0; HttpOnly');
+    provider.signOut.mockResolvedValue(response);
+    const result = await invoke();
+    expect(result.response).toBe(response);
+    expect(result.response.headers.getSetCookie()).toEqual(response.headers.getSetCookie());
+    expect(provider.signOut).toHaveBeenCalledWith({
+      headers: result.request.headers,
+      asResponse: true,
+    });
+  });
+
+  it('uses only the request Supabase client and explicitly local scope', async () => {
+    provider.env.AUTH_PROVIDER = 'supabase';
+    const signOut = vi.fn().mockResolvedValue({ error: null });
+    const { response } = await invoke({ signOut });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ success: true });
+    expect(signOut).toHaveBeenCalledWith({ scope: 'local' });
+    expect(provider.getAuth).not.toHaveBeenCalled();
+  });
+
+  it('does not fall back to Better Auth when request Supabase is missing', async () => {
+    provider.env.AUTH_PROVIDER = 'supabase';
+    const { response } = await invoke();
+    expect(response.status).toBe(503);
+    expect(provider.getAuth).not.toHaveBeenCalled();
+  });
+
+  it('retains current-request cookie deletions through the real Supabase server adapter', async () => {
+    provider.env.AUTH_PROVIDER = 'supabase';
+    const { supabaseServer } = await import('$lib/server/supabase');
+    const { POST } = await import('./+server');
+    const cookies = {
+      get: vi.fn(),
+      getAll: vi.fn(() => [{ name: 'synthetic-session', value: 'synthetic' }]),
+      set: vi.fn(),
+      delete: vi.fn(),
+      serialize: vi.fn(() => ''),
+    };
+    const url = new URL('https://fixture.invalid/auth/logout');
+    const event: RequestEvent = {
+      url,
+      request: new Request(url, { method: 'POST', headers: { origin: url.origin } }),
+      locals: {},
+      cookies,
+      params: {},
+      platform: undefined,
+      route: { id: null },
+      fetch: vi.fn(() => {
+        throw new Error('Unexpected provider fetch');
+      }),
+      getClientAddress: () => '127.0.0.1',
+      setHeaders: vi.fn(),
+      isDataRequest: false,
+      isSubRequest: false,
+      isRemoteRequest: false,
+      tracing: {
+        enabled: false,
+        get root(): never {
+          throw new Error('Unexpected tracing access');
+        },
+        get current(): never {
+          throw new Error('Unexpected tracing access');
+        },
+      },
+    };
+    const signOut = vi.fn();
+    provider.createServerClient.mockImplementation(
+      (
+        _url: string,
+        _key: string,
+        options: {
+          cookies: {
+            getAll: () => unknown;
+            setAll: (entries: { name: string; value: string; options: CookieOptions }[]) => void;
+          };
+        },
+      ) => {
+        signOut.mockImplementation(async () => {
+          expect(options.cookies.getAll()).toEqual([
+            { name: 'synthetic-session', value: 'synthetic' },
+          ]);
+          options.cookies.setAll([
+            {
+              name: 'synthetic-session',
+              value: '',
+              options: { maxAge: 0, httpOnly: true, sameSite: 'lax' },
+            },
+          ]);
+          return { error: null };
+        });
+        return { auth: { signOut } };
+      },
+    );
+    event.locals.supabase = supabaseServer(event);
+    const response = await POST(event);
+    expect(response.status).toBe(200);
+    expect(signOut).toHaveBeenCalledWith({ scope: 'local' });
+    expect(cookies.set).toHaveBeenCalledWith('synthetic-session', '', {
+      maxAge: 0,
+      httpOnly: true,
+      sameSite: 'lax',
+      path: '/',
+    });
+    expect(provider.getAuth).not.toHaveBeenCalled();
+  });
+
+  it.each([null, 'null', 'https://foreign.invalid', 'https://fixture.invalid.evil.invalid'])(
+    'rejects origin %s before selecting a provider',
+    async (origin) => {
+      const { response } = await invoke({ origin });
+      expect(response.status).toBe(403);
+      expect(provider.getAuth).not.toHaveBeenCalled();
+    },
+  );
+
+  it('rejects non-POST invocation before provider access', async () => {
+    const { response } = await invoke({ method: 'GET' });
+    expect(response.status).toBe(405);
+    expect(provider.getAuth).not.toHaveBeenCalled();
+  });
+
+  it('preserves a provider failure response instead of fabricating success', async () => {
+    const failed = Response.json({ success: false }, { status: 503 });
+    provider.signOut.mockResolvedValue(failed);
+    expect((await invoke()).response).toBe(failed);
+  });
+
+  it.each(['better-auth', 'supabase'])(
+    'projects thrown %s failures without private detail',
+    async (selection) => {
+      provider.env.AUTH_PROVIDER = selection;
+      const signOut = vi.fn().mockRejectedValue(new Error('private-provider-canary'));
+      provider.signOut.mockImplementation(signOut);
+      const { response } = await invoke({ signOut });
+      expect(response.status).toBe(502);
+      expect(await response.text()).not.toContain('private-provider-canary');
+    },
+  );
+
+  it('does not treat a returned Supabase error as success', async () => {
+    provider.env.AUTH_PROVIDER = 'supabase';
+    const signOut = vi.fn().mockResolvedValue({ error: { message: 'private-provider-canary' } });
+    const { response } = await invoke({ signOut });
+    expect(response.status).toBe(502);
+    expect(await response.json()).toEqual({ success: false });
+  });
+});
