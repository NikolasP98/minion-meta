+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mount, tick, unmount } from 'svelte';
+import { setLanguageTag } from '$lib/paraglide/runtime';
+import TabBar from './TabBar.svelte';
+
+let target: HTMLDivElement;
+let component: ReturnType<typeof mount> | undefined;
+const change = vi.fn();
+const buttons = () => [...target.querySelectorAll('button')];
+async function start(activeTab = 'overview') {
+  component = mount(TabBar, { target, props: { activeTab, onTabChange: change } });
+  await tick();
+}
+function key(button: HTMLButtonElement, key: string) {
+  button.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  setLanguageTag('en');
+  target = document.createElement('div');
+  document.body.append(target);
+});
+afterEach(async () => {
+  if (component) await unmount(component);
+  component = undefined;
+  target.remove();
+});
+
+describe('member tabs use manual keyboard activation', () => {
+  it('preserves click activation', async () => {
+    await start();
+    buttons()[1].click();
+    expect(change).toHaveBeenCalledWith('chat');
+  });
+  it('exposes one selected tab and its controlled panel', async () => {
+    await start('chat');
+    expect(target.querySelector('[role="tablist"]')).not.toBeNull();
+    expect(target.querySelectorAll('[role="tab"][aria-selected="true"]')).toHaveLength(1);
+    expect(buttons()[1].getAttribute('aria-controls')).toBe('member-panel-chat');
+    expect(buttons().map((button) => button.tabIndex)).toEqual([-1, 0, -1, -1]);
+  });
+  it('moves and wraps focus with arrows without activating expensive panels', async () => {
+    await start();
+    buttons()[0].focus();
+    key(buttons()[0], 'ArrowLeft');
+    await tick();
+    expect(document.activeElement).toBe(buttons()[3]);
+    key(buttons()[3], 'ArrowRight');
+    await tick();
+    expect(document.activeElement).toBe(buttons()[0]);
+    expect(change).not.toHaveBeenCalled();
+  });
+  it('supports Home and End focus movement without selection changes', async () => {
+    await start();
+    buttons()[1].focus();
+    key(buttons()[1], 'End');
+    await tick();
+    expect(document.activeElement).toBe(buttons()[3]);
+    key(buttons()[3], 'Home');
+    await tick();
+    expect(document.activeElement).toBe(buttons()[0]);
+    expect(change).not.toHaveBeenCalled();
+  });
+  it('renders localized tab labels', async () => {
+    setLanguageTag('es');
+    await start();
+    expect(buttons().map((button) => button.textContent?.trim())).toEqual([
+      'Resumen',
+      'Chat',
+      'Archivos',
+      'Grafo',
+    ]);
+  });
+});
