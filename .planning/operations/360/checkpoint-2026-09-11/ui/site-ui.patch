+// TODO(handoff): Wire this native fixture into Site CI; phase 13-03 and
+// proposals/2026-09-08-platform-qc-remediation.md track the unqualified CI runner.
+import { build } from 'vite';
+import { svelte } from '@sveltejs/vite-plugin-svelte';
+import tailwindcss from '@tailwindcss/vite';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { copyFile, mkdir, writeFile } from 'node:fs/promises';
+const fixture = dirname(fileURLToPath(import.meta.url));
+const root = resolve(fixture, '../../..');
+const outDir = resolve(process.argv[2] ?? resolve(root, '.member-data-parity'));
+const entry = '\0member-fixture-entry';
+const gateway = '\0member-fixture-gateway';
+const gatewaySource = `
+const pending=[];
+const defer=(kind,params)=>new Promise((resolve,reject)=>pending.push({kind,params,resolve,reject}));
+export const fetchKGSnapshot=()=>defer('graph');
+export const fetchFiles=()=>defer('files');
+export const sendReq=(method,params)=>defer('read',params);
+const nodes=[{id:'a',label:'<img src=x onerror=window.fixtureInjected=true>',type:'entity'},{id:'b',label:'Beta'}];
+const edges=[{fromId:'a',toId:'b',relType:'related_to',weight:0.5,createdAt:12}];
+window.addEventListener('member-fixture',({detail})=>{
+ const kind=(detail==='resolve-graph'||detail==='resolve-empty')?'graph':detail==='resolve-files'?'files':'read';
+ const path=detail==='resolve-a'?'A.txt':detail==='resolve-b'?'B.txt':null;
+ const index=pending.findIndex(p=>p.kind===kind&&(!path||p.params.path===path));
+ if(index<0)return;
+ const [item]=pending.splice(index,1);
+ item.resolve(kind==='graph'?(detail==='resolve-empty'?{nodes:[],edges:[]}:{nodes,edges}):kind==='files'?{files:[{path:'A.txt'},{path:'B.txt'}]}:path+' content');
+});
+window.memberFixture={pending:()=>pending.map(({kind,params})=>({kind,params})), chart:async()=>{const e=await import('echarts');return e.getInstanceByDom(document.querySelector('.graph-canvas'));}};
+`;
+await mkdir(outDir, { recursive: true });
+await build({
+  root,
+  configFile: false,
+  envDir: false,
+  cacheDir: resolve(outDir, '.cache'),
+  plugins: [
+    {
+      name: 'member-parity-fixture',
+      resolveId(id) {
+        if (id === 'member-fixture-entry') return entry;
+        if (id === '$lib/services/member-gateway.svelte') return gateway;
+      },
+      load(id) {
+        if (id === gateway) return gatewaySource;
+        if (id === entry)
+          return `import {mount} from 'svelte'; import Fixture from ${JSON.stringify(resolve(fixture, 'Fixture.svelte'))}; import {memberState} from ${JSON.stringify(resolve(root, 'src/lib/state/member.svelte.ts'))}; import ${JSON.stringify(resolve(root, 'src/app.css'))}; memberState.agentId='agent-a'; memberState.connected=true; mount(Fixture,{target:document.getElementById('app')});`;
+      },
+    },
+    svelte({ configFile: false, hot: false }),
+    tailwindcss(),
+  ],
+  resolve: {
+    conditions: ['browser', 'svelte'],
+    alias: [
+      {
+        find: /^\$lib\/(?!services\/member-gateway\.svelte)(.*)$/,
+        replacement: resolve(root, 'src/lib') + '/$1',
+      },
+    ],
+  },
+  build: {
+    outDir,
+    emptyOutDir: false,
+    minify: false,
+    rollupOptions: {
+      input: 'member-fixture-entry',
+      output: {
+        entryFileNames: 'fixture.js',
+        chunkFileNames: 'chunks/[name]-[hash].js',
+        manualChunks(id) {
+          if (id.includes('/node_modules/echarts/') || id.includes('/node_modules/zrender/'))
+            return 'echarts';
+        },
+        assetFileNames: (asset) =>
+          asset.name?.endsWith('.css') ? 'fixture.css' : '[name][extname]',
+      },
+    },
+  },
+});
+await writeFile(
+  resolve(outDir, 'index.html'),
+  '<!doctype html><html lang="en" data-minion-theme="concourse"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/fixture.css"><title>Member data fixture</title><div id="app"></div><script type="module" src="/fixture.js"></script></html>',
+);
+await copyFile(resolve(root, 'static/mascot-nav.png'), resolve(outDir, 'mascot-nav.png'));
+await mkdir(resolve(outDir, 'fonts'), { recursive: true });
+await copyFile(
+  resolve(root, 'static/fonts/barlow-LICENSE.txt'),
+  resolve(outDir, 'fonts/barlow-LICENSE.txt'),
+);
+console.log(JSON.stringify({ root, outDir, fixture }));
