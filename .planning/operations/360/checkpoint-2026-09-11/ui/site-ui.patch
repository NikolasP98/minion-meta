diff --git after/tests/e2e/member-chat-parity.spec.ts after/tests/e2e/member-chat-parity.spec.ts
new file mode 100644
index 0000000..4bb42f7
--- /dev/null
+++ after/tests/e2e/member-chat-parity.spec.ts
@@ -0,0 +1,339 @@
+import { test, expect, type Page, type TestInfo } from '@playwright/test';
+import { createServer, type Server } from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+
+declare global {
+  interface Window {
+    memberChatFixture: {
+      calls(): { method: string; text?: string; url?: string }[];
+      input(text: string): void;
+      stream(text: string, loading?: boolean): void;
+      history(text: string): void;
+      error(text: string): void;
+      connected(value: boolean): void;
+      finish(): void;
+    };
+    memberChatScrolls: { behavior?: ScrollBehavior; connected: boolean }[];
+  }
+}
+
+type Artifact = { path: string; bytes: number; sha256: string };
+let server: Server;
+let origin: string;
+let manifestSha: string;
+const output = process.env.MEMBER_CHAT_FIXTURE_DIR;
+const digest = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex');
+const resources = new Map<string, { bytes: Buffer; mime: string }>();
+const unexpected: string[] = [];
+test.beforeAll(async () => {
+  if (!output) throw Error('Explicit MEMBER_CHAT_FIXTURE_DIR required');
+  const base = await fs.realpath(output);
+  const manifestBytes = await fs.readFile(path.join(base, 'manifest.json'));
+  manifestSha = digest(manifestBytes);
+  const manifest: { files: Artifact[] } = JSON.parse(manifestBytes.toString('utf8'));
+  for (const file of manifest.files) {
+    const absolute = await fs.realpath(path.resolve(base, file.path));
+    if (!absolute.startsWith(base + path.sep)) throw Error('Artifact escaped');
+    const bytes = await fs.readFile(absolute);
+    if (bytes.length !== file.bytes || digest(bytes) !== file.sha256)
+      throw Error('Artifact hash mismatch');
+    const mime = (
+      {
+        '.html': 'text/html',
+        '.js': 'text/javascript',
+        '.css': 'text/css',
+        '.png': 'image/png',
+        '.txt': 'text/plain',
+        '.woff2': 'font/woff2',
+        '.woff': 'font/woff',
+      } as Record<string, string>
+    )[path.extname(file.path)];
+    if (!mime) continue;
+    resources.set('/' + file.path, { bytes, mime });
+  }
+  server = createServer((request, response) => {
+    const requested = new URL(request.url ?? '/', 'http://fixture').pathname;
+    const item = resources.get(requested === '/' ? '/index.html' : requested);
+    if (!['GET', 'HEAD'].includes(request.method ?? '') || !item) {
+      unexpected.push(`${request.method} ${requested}`);
+      response.writeHead(404).end();
+      return;
+    }
+    response.setHeader('Content-Type', item.mime);
+    response.setHeader(
+      'Content-Security-Policy',
+      "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; base-uri 'none'; frame-src 'none'",
+    );
+    response.end(request.method === 'HEAD' ? undefined : item.bytes);
+  });
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address();
+  if (!address || typeof address === 'string') throw Error('Missing loopback address');
+  origin = `http://127.0.0.1:${address.port}`;
+});
+test.afterAll(async () => {
+  if (server)
+    await new Promise<void>((resolve, reject) =>
+      server.close((error) => (error ? reject(error) : resolve())),
+    );
+});
+
+async function begin(
+  page: Page,
+  viewport: { width: number; height: number },
+  theme = 'concourse',
+  language = 'en',
+) {
+  const errors: string[] = [];
+  const blocked: string[] = [];
+  page.on('pageerror', (error) => errors.push(error.message));
+  await page.routeWebSocket('**/*', (socket) => {
+    blocked.push(socket.url());
+    socket.close();
+  });
+  await page.route('**/*', (route) =>
+    new URL(route.request().url()).origin === origin
+      ? route.continue()
+      : (blocked.push(route.request().url()), route.abort()),
+  );
+  await page.addInitScript(() => {
+    window.memberChatScrolls = [];
+    const original = Element.prototype.scrollIntoView;
+    Element.prototype.scrollIntoView = function (options) {
+      window.memberChatScrolls.push({
+        behavior: typeof options === 'object' ? options.behavior : undefined,
+        connected: this.isConnected,
+      });
+      return original.call(this, options);
+    };
+  });
+  await page.setViewportSize(viewport);
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  await page.goto(origin + '/?lang=' + language);
+  await page.evaluate(
+    (theme) => document.documentElement.setAttribute('data-minion-theme', theme),
+    theme,
+  );
+  await page.evaluate(() => document.fonts.ready);
+  const fonts = await page.evaluate(async () => {
+    const selected: [string, number][] = [
+      ...[400, 500, 600, 700].map((weight) => ['Barlow Condensed', weight] as [string, number]),
+      ...[400, 500, 600].map((weight) => ['Barlow Semi Condensed', weight] as [string, number]),
+    ];
+    return Promise.all(
+      selected.map(async ([family, weight]) => {
+        const faces = await document.fonts.load(`${weight} 14px "${family}"`, 'Mensaje');
+        return {
+          family,
+          weight,
+          loaded: faces.length > 0 && faces.every((face) => face.status === 'loaded'),
+        };
+      }),
+    );
+  });
+  if (process.env.MEMBER_CHAT_BASELINE_FONT !== 'fallback')
+    expect(fonts.every((font) => font.loaded)).toBe(true);
+  return { errors, blocked, fonts };
+}
+async function receipt(
+  page: Page,
+  info: TestInfo,
+  observations: { errors: string[]; blocked: string[] },
+) {
+  expect(observations.errors).toEqual([]);
+  expect(observations.blocked).toEqual([]);
+  expect(unexpected).toEqual([]);
+  const browser = page.context().browser()?.version();
+  expect(browser).toBeTruthy();
+  await info.attach('runtime.json', {
+    body: Buffer.from(
+      JSON.stringify({
+        browser,
+        project: info.project.name,
+        manifestSha,
+        viewport: page.viewportSize(),
+        theme: await page.locator('html').getAttribute('data-minion-theme'),
+        ...observations,
+        calls: await page.evaluate(() => window.memberChatFixture.calls()),
+        scrolls: await page.evaluate(() => window.memberChatScrolls),
+      }),
+    ),
+    contentType: 'application/json',
+  });
+  await info.attach('screenshot', { body: await page.screenshot(), contentType: 'image/png' });
+}
+
+for (const viewport of [
+  { width: 320, height: 780 },
+  { width: 390, height: 844 },
+  { width: 600, height: 360 },
+  { width: 1280, height: 900 },
+]) {
+  for (const theme of ['concourse', 'concourse-day']) {
+    test(`actual members viewport ${viewport.width} ${theme}`, async ({ page }, info) => {
+      const observed = await begin(page, viewport, theme);
+      await page.getByRole('tab', { name: 'Chat', exact: true }).click();
+      const composer = page.getByRole('textbox', { name: 'Message your agent' });
+      await expect(composer).toBeVisible();
+      await page.evaluate(() => window.memberChatFixture.history('LongUnbrokenText'.repeat(300)));
+      await expect(page.getByRole('tabpanel')).toContainText('LongUnbrokenText');
+      const bounds = await composer.boundingBox();
+      expect(bounds).not.toBeNull();
+      expect(bounds!.y + bounds!.height).toBeLessThanOrEqual(viewport.height);
+      expect(bounds!.height).toBeGreaterThanOrEqual(44);
