	                        'data', null::jsonb,
	                        'errors', array['pg_graphql extension is not enabled.']
	                    );
	                ELSE
	                    RETURN jsonb_build_object(
	                        'data', null::jsonb,
	                        'errors', array['pg_graphql is only available on projects running Postgres 14 onwards.']
	                    );
	                END IF;
	            END;
	        $$;
