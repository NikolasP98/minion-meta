	    CONSTRAINT job_effect_units_placement CHECK (((((batch_id IS NULL) AND (vector_index IS NULL)) OR ((batch_id IS NOT NULL) AND ((vector_index >= 0) AND (vector_index <= 63)))) IS TRUE))
	);
