172.17.0.1 2026-10-03 20:47:40.852 UTC [96] supabase_admin@postgres LOG:  statement: CREATE VIEW public.crm_contact_timeline WITH (security_invoker='on') AS
	 SELECT ci.contact_id,
	    m.org_id,
	    'message'::text AS kind,
	    m.direction,
	    m.channel,
	    m.content AS body,
	    m.agent_id,
	    m.metadata AS data,
	    COALESCE(m.occurred_at, m.created_at) AS occurred_at,
	    m.id AS source_id,
	    m.client_id
	   FROM (public.messages m
	     JOIN public.crm_contact_identities ci ON (((ci.org_id = m.org_id) AND (ci.channel = m.channel) AND (ci.external_id = m.chat_id))))
	UNION ALL
	 SELECT a.contact_id,
	    a.org_id,
	    a.kind,
	    NULL::text AS direction,
	    NULL::text AS channel,
	    a.body,
	    NULL::text AS agent_id,
	    a.data,
	    a.occurred_at,
	    a.id AS source_id,
	    NULL::text AS client_id
	   FROM public.crm_activities a;
