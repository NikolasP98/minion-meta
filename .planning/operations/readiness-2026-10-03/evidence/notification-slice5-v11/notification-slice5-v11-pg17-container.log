	-- No tenant/browser role can claim, clear, or forge a worker lease.
	BEGIN;
	CREATE TABLE public.marketplace_sync_state (
	  id text PRIMARY KEY DEFAULT 'catalog',
	  lease_token uuid,
	  last_published_token uuid,
