172.17.0.1 2026-10-03 20:47:40.846 UTC [96] supabase_admin@postgres LOG:  statement: CREATE TABLE public.messages (
	    id uuid DEFAULT gen_random_uuid() NOT NULL,
	    client_id text NOT NULL,
	    org_id text NOT NULL,
	    gateway_id text,
	    direction text NOT NULL,
	    channel text NOT NULL,
	    account_id text,
	    chat_id text,
	    is_group boolean,
