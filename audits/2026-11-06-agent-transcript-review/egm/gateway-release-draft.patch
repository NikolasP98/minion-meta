+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const workspace = vi.hoisted(() => ({ complete: false }));
+vi.mock("../agents/identity/workspace.js", () => ({
