index 00000000000..340212abf96
--- /dev/null
+++ b/src/agents/pi-embedded-runner/run/memory-turn.ts
@@ -0,0 +1,61 @@
+import { maybeExtractMemories } from "../../../memory/extract-memories-runner.js";
+import { stripInjectedUserContext } from "./strip-injected-context.js";
+
+type RunnerOptions = Parameters<typeof maybeExtractMemories>[0];
+type TurnOptions = Pick<
+  RunnerOptions,
+  "sessionId" | "abortSignal" | "llmCall" | "onMemoryExtracted"
+> & {
+  runId: string;
+  prompt: string;
+  assistantText?: string;
+  toolMetas: ReadonlyArray<{ toolName?: string }>;
+  existingMemory: string;
+  aborted?: boolean;
+  promptError?: unknown;
+  onKgExtraction?: (prompt: string, assistant: string) => Promise<unknown>;
+  onKgError: (error: unknown) => void;
+};
+
+/** Keep the already-authorized recall policy shared by prompt and extraction context. */
+export function formatRecalledMemoryContext(
+  hits: ReadonlyArray<{ score: number; content: string }>,
+) {
+  const lines = hits.filter((hit) => hit.score >= 0.2).map((hit) => `- ${hit.content}`);
+  return { lines, existingMemory: lines.join("\n").slice(0, 16_000) };
+}
+
+/** One executable post-turn boundary; KG stays independent of the durable tool gate. */
+export function extractTurnMemories(options: TurnOptions): void {
+  if (options.aborted || options.promptError || !options.assistantText) {
+    return;
+  }
+  const prompt = stripInjectedUserContext(options.prompt);
+  if (options.onKgExtraction) {
+    void options.onKgExtraction(prompt, options.assistantText).catch(options.onKgError);
+  }
+  // Metadata has no success receipt, so known writes are suppressed conservatively.
+  // TODO(handoff): cover authenticated filesystem/plugin memory-write outcomes; see
+  // proposals/2026-11-06-agent-transcript-evals-and-runtime-improvements.md.
+  const userWroteMemoryThisTurn = options.toolMetas.some(
+    ({ toolName }) =>
+      typeof toolName === "string" &&
+      ["remember", "brain_remember", "forget", "update_entity"].includes(toolName),
+  );
+  const recentMessages = [
+    { role: "user", content: prompt },
+    { role: "assistant", content: options.assistantText },
+  ];
+  maybeExtractMemories({
+    sessionId: options.sessionId,
+    windowId: options.runId,
+    abortSignal: options.abortSignal,
+    lastTurnHadToolCalls: options.toolMetas.length > 0,
+    newMessageCount: recentMessages.length,
+    userWroteMemoryThisTurn,
+    existingMemory: options.existingMemory,
+    recentMessages,
+    llmCall: options.llmCall,
+    onMemoryExtracted: options.onMemoryExtracted,
+  });
+}
