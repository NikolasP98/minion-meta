+/** Run last, after all optional/plugin transforms, so persistence cannot opt out. */
+function redactToolResultForPersistence(message: AgentMessage): AgentMessage {
+  const result = message as AgentMessage & { content?: unknown; details?: unknown };
+  const content = Array.isArray(result.content)
+    ? result.content.map((block: unknown) => {
+        if (!block || typeof block !== "object" || (block as { type?: unknown }).type !== "text") {
+          return block; // Preserve image bytes and non-text protocol blocks.
+        }
+        const textBlock = block as { text?: unknown };
+        return typeof textBlock.text === "string"
+          ? { ...block, text: redactExplicitSecretText(textBlock.text).text }
+          : block;
+      })
+    : typeof result.content === "string"
+      ? redactExplicitSecretText(result.content).text
+      : result.content;
+  return {
+    ...message,
+    content,
+    ...(Object.hasOwn(result, "details")
+      ? { details: redactExplicitSecretDetails(result.details) }
+      : {}),
+  } as AgentMessage;
+}
