+          ? { ...block, text: redactExplicitSecretText(textBlock.text).text }
+          : block;
+      })
+    : typeof result.content === "string"
+      ? redactExplicitSecretText(result.content).text
+      : result.content;
+  return {
+    ...message,
+    content,
+    ...(Object.hasOwn(result, "details")
