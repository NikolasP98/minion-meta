+/** Mandatory, configuration-independent redaction for explicit credential evidence. */
+export const SECRET_REDACTION = "[REDACTED]";
+
+// Preserve the existing egress vocabulary; deliberately avoid entropy/long-ID heuristics.
+const SECRET_SHAPES: RegExp[] = [
+  /\b\d{5,}:[A-Za-z0-9_-]{20,}\b/g,
+  /1\/\/0[A-Za-z0-9_/-]{20,}/g,
+  /\bsk-or-[A-Za-z0-9-]{20,}\b/g,
+  /\bsk-ant-[A-Za-z0-9_-]{20,}\b/g,
+  /\bsk-[A-Za-z0-9]{20,}\b/g,
+  /\bgh[posru]_[A-Za-z0-9]{20,}\b/g,
+  /\bgithub_pat_[A-Za-z0-9_]{20,}\b/g,
+  /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/g,
+  /\bAKIA[0-9A-Z]{16}\b/g,
+  /\bAIza[0-9A-Za-z_-]{30,}\b/g,
+  /\bBearer\s+[A-Za-z0-9._\-+=]{18,}\b/gi,
+  /-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]+?-----END [A-Z ]*PRIVATE KEY-----/g,
+];
+
+function isSecretKey(key: string): boolean {
+  const normalized = key
+    .replace(/([a-z0-9])([A-Z])/g, "$1_$2")
+    .replace(/[-.]/g, "_")
+    .toUpperCase();
+  return /(?:^|_)(?:TOKEN|PAT|API_KEY|SECRETS?_KEY|PASSWORD|PASSWD|SECRET|ACCESS_KEY)$/.test(
+    normalized,
+  );
+}
+
+// Match scalar assignments only. In particular, a schema's TOKEN: {type: ...}
+// and required: ["TOKEN"] are not credential values.
+const ASSIGNMENT_RE =
+  /((?:["']?)((?:[A-Za-z_][\w.-]*?)?(?:TOKEN|PAT|API[_-]?KEY|SECRETS?[_-]?KEY|PASSWORD|PASSWD|SECRET|ACCESS[_-]?KEY))(?:["']?)\s*[:=]\s*)("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|[^\s"'`<>{},;&\])]+)/gi;
+const CREDENTIAL_URL_RE = /\b([a-z][a-z0-9+.-]*:\/\/)([^\s/@]+:[^\s/@]+)@/gi;
+
+export function redactExplicitSecretText(input: string): { text: string; redactions: number } {
+  let redactions = 0;
+  let text = input.replace(CREDENTIAL_URL_RE, (_whole, scheme: string) => {
+    redactions += 1;
+    return `${scheme}${SECRET_REDACTION}@`;
+  });
+  text = text.replace(ASSIGNMENT_RE, (whole, prefix: string, key: string, value: string) => {
+    if (
+      !isSecretKey(key) ||
+      value === SECRET_REDACTION ||
+      value === `"${SECRET_REDACTION}"` ||
+      value === `'${SECRET_REDACTION}'`
+    ) {
+      return whole;
+    }
+    redactions += 1;
+    const quote = value[0] === '"' || value[0] === "'" ? value[0] : "";
+    return `${prefix}${quote}${SECRET_REDACTION}${quote}`;
+  });
+  for (const pattern of SECRET_SHAPES) {
+    text = text.replace(pattern, () => {
+      redactions += 1;
+      return SECRET_REDACTION;
+    });
+  }
+  return { text, redactions };
+}
+
+/** Redact text values and explicit credential fields, retaining structured schemas. */
+export function redactExplicitSecretDetails(value: unknown): unknown {
+  if (typeof value === "string") {
+    return redactExplicitSecretText(value).text;
+  }
+  if (Array.isArray(value)) {
+    return value.map(redactExplicitSecretDetails);
+  }
+  if (!value || typeof value !== "object" || Object.getPrototypeOf(value) !== Object.prototype) {
+    return value;
+  }
+  return Object.fromEntries(
+    Object.entries(value).map(([key, child]) => [
+      key,
+      isSecretKey(key) && typeof child === "string"
+        ? SECRET_REDACTION
+        : redactExplicitSecretDetails(child),
+    ]),
+  );
+}
