new file mode 100644
index 00000000..7f8ec110
--- /dev/null
+++ b/src/lib/assistant/page-context.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest';
+import {
+  getPageContext,
+  getPageContextRevision,
+  onPageContextChange,
+  setPageContext,
+  setPageContextLocation,
+} from './page-context';
+import { registerTool } from './model-context';
+describe('page context registration ownership', () => {
+  it('old equal-text disposal cannot clear the new owner', () => {
+    const old = setPageContext('same');
+    const current = setPageContext('same');
+    const revision = getPageContextRevision();
+    old();
+    expect(getPageContext()).toBe('same');
+    expect(getPageContextRevision()).toBe(revision);
+    current();
+    expect(getPageContext()).toBe('');
+    expect(getPageContextRevision()).toBeGreaterThan(revision);
+  });
+  it('notifies monotonically on route/focus A → B → A and tool changes', () => {
+    const seen: number[] = [];
+    const off = onPageContextChange(() => seen.push(getPageContextRevision()));
+    setPageContextLocation('/a');
+    setPageContextLocation('/b');
+    setPageContextLocation('/a');
+    const dispose = registerTool({
+      name: 'context-test',
+      description: '',
+      inputSchema: {},
+      execute() {},
+    });
+    dispose();
+    off();
+    expect(seen).toHaveLength(5);
+    expect(new Set(seen).size).toBe(5);
+  });
+});
diff --git a/src/lib/assistant/page-context.ts b/src/lib/assistant/page-context.ts
index cb3483c3..86f027db 100644
--- a/src/lib/assistant/page-context.ts
+++ b/src/lib/assistant/page-context.ts
@@ -1,21 +1,45 @@
-/**
- * Page-provided context for the floating assistant (spec 013 D3).
- *
- * Tools are page-scoped already (`model-context.ts`); this is the text
- * counterpart: a page describes what is on screen in model-only prose and
- * `buildAssistantContext` appends it to the envelope at send time. One slot:
- * the page that is mounted owns it, and its disposer clears it on unmount.
- */
+import { onToolChange } from './model-context';
+
 let text = '';
+let owner: symbol | null = null;
+let revision = 0;
+let location = '';
+const listeners = new Set<() => void>();
+function changed() {
+  revision++;
+  for (const listener of listeners) listener();
+}
+// Tools are part of the page envelope even when its prose remains equal.
+onToolChange(changed);
 
-/** Set the page's context text; returns a disposer that clears it (only if still ours). */
+/** Each registration owns an opaque token, including registrations with equal prose. */
 export function setPageContext(value: string): () => void {
+  const token = Symbol('page-context');
+  owner = token;
   text = value;
+  changed();
   return () => {
-    if (text === value) text = '';
+    if (owner !== token) return;
+    owner = null;
+    text = '';
+    changed();
   };
 }
-
+/** Pass route plus focus/query state from the mounted surface. */
+export function setPageContextLocation(value: string): void {
+  if (value === location) return;
+  location = value;
+  changed();
+}
 export function getPageContext(): string {
   return text;
 }
+export function getPageContextRevision(): number {
+  return revision;
+}
+export function onPageContextChange(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
diff --git a/src/lib/assistant/pending-submission.integration.test.ts b/src/lib/assistant/pending-submission.integration.test.ts
