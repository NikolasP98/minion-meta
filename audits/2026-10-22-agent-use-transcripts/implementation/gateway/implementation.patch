+import type { Message } from "@grammyjs/types";
+import type { TransportSourceProvenance } from "../../../plugins/types/hooks.js";
+
+/** Called only with original Telegram messages from the authenticated bot intake. */
+export function buildTelegramSourceProvenance(
+  messages: readonly Message[],
+  accountId: string,
+): TransportSourceProvenance {
+  return {
+    version: 1,
+    sources: messages.map((message) => ({
+      channel: "telegram",
+      accountId,
+      conversationId: String(message.chat.id),
+      messageId: String(message.message_id),
+      ...(typeof message.edit_date === "number"
+        ? { providerRevision: String(message.edit_date) }
+        : {}),
+      senderId:
+        message.from?.id != null
+          ? String(message.from.id)
+          : message.sender_chat?.id != null
+            ? String(message.sender_chat.id)
+            : undefined,
+      timestamp: typeof message.date === "number" ? message.date * 1000 : undefined,
+      text: message.text ?? message.caption ?? "",
+    })),
+  };
+}
