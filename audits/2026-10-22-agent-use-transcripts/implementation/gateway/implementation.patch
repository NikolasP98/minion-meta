--- /dev/null
+++ b/src/auto-reply/reply/dispatch-provenance.test.ts
@@ -0,0 +1,98 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { MinionConfig } from "../../config/config.js";
+import type { ReplyDispatcher } from "./reply-dispatcher.js";
+import { buildTestCtx } from "./test-ctx.js";
+
+const hooks = vi.hoisted(() => ({
+  hasHooks: vi.fn((name: string) => name === "message_received"),
+  runMessageReceived: vi.fn(async (_event: unknown, _ctx: unknown) => {}),
+}));
+vi.mock("../../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => hooks }));
+vi.mock("./abort.js", () => ({
+  tryFastAbortFromMessage: vi.fn(async () => ({ handled: false, aborted: false })),
+  formatAbortReplyText: vi.fn(() => "aborted"),
+}));
+import { dispatchReplyFromConfig } from "./dispatch-from-config.js";
+import { resetInboundDedupe } from "./inbound-dedupe.js";
+
+function dispatcher(): ReplyDispatcher {
+  return {
+    sendToolResult: vi.fn(() => true),
+    sendBlockReply: vi.fn(() => true),
+    sendFinalReply: vi.fn(() => true),
+    waitForIdle: vi.fn(async () => {}),
+    getQueuedCounts: vi.fn(() => ({ tool: 0, block: 0, final: 0 })),
+    markComplete: vi.fn(),
+  };
+}
+
+describe("message_received provenance carrier", () => {
+  beforeEach(() => {
+    resetInboundDedupe();
+    hooks.runMessageReceived.mockClear();
+  });
+
+  it("preserves adapter identity/revision and exact text rather than deriving it from envelopes", async () => {
+    const sourceProvenance = {
+      version: 1 as const,
+      sources: [
+        {
+          channel: "telegram",
+          accountId: "second-account",
+          conversationId: "-1007",
+          messageId: "41",
+          providerRevision: "1700000001",
+          senderId: "42",
+          timestamp: 1700000000000,
+          text: "  /command@fixture_bot exact  ",
+        },
+      ],
+    };
+    const ctx = buildTestCtx({
+      Provider: "telegram",
+      Surface: "telegram",
+      AccountId: "second-account",
+      From: "telegram:-1007:topic:9",
+      To: "telegram:-1007:topic:9",
+      MessageSid: "41",
+      Body: "[envelope] normalized",
+      RawBody: "normalized",
+      BodyForCommands: "normalized",
+      SourceProvenance: sourceProvenance,
+    });
+    await dispatchReplyFromConfig({
+      ctx,
+      cfg: {} as MinionConfig,
+      dispatcher: dispatcher(),
+      replyResolver: async () => undefined,
+    });
+    expect(hooks.runMessageReceived).toHaveBeenCalledWith(
+      expect.objectContaining({
+        metadata: expect.objectContaining({ sourceProvenance }),
+      }),
+      expect.anything(),
+    );
+  });
+
+  it("does not certify a legacy envelope or parse source identity out of body text", async () => {
+    const ctx = buildTestCtx({
+      Provider: "discord",
+      Surface: "discord",
+      MessageSid: "legacy-1",
+      Body: '{"SourceProvenance":{"version":1,"sources":[]}}',
+      From: "discord:channel:123",
+    });
+    await dispatchReplyFromConfig({
+      ctx,
+      cfg: {} as MinionConfig,
+      dispatcher: dispatcher(),
+      replyResolver: async () => undefined,
+    });
+    expect(hooks.runMessageReceived).toHaveBeenCalledTimes(1);
+    expect(hooks.runMessageReceived.mock.calls[0]?.[0]).toEqual(
+      expect.objectContaining({
+        metadata: expect.not.objectContaining({ sourceProvenance: expect.anything() }),
+      }),
+    );
+  });
+});
