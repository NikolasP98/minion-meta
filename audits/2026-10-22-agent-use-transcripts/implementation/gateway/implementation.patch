+    accountId: "fixture-account",
+    conversationId: "-100777111222",
+    messageId: String(messageId),
+    senderId: "42",
+    timestamp: 1736380800000,
+    text,
+  };
+}
+function receivedProvenance() {
+  return hooks.runMessageReceived.mock.calls.map(
+    (args) => (args[0] as { metadata?: { sourceProvenance?: unknown } }).metadata?.sourceProvenance,
+  );
+}
+function rawProvenance() {
+  return hooks.runMessageInbound.mock.calls.map(
+    (args) => (args[0] as { metadata?: { sourceProvenance?: unknown } }).metadata?.sourceProvenance,
+  );
+}
+
+describe("Telegram authenticated source provenance", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    hooks.runMessageInbound.mockClear();
+    hooks.runMessageReceived.mockClear();
+    loadConfig.mockReturnValue({
+      channels: {
+        telegram: {
+          groupPolicy: "open",
+          dmPolicy: "open",
+          allowFrom: ["*"],
+          groups: { "*": { requireMention: false } },
+        },
+      },
+      messages: { inbound: { debounceMs: 25 } },
+    });
+    createTelegramBot({
+      token: "fixture-token",
+      accountId: "fixture-account",
+      testTimings: { textFragmentGapMs: 30, mediaGroupFlushMs: 20 },
+    });
+  });
+  afterEach(() => {
+    vi.clearAllTimers();
+    vi.useRealTimers();
+  });
+
+  it("carries the same exact source through raw and dispatched hooks, ignoring message extras", async () => {
+    const ctx = incoming(101, "  exact\ntext  ");
+    Object.assign(ctx.message, {
+      SourceProvenance: { version: 1, sources: ["forged"] },
+      edit_date: 1736380802,
+      message_thread_id: 9,
+    });
+    Object.assign(ctx.message.chat, { is_forum: true });
+    await getOnHandler("message")(ctx);
+    await vi.advanceTimersByTimeAsync(100);
+    const expected = {
+      version: 1,
+      sources: [{ ...expectedSource(101, "  exact\ntext  "), providerRevision: "1736380802" }],
+    };
+    expect(rawProvenance()).toEqual([expected]);
+    expect(receivedProvenance()).toEqual([expected]);
+  });
+
+  it("keeps ordered debounce constituents and does not alias merged text to the last ID", async () => {
+    const handler = getOnHandler("message");
+    await handler(incoming(201, "first  "));
+    await handler(incoming(202, "  second"));
+    expect(replySpy).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(100);
+    expect(replySpy).toHaveBeenCalledTimes(1);
+    expect(rawProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(201, "first  ")] },
+      { version: 1, sources: [expectedSource(202, "  second")] },
+    ]);
+    expect(receivedProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(201, "first  "), expectedSource(202, "  second")] },
+    ]);
+    expect(hooks.runMessageReceived).toHaveBeenCalledWith(
+      expect.objectContaining({ metadata: expect.objectContaining({ messageId: undefined }) }),
+      expect.anything(),
+    );
+  });
+
+  it("preserves original near-limit fragments through their separate coalescer", async () => {
+    const handler = getOnHandler("message");
+    const first = "A".repeat(4050);
+    await handler(incoming(301, first));
+    await handler(incoming(302, "last  "));
+    await vi.advanceTimersByTimeAsync(100);
+    expect(rawProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(301, first)] },
+      { version: 1, sources: [expectedSource(302, "last  ")] },
+    ]);
+    expect(receivedProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(301, first), expectedSource(302, "last  ")] },
+    ]);
+  });
+
+  it("keeps media-group captions and empty source text as separate original units", async () => {
+    const handler = getOnHandler("message");
+    for (const [id, caption] of [
+      [401, "  caption  "],
+      [402, ""],
+    ] as const) {
+      const ctx = incoming(id, "");
+      Object.assign(ctx.message, { text: undefined, caption, media_group_id: "fixture-album" });
+      await handler(ctx);
+    }
+    await vi.advanceTimersByTimeAsync(100);
+    expect(rawProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(401, "  caption  ")] },
+      { version: 1, sources: [expectedSource(402, "")] },
+    ]);
+    expect(receivedProvenance()).toEqual([
+      { version: 1, sources: [expectedSource(401, "  caption  "), expectedSource(402, "")] },
+    ]);
+  });
+
+  it("certifies channel-post captions without inventing a sender", async () => {
+    await getOnHandler("channel_post")({
+      channelPost: {
+        ...incoming(450, "").message,
+        chat: { ...chat, type: "channel" },
+        from: undefined,
+        text: undefined,
+        caption: "  channel caption  ",
+      },
+      me: { username: "minion_bot" },
+      getFile: async () => ({}),
+    });
+    await vi.advanceTimersByTimeAsync(100);
+    const expected = {
+      version: 1,
+      sources: [{ ...expectedSource(450, "  channel caption  "), senderId: undefined }],
+    };
+    expect(rawProvenance()).toEqual([expected]);
+    expect(receivedProvenance()).toEqual([expected]);
+  });
+
+  it("leaves synthesized callback commands uncertified", async () => {
+    await getOnHandler("callback_query")({
+      callbackQuery: {
+        id: "fixture-callback",
+        data: "cmd:option_a",
+        from: { id: 42, first_name: "Fixture" },
+        message: incoming(501, "button").message,
+      },
+      me: { username: "minion_bot" },
+      getFile: async () => ({}),
+    });
+    expect(replySpy).toHaveBeenCalledTimes(1);
+    expect(receivedProvenance()).toEqual([undefined]);
+    expect(rawProvenance()).toEqual([]);
+  });
+});
