+        (s) => map.get(s.id).failure && map.get(s.id).severity === severity,
+      ).length;
+      const upper = !controls.length
+        ? 1
+        : failures === 0
+          ? zeroMissRateUpper
+          : Math.min(
+              1,
+              failures / controls.length + Math.sqrt(Math.log(20) / (2 * controls.length)),
