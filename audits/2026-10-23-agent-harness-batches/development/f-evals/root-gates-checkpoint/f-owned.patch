@@ -0,0 +1,82 @@
+// Explicit OFFLINE software-fixture preparation only. It cannot make a live manifest/approval.
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import {
+  assert,
+  args,
+  readJSON,
+  writePrivate,
+  digest,
+  safePath,
+  canonical,
+  direct,
+  main,
+} from './lib/common.mjs';
+import { HubAdapter } from './lib/hub-adapter.mjs';
+import { validateManifest, sourceDigest } from './lib/manifest.mjs';
+export async function prepare({ hubRoot, template, output, keepAlive = false }) {
+  safePath(hubRoot, { directory: true });
+  const m = readJSON(template);
+  assert(
+    m.mode === 'fixture' && m.purpose === 'software_fixture' && !m.accounting && !m.approvalRef,
+    'preparer is software fixture only',
+  );
+  const metaRoot = path.resolve(import.meta.dirname, '../..');
+  m.provenance.meta = {
+    sourceSha256: sourceDigest(metaRoot),
+    commit: execFileSync('git', ['rev-parse', 'HEAD'], { cwd: metaRoot, encoding: 'utf8' }).trim(),
+    lockSha256: digest(fs.readFileSync(path.join(metaRoot, 'pnpm-lock.yaml'))),
+  };
+  m.provenance.hub = {
+    commit: execFileSync('git', ['rev-parse', 'HEAD'], { cwd: hubRoot, encoding: 'utf8' }).trim(),
+    lockSha256: digest(fs.readFileSync(path.join(hubRoot, 'bun.lock'))),
+    adapterSha256: digest(
+      fs.readFileSync(path.join(hubRoot, 'tests/fixtures/critical-journeys/eval-adapter.mjs')),
+    ),
+    buildSha256: '0'.repeat(64),
+    sourceSha256: '0'.repeat(64),
+  };
+  const adapter = new HubAdapter({
+    root: hubRoot,
+    pin: m.provenance.hub,
+    bounds: m.bounds,
+    onProvider: () => {
+      throw Error('provider forbidden during offline preparation');
+    },
+  });
+  let identity;
+  try {
+    identity = await adapter.send('hello', {
+      protocol: 'minion-agent-eval-fixture/v1',
+      lockHash: m.provenance.hub.lockSha256,
+      adapterHash: m.provenance.hub.adapterSha256,
+    });
+    assert(
+      identity.sourceSha === m.provenance.hub.commit && identity.disposable === true,
+      'adapter identity mismatch',
+    );
+    m.provenance.hub.buildSha256 = identity.buildHash;
+    m.provenance.hub.sourceSha256 = identity.sourceHash;
+  } catch (error) {
+    await adapter.close();
+    throw error;
+  } finally {
+    if (!keepAlive) await adapter.close();
+  }
+  m.corpus.root = path.resolve(
+    metaRoot,
+    'audits/2026-10-22-agent-use-transcripts/spec/fixtures/corpus',
+  );
+  m.corpus.splitSha256 = digest(readJSON(path.join(m.corpus.root, 'split.json')));
+  validateManifest(m);
+  writePrivate(output, m);
+  return { output, manifestSha256: digest(m), identity, ...(keepAlive ? { adapter } : {}) };
+}
+if (direct(import.meta.url))
+  main(async () => {
+    const a = args(process.argv.slice(2));
+    console.log(
+      canonical(await prepare({ hubRoot: a['hub-root'], template: a.template, output: a.out })),
+    );
+  });
diff --git a/scripts/agent-evals/report.mjs b/scripts/agent-evals/report.mjs
new file mode 100644
index 000000000..6200f9ec9
--- /dev/null
+++ b/scripts/agent-evals/report.mjs
@@ -0,0 +1,278 @@
+import path from 'node:path';
+import { assert, canonical, digest, readJSON, jsonl, args, direct, main } from './lib/common.mjs';
+import { dedupe, validateObservation, validateRecord } from './lib/receipts.mjs';
+import { pairedBootstrap, summarize } from './lib/statistics.mjs';
+import { compileComplaintSchema, complaintReport, loadComplaintInput } from './complaint.mjs';
+import { loadManifest } from './lib/manifest.mjs';
+const printable = (v) => (Number.isFinite(v) ? v : 'unbounded');
+export function analyze(input) {
+  assert(input.version === 1 && Array.isArray(input.observations), 'report input');
+  const observations = input.observations.map(validateObservation);
+  const d = dedupe(observations.map((o) => ({ ...o, id: `${o.episodeId}:${o.arm}:${o.repeat}` })));
+  const quarantine = [...d.quarantine];
+  const cohorts = new Map();
+  for (const row of d.records) {
+    const key = digest(row.cohort);
+    const rows = cohorts.get(key) ?? [];
+    rows.push(row);
+    cohorts.set(key, rows);
+  }
+  const reports = [];
+  for (const [cohort, raw] of cohorts) {
+    const byEpisode = new Map();
+    for (const row of raw) {
+      const key = `${row.episodeId}:${row.arm}`;
+      const list = byEpisode.get(key) ?? [];
+      list.push(row);
+      byEpisode.set(key, list);
+    }
+    const rows = [];
+    for (const list of byEpisode.values()) {
+      const first = list[0];
+      if (list.length > 1 && input.repeatAggregation !== 'all_repeats') {
+        quarantine.push(first.episodeId);
+        continue;
+      }
+      rows.push({
+        ...first,
+        outcome: list.every((x) => x.outcome === 'success')
+          ? 'success'
+          : list.find((x) => x.outcome !== 'success').outcome,
+        costMicroUsd: list.some((x) => x.costMicroUsd === null)
+          ? null
+          : list.reduce((n, x) => n + x.costMicroUsd, 0),
+        upperMicroUsd: list.some((x) => x.upperMicroUsd === null)
+          ? null
+          : list.reduce((n, x) => n + x.upperMicroUsd, 0),
+        latencyMs: list.reduce((n, x) => n + x.latencyMs, 0),
+        complete: list.every((x) => x.complete),
+        critical: list.flatMap((x) => x.critical),
+        costStatus: list.some((x) => x.costStatus === 'unbounded')
+          ? 'unbounded'
+          : list.some((x) => x.costStatus === 'bounded_unknown')
+            ? 'bounded_unknown'
+            : 'known',
+      });
+    }
+    const arms = {};
+    for (const arm of ['full', 'jev', 'core_discovery']) {
+      const items = rows.filter((r) => r.arm === arm);
+      const s = summarize(items, arm === 'full' ? 'baseline' : 'candidate');
+      arms[arm] = {
+        ...s,
+        costMicroUsd: printable(s.costMicroUsd),
+        cpsMicroUsd: printable(s.cpsMicroUsd),
+        p95LatencyMs: printable(s.p95LatencyMs),
+        attempts: raw.filter((r) => r.arm === arm).reduce((n, r) => n + (r.attempts ?? 1), 0),
+        knownBillCoverage: items.length
+          ? items.filter((r) => r.costStatus === 'known').length / items.length
+          : 0,
+        costPerStartedMicroUsd: items.length
+          ? printable(s.costMicroUsd / items.length)
+          : 'unbounded',
+      };
+    }
+    const comparisons = {};
+    for (const candidateArm of ['jev', 'core_discovery']) {
+      const bases = rows.filter((r) => r.arm === 'full'),
+        candidates = rows.filter((r) => r.arm === candidateArm),
+        pairs = bases.flatMap((base) => {
+          const candidate = candidates.find((c) => c.episodeId === base.episodeId);
+          return candidate && candidate.clusterId === base.clusterId ? [{ base, candidate }] : [];
+        });
+      const reasons = [];
+      if (
+        pairs.length !== bases.length ||
+        pairs.length !== candidates.length ||
+        (input.expectedEpisodes && pairs.length !== input.expectedEpisodes.length) ||
+        !pairs.length
+      )
+        reasons.push('incomplete_pairs');
+      if (rows.some((r) => !r.complete)) reasons.push('incomplete_receipts');
+      if (
+        rows.some(
+          (r) =>
+            r.costStatus === 'unbounded' || (r.costStatus === 'known' && r.costMicroUsd === null),
+        )
+      )
+        reasons.push('unbounded_cost');
+      if (quarantine.length) reasons.push('quarantined_records');
+      if (cohorts.size > 1) reasons.push('drift_separated_cohorts');
+      if (
+        !input.preregistration?.stopping ||
+        !input.preregistration?.expansion ||
+        !input.repeatAggregation
+      )
+        reasons.push('missing_preregistration');
+      if (!input.humanCorpusReady || rows.some((r) => r.labelMethod !== 'human_adjudicated'))
+        reasons.push('independent_human_corpus_not_ready');
+      const boot = pairs.length ? pairedBootstrap(pairs, { seed: input.seed, draws: 10000 }) : null;
+      if (!boot || boot.clusters < (input.minimumClusters ?? 60))
+        reasons.push('insufficient_power');
+      const critical = candidates.flatMap((c) => c.critical);
+      if (critical.length) reasons.push('critical_veto');
+      const gates = boot
+        ? {
+            success:
+              typeof boot.intervals.successDifference.lower === 'number' &&
+              boot.intervals.successDifference.lower >= -0.02,
+            cost:
+              boot.undefinedCostDraws === 0 &&
+              typeof boot.intervals.costRatio.upper === 'number' &&
+              boot.intervals.costRatio.upper < 1,
+            latency:
+              typeof boot.intervals.latencyRatio.upper === 'number' &&
+              boot.intervals.latencyRatio.upper <= 1.1,
+          }
+        : { success: false, cost: false, latency: false };
+      const status = reasons.length
+        ? 'inconclusive'
+        : Object.values(gates).every(Boolean)
+          ? 'candidate_eligible_for_human_review'
+          : 'baseline_retained';
+      comparisons[candidateArm] = {
+        status,
+        reasons,
+        gates,
+        critical,
+        bootstrap: boot,
+        pairedEpisodes: pairs.length,
+        adverseUnknownBounds: rows.some((r) => r.costStatus === 'bounded_unknown'),
+      };
+    }
+    reports.push({ cohort, provenance: raw[0]?.cohort, arms, comparisons });
+  }
+  return {
+    version: 1,
+    status:
+      reports.length &&
+      reports.every((r) =>
+        Object.values(r.comparisons).every(
+          (c) => c.status === 'candidate_eligible_for_human_review',
+        ),
+      )
+        ? 'candidate_eligible_for_human_review'
+        : 'baseline_retained',
+    cohorts: reports,
+    quarantine,
+    preregistration: input.preregistration ?? null,
+    authority: 'analysis_only',
+  };
+}
+export function reportRun(root) {
+  const result = readJSON(path.join(root, 'result.json')),
+    manifest = readJSON(path.join(root, 'manifest.json'));
+  assert(digest(manifest) === result.manifestSha256, 'run manifest hash changed');
+  const events = dedupe(jsonl(path.join(root, 'events.jsonl')).map(validateRecord)),
+    receipts = dedupe(jsonl(path.join(root, 'receipts.jsonl')).map(validateRecord));
+  const records = [...events.records, ...receipts.records];
+  const combined = dedupe(records);
+  assert(
+    records.every(
+      (r) => r.runId === result.runId && digest(r.revisions) === digest(manifest.provenance),
+    ),
+    'run receipt revision/binding mismatch',
+  );
+  const analysis = structuredClone(result.analysis);
+  analysis.expectedEpisodes = manifest.corpus.episodeIds;
+  for (const row of analysis.observations) {
+    const relevant = receipts.records.filter(
+      (r) => r.episodeId === row.episodeId && r.arm === row.arm,
+    );
+    const collection = relevant.find((r) => r.kind === 'collection'),
+      reset = relevant.find((r) => r.kind === 'reset');
+    const required = manifest.evidence.expectedKinds.filter(
+      (k) => !['adapter_identity'].includes(k),
+    );
+    if (
+      !collection ||
+      !reset ||
+      collection.rootId !== reset.rootId ||
+      required.some((kind) => !relevant.some((r) => r.kind === kind)) ||
+      events.quarantine.length ||
+      receipts.quarantine.length ||
+      combined.quarantine.length
+    ) {
+      row.complete = false;
+      row.outcome = 'indeterminate';
+    }
+    assert(digest(row.cohort) === digest(manifest.provenance), 'cohort binding mismatch');
+    if (collection) {
+      row.outcome = row.complete ? collection.payload.outcome : 'indeterminate';
+      row.complete = row.complete && collection.payload.complete === true;
+      row.critical = collection.payload.critical;
+    }
+    const drift = relevant
+      .filter((r) => r.kind === 'provider_received' || r.kind === 'provider_settled')
+      .flatMap((r) => {
+        const request = events.records.find(
+          (e) => e.kind === 'provider_requested' && e.attemptId === r.attemptId,
+        );
+        const model =
+          request?.payload.kind === 'classifier'
+            ? manifest.provenance.model.classifier
+            : manifest.provenance.model;
+        return r.payload.resolvedModel && !model?.resolved.includes(r.payload.resolvedModel)
+          ? [
+              {
+                kind: request?.payload.kind ?? 'unknown',
+                requested: request?.payload.requestedModel ?? null,
+                resolved: r.payload.resolvedModel,
+              },
+            ]
+          : [];
+      });
+    if (drift.length) row.cohort = { ...manifest.provenance, observedModelDrift: drift };
+
+    const bills = dedupe(
+      relevant
+        .filter((r) => r.kind === 'provider_settled' || r.kind === 'provider_failed')
+        .map((r) => ({ ...r.payload, id: r.attemptId })),
+    );
+    if (bills.quarantine.length) {
+      row.complete = false;
+      row.costStatus = 'unbounded';
+      row.upperMicroUsd = null;
+    }
+    const requests = events.records.filter(
+      (r) => r.kind === 'provider_requested' && r.episodeId === row.episodeId && r.arm === row.arm,
+    );
+    if (requests.some((r) => !bills.records.some((b) => b.id === r.attemptId))) {
+      row.complete = false;
+      row.outcome = 'indeterminate';
+      row.costStatus = 'unbounded';
+      row.upperMicroUsd = null;
+    }
+    const known = bills.records
+      .filter((r) => r.costStatus === 'known')
+      .reduce((n, r) => n + r.costMicroUsd, 0);
+    assert(
+      row.costMicroUsd === null || row.costMicroUsd >= known,
+      'cached outcome omitted billed attempts',
+    );
+  }
+  return analyze(analysis);
+}
+if (direct(import.meta.url))
+  main(async () => {
+    const a = args(process.argv.slice(2));
+    if (a.complaint) {
+      const { manifest } = loadManifest(a.manifest);
+      assert(manifest.provenance.gateway, 'pinned C source required');
+      const validate = compileComplaintSchema(
+        path.resolve(a['gateway-root']),
+        manifest.provenance.gateway,
+      );
+      console.log(
+        canonical(
+          complaintReport(
+            loadComplaintInput(a.complaint, manifest.provenance.gateway),
+            validate,
+            manifest.gates.complaint,
+            a.labels ? readJSON(a.labels) : [],
+          ),
+        ),
+      );
+    } else
+      console.log(canonical(a.run ? reportRun(path.resolve(a.run)) : analyze(readJSON(a.input))));
+  });
diff --git a/scripts/agent-evals/report.test.mjs b/scripts/agent-evals/report.test.mjs
new file mode 100644
index 000000000..80e7a7ac4
--- /dev/null
+++ b/scripts/agent-evals/report.test.mjs
@@ -0,0 +1,94 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { analyze } from './report.mjs';
+import { canonical } from './lib/common.mjs';
+function data() {
+  const observations = [];
+  for (let i = 0; i < 12; i++)
+    for (const arm of ['full', 'jev', 'core_discovery'])
+      observations.push({
+        episodeId: `e${i}`,
+        clusterId: `c${i}`,
+        arm,
+        repeat: 0,
+        cohort: { source: 'same', model: 'frozen', rubric: 'v1' },
+        outcome: 'success',
+        costMicroUsd: arm === 'full' ? 100 : 50,
+        upperMicroUsd: arm === 'full' ? 100 : 50,
+        costStatus: 'known',
+        latencyMs: 100,
+        complete: true,
+        critical: [],
+        labelMethod: 'human_adjudicated',
+      });
+  return {
+    version: 1,
+    observations,
+    seed: 7,
+    minimumClusters: 12,
+    humanCorpusReady: true,
+    repeatAggregation: 'single',
+    preregistration: { stopping: 'fixed', expansion: 'none' },
+  };
+}
+const comparison = (d) => analyze(d).cohorts[0].comparisons.jev;
+test('10000 paired cluster draws are byte-reproducible and recompute whole CPS ratios', () => {
+  const d = data(),
+    r = analyze(d);
+  assert.equal(r.cohorts[0].arms.jev.cpsMicroUsd, 50);
+  assert.equal(comparison(d).bootstrap.point.costRatio, 0.5);
+  assert.equal(comparison(d).bootstrap.draws, 10000);
+  assert.equal(comparison(d).status, 'candidate_eligible_for_human_review');
+  assert.equal(canonical(r), canonical(analyze(d)));
+});
+test('all failed costs stay numerator: cheaper less successful candidate fails', () => {
+  const d = data();
+  d.observations
+    .filter((r) => r.arm === 'jev')
+    .forEach((r, i) => {
+      r.costMicroUsd = 60;
+      r.upperMicroUsd = 60;
+      r.outcome = i < 5 ? 'success' : 'incorrect';
+    });
+  const r = analyze(d).cohorts[0];
+  assert.equal(r.arms.jev.costMicroUsd, 720);
+  assert.equal(r.arms.jev.cpsMicroUsd, 144);
+  assert(r.comparisons.jev.bootstrap.point.costRatio > 1);
+  assert.notEqual(r.comparisons.jev.status, 'candidate_eligible_for_human_review');
+});
+test('zero successes and nonfinite bootstrap draws cannot disappear', () => {
+  const d = data();
+  d.observations.filter((r) => r.arm === 'jev').forEach((r) => (r.outcome = 'incorrect'));
+  const r = comparison(d);
+  assert.equal(r.bootstrap.undefinedCostDraws, 10000);
+  assert.equal(r.bootstrap.intervals.costRatio.upper, 'unbounded');
+  assert.equal(r.gates.cost, false);
+});
+test('critical, missing arm/receipt, unbounded bill, drift, missing preregistration veto', () => {
+  for (const mutate of [
+    (d) => d.observations.find((r) => r.arm === 'jev').critical.push('wrong_scope'),
+    (d) => d.observations.splice(1, 1),
+    (d) => (d.observations[1].complete = false),
+    (d) => {
+      d.observations[1].costStatus = 'unbounded';
+      d.observations[1].upperMicroUsd = null;
+    },
+    (d) => (d.observations[1].cohort.model = 'drift'),
+    (d) => delete d.preregistration,
+  ]) {
+    const d = data();
+    mutate(d);
+    assert.notEqual(comparison(d).status, 'candidate_eligible_for_human_review');
+  }
+});
+test('bounded unknown uses adverse candidate upper, baseline lower; repeated episode clusters retained', () => {
+  const d = data();
+  d.observations.find((r) => r.arm === 'jev').costStatus = 'bounded_unknown';
+  d.observations.find((r) => r.arm === 'jev').upperMicroUsd = 1000;
+  assert(comparison(d).bootstrap.point.costRatio > 1);
+  assert.equal(comparison(d).adverseUnknownBounds, true);
+  d.repeatAggregation = 'all_repeats';
+  for (const row of [...d.observations]) d.observations.push({ ...row, repeat: 1 });
+  assert.equal(comparison(d).bootstrap.clusters, 12);
+  assert.equal(analyze(d).cohorts[0].arms.full.costMicroUsd, 2400);
+});
diff --git a/scripts/agent-evals/run.mjs b/scripts/agent-evals/run.mjs
new file mode 100644
index 000000000..215bb0a51
--- /dev/null
+++ b/scripts/agent-evals/run.mjs
@@ -0,0 +1,618 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import {
+  assert,
+  canonical,
+  digest,
+  readJSON,
+  safePath,
+  writePrivate,
+  append,
+  args,
+  direct,
+  main,
+  rng,
+  shuffled,
+  syncDir,
+  jsonl,
+} from './lib/common.mjs';
+import { ARMS, loadManifest, verifyCheckout } from './lib/manifest.mjs';
+import { loadCorpus, readiness } from './corpus.mjs';
+import { HubAdapter } from './lib/hub-adapter.mjs';
+import { fixtureProvider, liveProvider } from './lib/live-provider.mjs';
+import { verifyApproval, loadConfig } from './lib/approval.mjs';
+import { initializeRegistry, openBudget } from './lib/budget.mjs';
+import { prepare } from './prepare.mjs';
+import { scoreEpisode } from './lib/receipts.mjs';
+export async function runEvaluation(options) {
+  const { manifest, sha256 } = loadManifest(options.manifest);
+  const live = options.live === true;
+  assert((manifest.mode === 'live') === live, '--live and manifest mode must agree');
+  if (options.mode) assert(options.mode === manifest.mode, 'mode mismatch');
+  const metaRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+  verifyCheckout(metaRoot, manifest.provenance.meta);
+  const hubRoot = options.hubRoot;
+  safePath(hubRoot, { directory: true });
+  verifyCheckout(hubRoot, manifest.provenance.hub, true);
+  const corpus = loadCorpus(manifest.corpus.root, {
+    mode: manifest.corpus.split,
+    splitSha256: manifest.corpus.splitSha256,
+    unblinding: manifest.corpus.unblinding,
+    episodeIds: manifest.corpus.episodeIds,
+  });
+  assert(corpus.episodes.length === manifest.corpus.episodeIds.length, 'episode coverage');
+  const readinessCorpora = [corpus];
+  if (manifest.corpus.split === 'holdout')
+    readinessCorpora.push(
+      loadCorpus(manifest.corpus.root, {
+        mode: 'development',
+        splitSha256: manifest.corpus.splitSha256,
+      }),
+    );
+  assert(
+    readinessCorpora.every((set) =>
+      set.labels.every((label) => label.rubricRevision === manifest.provenance.rubric),
+    ),
+    'independent rubric revision drift',
+  );
+  const output = options.out;
+  safePath(output, { existing: false, directory: true });
+  assert(!fs.existsSync(output), 'run output already exists');
+  safePath(path.dirname(output), { directory: true });
+  let approval, budget, credential;
+  if (live) {
+    for (const key of ['approval', 'operatorConfig', 'trustedKey', 'ownerRef', 'credentialFile'])
+      assert(options[key], `missing live ${key}`);
+    for (const p of [
+      options.approval,
+      options.operatorConfig,
+      options.trustedKey,
+      options.credentialFile,
+    ])
+      assert(!path.resolve(p).startsWith(`${output}/`), 'trust/credentials outside generated run');
+    approval = verifyApproval({
+      manifest,
+      manifestSha256: sha256,
+      approvalPath: options.approval,
+      configPath: options.operatorConfig,
+      keyPath: options.trustedKey,
+      ownerRef: options.ownerRef,
+    });
+    assert(
+      output !== approval.config.root &&
+        !output.startsWith(`${approval.config.root}/`) &&
+        !approval.config.root.startsWith(`${output}/`),
+      'registry outside run outputs',
+    );
+    safePath(options.credentialFile);
+    assert(
+      (fs.statSync(options.credentialFile).mode & 0o077) === 0,
+      'credential input must be private',
+    );
+    credential = fs.readFileSync(options.credentialFile, 'utf8').trim();
+    assert(credential.length >= 4, 'empty explicit credential');
+    budget = openBudget(approval.config, { journalAssertion: options.budgetJournal });
+  } else
+    assert(
+      !options.approval &&
+        !options.operatorConfig &&
+        !options.credentialFile &&
+        !options.budgetJournal,
+      'fixture cannot use paid inputs',
+    );
+  const runId = crypto.randomUUID();
+  let adapter,
+    episode,
+    arm,
+    current,
+    attemptCount = 0,
+    canceled = false,
+    closed = false;
+  const observations = [],
+    orders = [],
+    resetHashes = {},
+    attempts = [],
+    rawFiles = [];
+  const controller = new AbortController();
+  fs.mkdirSync(output, { mode: 0o700 });
+  writePrivate(path.join(output, 'active-writer.json'), { pid: process.pid, runId });
+  fs.mkdirSync(path.join(output, 'raw'), { mode: 0o700 });
+  writePrivate(path.join(output, 'manifest.json'), manifest);
+  writePrivate(path.join(output, 'events.jsonl'), '');
+  writePrivate(path.join(output, 'receipts.jsonl'), '');
+  syncDir(output);
+  const raw = (name, value) => {
+    const relative = `raw/${name}.json`;
+    writePrivate(path.join(output, relative), value);
+    rawFiles.push(relative);
+  };
+  const record = (file, kind, payload, attemptId = null) => {
+    append(path.join(output, file), {
+      version: 1,
+      id: crypto.randomUUID(),
+      runId,
+      episodeId: episode?.episodeId ?? 'run',
+      clusterId: episode?.clusterId ?? 'run',
+      arm: arm ?? 'run',
+      attemptId,
+      rootId: current?.rootId ?? runId,
+      submissionId: current?.submissionId ?? runId,
+      parentId: current?.parentId ?? null,
+      at: new Date().toISOString(),
+      revisions: manifest.provenance,
+      kind,
+      payload,
+    });
+  };
+  const onCancel = () => {
+    canceled = true;
+    controller.abort(new Error('operator cancellation'));
+    record('events.jsonl', 'canceled', { reason: 'operator' });
+  };
+  process.once('SIGINT', onCancel);
+  process.once('SIGTERM', onCancel);
+  let failure = null;
+  try {
+    record('events.jsonl', 'prepared', {
+      manifestSha256: sha256,
+      approvalSha256: approval?.approvalSha256 ?? null,
+      mode: manifest.mode,
+    });
+    raw('episodes', corpus.episodes);
+    const onProvider = async (request) => {
+      assert(!canceled && !controller.signal.aborted, 'provider admission canceled');
+      assert(episode && arm && current, 'provider without active episode');
+      assert(
+        Buffer.byteLength(canonical(request)) <= manifest.bounds.maxRequestBytes,
+        'provider request payload bound exceeded',
+      );
+      assert(
+        ++attemptCount <= manifest.bounds.maxCalls && attemptCount <= manifest.bounds.maxAttempts,
+        'run effort exceeded',
+      );
+      assert(current.calls++ < episode.maxEffort.calls, 'episode effort exceeded');
+      const attemptId = crypto.randomUUID();
+      const attempt = {
+        attemptId,
+        episodeId: episode.episodeId,
+        arm,
+        kind: request.kind,
+        admitted: false,
+        dispatched: false,
+        requestedModel: request.model,
+        resolvedModel: null,
+        costStatus: live ? 'unknown' : 'known',
+        costMicroUsd: live ? null : 0,
+        upperMicroUsd: live ? null : 0,
+        usage: null,
+      };
+      attempts.push(attempt);
+      raw(`request-${attemptId}`, request);
+      record(
+        'events.jsonl',
+        'provider_requested',
+        {
+          requestId: request.requestId,
+          requestSha256: digest(request),
+          kind: request.kind,
+          requestedModel: request.model,
+        },
+        attemptId,
+      );
+      const onReceipt = async (receipt) => {
+        if (receipt.kind === 'provider_received') {
+          raw(`provider-${attemptId}`, receipt);
+          Object.assign(attempt, {
+            costStatus: receipt.costStatus,
+            costMicroUsd: receipt.exactCostUsd === null ? null : receipt.exactCostUsd * 1e6,
+            exactCostUsd: receipt.exactCostUsd,
+            resolvedModel: receipt.resolvedModel,
+            usage: receipt.usage,
+          });
+        }
+        record(
+          'receipts.jsonl',
+          receipt.kind,
+          Object.fromEntries(
+            Object.entries(receipt).filter(([k]) => !['raw', 'result'].includes(k)),
+          ),
+          attemptId,
+        );
+      };
+      try {
+        const result = live
+          ? await liveProvider({
+              request,
+              manifest,
+              credential,
+              budget,
+              scope: manifest.accounting.accountingScopeId,
+              alias: approval.payload.approvalNamespace,
+              attemptId,
+              runId,
+              signal: controller.signal,
+              onReceipt,
+            })
+          : await fixtureProvider({
+              request,
+              episode,
+              index: current.providerIndices[request.kind]++,
+            });
+        Object.assign(attempt, {
+          costStatus: result.usage.costStatus,
+          costMicroUsd: result.usage.costUsd * 1e6,
+          exactCostUsd: result.usage.costUsd,
+          admitted: live,
+          dispatched: live,
+          upperMicroUsd: result.upperMicroUsd,
+          resolvedModel: result.resolvedModel,
+          usage: result.usage,
+        });
+        record('receipts.jsonl', 'provider_settled', { ...attempt }, attemptId);
+        const { upperMicroUsd, ...payload } = result;
+        return payload;
+      } catch (error) {
+        const reservation = budget
+          ?.status(manifest.accounting.accountingScopeId)
+          .attempts.get(attemptId);
+        if (reservation) {
+          attempt.upperMicroUsd = reservation.reservation.upperMicroUsd;
+          attempt.admitted = true;
+          attempt.dispatched = budget.entries.some(
+            (e) => e.kind === 'dispatched' && e.attemptId === attemptId,
+          );
+        } else if (live) {
+          attempt.costStatus = 'known';
+          attempt.costMicroUsd = 0;
+          attempt.upperMicroUsd = 0;
+          attempt.exactCostUsd = 0;
+        }
+        record(
+          'receipts.jsonl',
+          'provider_failed',
+          {
+            attemptId,
+            reason: error.message,
+            costStatus: attempt.costStatus,
+            costMicroUsd: attempt.costMicroUsd,
+            upperMicroUsd: attempt.upperMicroUsd,
+          },
+          attemptId,
+        );
+        throw error;
+      }
+    };
+    adapter =
+      options.preparedAdapter ??
+      new HubAdapter({
+        root: hubRoot,
+        pin: manifest.provenance.hub,
+        bounds: manifest.bounds,
+        onProvider,
+      });
+    adapter.onProvider = onProvider;
+    adapter.pin = manifest.provenance.hub;
+    const hello = options.preparedIdentity
+      ? adapter.adoptHello(options.preparedIdentity)
+      : await adapter.hello();
+    record('receipts.jsonl', 'adapter_identity', { ...hello, evidenceRoot: hello.evidenceRoot });
+    const random = rng(manifest.seed);
+    const deadline = Date.now() + manifest.bounds.maxDurationMs;
+    for (episode of corpus.episodes) {
+      const order = shuffled(ARMS, random);
+      orders.push({ episodeId: episode.episodeId, order });
+      let initialHash = null;
+      for (arm of order) {
+        if (canceled) break;
+        assert(Date.now() < deadline, 'run duration exceeded');
+        current = {
+          rootId: crypto.randomUUID(),
+          submissionId: crypto.randomUUID(),
+          parentId: null,
+          calls: 0,
+          providerIndices: { main: 0, classifier: 0 },
+          started: Date.now(),
+        };
+        const started = current.started;
+        const reset = await adapter.send('reset', {
+          episodeId: episode.episodeId,
+          arm,
+          seed: manifest.seed,
+          persona: episode.initialState.persona,
+          initialState: episode.initialState.fixtureId,
+          ...(initialHash ? { initialStateHash: initialHash } : {}),
+          locale: episode.locale,
+          surface: episode.initialState.surface,
+          sandbox: episode.initialState.sandbox,
+          revisions: { boundedLabels: digest(manifest.provenance) },
+          allowedTools: episode.permissions.allowedTools,
+          model: {
+            requestedModel: manifest.provenance.model.requested,
+            boundDescriptor: manifest.provenance.provider.boundPolicy,
+          },
+        });
+        assert(
+          reset.episodeId === episode.episodeId && reset.arm === arm,
+          'reset identity mismatch',
+        );
+        assert(
+          reset.initialStateHash === episode.initialState.sha256,
+          'initial fixture state drift',
+        );
+        initialHash ??= reset.initialStateHash;
+        assert(initialHash === reset.initialStateHash, 'arms did not reset identical state');
+        resetHashes[`${episode.episodeId}:${arm}`] = reset.initialStateHash;
+        record('receipts.jsonl', 'reset', reset);
+        let collection;
+        let armCanceled = false;
+        for (const step of episode.steps) {
+          assert(
+            Date.now() < deadline && Date.now() - started < episode.maxEffort.durationMs,
+            'episode deadline',
+          );
+          if (canceled) break;
+          current.parentId = current.submissionId;
+          current.submissionId = crypto.randomUUID();
+          record('events.jsonl', 'step', { type: step.type, payloadSha256: digest(step.payload) });
+          const before = attempts.length;
+          const stepReceipt = await adapter.send(step.type, step.payload);
+          if (step.type === 'cancel') {
+            assert(stepReceipt.canceled === true, 'missing actual cancellation receipt');
+            record('receipts.jsonl', 'cancel', stepReceipt);
+            armCanceled = true;
+            break;
+          }
+          let stable = 0;
+          do {
+            await new Promise((resolve) => setTimeout(resolve, 80));
+            await adapter.drain();
+            collection = await adapter.send('collect', {});
+            const done =
+              !collection.incomplete &&
+              collection.pendingProviders === 0 &&
+              (step.type !== 'turn' || attempts.length > before);
+            stable = done ? stable + 1 : 0;
+            assert(
+              Date.now() < deadline && Date.now() - started < episode.maxEffort.durationMs,
+              'trajectory did not settle',
+            );
+          } while (stable < 2);
+        }
+        await adapter.drain();
+        collection = await adapter.send('collect', {});
+        if (armCanceled) collection.canceled = true;
+        assert(
+          collection.episodeId === episode.episodeId && collection.arm === arm,
+          'collection identity mismatch',
+        );
+        raw(`collection-${episode.episodeId}-${arm}`, collection);
+        const score = scoreEpisode(episode, collection);
+        record('receipts.jsonl', 'collection', {
+          ...score,
+          finalStateHash: collection.finalStateHash,
+          network: collection.network,
+          domainReceipts: collection.receipts,
+          inference: collection.inference,
+        });
+        const calls = attempts.filter((a) => a.episodeId === episode.episodeId && a.arm === arm),
+          known = calls.every((a) => a.costStatus === 'known'),
+          bounded = calls.every((a) => a.upperMicroUsd !== null);
+        observations.push({
+          episodeId: episode.episodeId,
+          clusterId: episode.clusterId,
+          arm,
+          repeat: 0,
+          cohort: manifest.provenance,
+          outcome: score.outcome,
+          costMicroUsd: known ? calls.reduce((n, a) => n + a.costMicroUsd, 0) : null,
+          upperMicroUsd: bounded ? calls.reduce((n, a) => n + a.upperMicroUsd, 0) : null,
+          costStatus: known ? 'known' : bounded ? 'bounded_unknown' : 'unbounded',
+          latencyMs: Date.now() - started,
+          complete: score.complete,
+          critical: score.critical,
+          labelMethod:
+            corpus.labels.find((l) => l.episodeId === episode.episodeId)?.method ?? 'unadjudicated',
+          attempts: calls.length,
+        });
+      }
+    }
+  } catch (error) {
+    failure = error;
+    record('events.jsonl', 'failed', { reason: error.message });
+    if (
+      episode &&
+      arm &&
+      !observations.some((o) => o.episodeId === episode.episodeId && o.arm === arm)
+    ) {
+      const calls = attempts.filter((a) => a.episodeId === episode.episodeId && a.arm === arm),
+        known = calls.every((a) => a.costStatus === 'known'),
+        bounded = calls.every((a) => a.upperMicroUsd !== null);
+      observations.push({
+        episodeId: episode.episodeId,
+        clusterId: episode.clusterId,
+        arm,
+        repeat: 0,
+        cohort: manifest.provenance,
+        outcome: canceled ? 'canceled' : 'indeterminate',
+        costMicroUsd: known ? calls.reduce((n, a) => n + a.costMicroUsd, 0) : null,
+        upperMicroUsd: bounded ? calls.reduce((n, a) => n + a.upperMicroUsd, 0) : null,
+        costStatus: known ? 'known' : bounded ? 'bounded_unknown' : 'unbounded',
+        latencyMs: Date.now() - (current?.started ?? Date.now()),
+        complete: false,
+        critical: [],
+        labelMethod:
+          corpus.labels.find((l) => l.episodeId === episode.episodeId)?.method ?? 'unadjudicated',
+        attempts: calls.length,
+      });
+    }
+  } finally {
+    process.off('SIGINT', onCancel);
+    process.off('SIGTERM', onCancel);
