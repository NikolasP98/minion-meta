+++ b/scripts/agent-evals/lib/receipts.mjs
@@ -0,0 +1,150 @@
+import { assert, object, string, uuid, canonical, integer } from './common.mjs';
+export function validateRecord(r) {
+  object(r, [
+    'version',
+    'id',
+    'runId',
+    'episodeId',
+    'clusterId',
+    'arm',
+    'attemptId',
+    'rootId',
+    'submissionId',
+    'parentId',
+    'at',
+    'revisions',
+    'kind',
+    'payload',
+  ]);
+  assert(r.version === 1, 'record version');
+  uuid(r.id);
+  uuid(r.runId);
+  for (const k of ['episodeId', 'clusterId', 'arm', 'rootId', 'submissionId', 'kind']) string(r[k]);
+  assert(r.attemptId === null || typeof r.attemptId === 'string', 'attempt relation');
+  assert(r.parentId === null || typeof r.parentId === 'string', 'parent relation');
+  assert(Number.isFinite(Date.parse(r.at)), 'record time');
+  assert(
+    r.revisions && typeof r.revisions === 'object' && r.payload && typeof r.payload === 'object',
+    'record payload',
+  );
+  return r;
+}
+export function dedupe(records, key = 'id') {
+  const map = new Map(),
+    quarantine = [];
+  for (const r of records) {
+    const prior = map.get(r[key]);
+    if (prior && canonical(prior) !== canonical(r)) {
+      quarantine.push(r[key]);
+    } else if (!prior) map.set(r[key], r);
+  }
+  return {
+    records: [...map.values()].filter((r) => !quarantine.includes(r[key])),
+    quarantine: [...new Set(quarantine)],
+  };
+}
+export function scoreEpisode(episode, collection) {
+  const raw = collection.receipts ?? [];
+  for (const r of raw) {
+    assert(
+      typeof r.actionId === 'string' &&
+        typeof r.tool === 'string' &&
+        typeof r.beforeStateHash === 'string' &&
+        typeof r.afterStateHash === 'string',
+      'invalid domain receipt',
+    );
+  }
+  const receipts = dedupe(raw, 'actionId');
+  const missing = episode.expectedReceipts.filter(
+    (kind) => !receipts.records.some((r) => r.tool === kind && r.disposition === 'committed'),
+  );
+  missing.push(
+    ...episode.expectedArtifacts.filter(
+      (id) =>
+        !(collection.artifacts ?? []).some((a) => a.id === id && a.disposition === 'produced'),
+    ),
+  );
+  const network = collection.network;
+  const keys = new Map();
+  const duplicateActions = new Set();
+  for (const r of receipts.records) {
+    const previous = keys.get(r.idempotencyKey);
+    if (previous && previous.actionId !== r.actionId) duplicateActions.add(r.actionId);
+    keys.set(r.idempotencyKey, r);
+  }
+  const critical = receipts.records.filter(
+    (r) =>
+      r.critical === true ||
+      r.wrongScope === true ||
+      r.postCancel === true ||
+      r.duplicateAction === true ||
+      duplicateActions.has(r.actionId) ||
+      r.unauthorized === true ||
+      !episode.permissions.allowedTools.includes(r.tool) ||
+      r.actorId !== 'fixture-user' ||
+      r.orgId !== episode.initialState.org ||
+      r.episodeId !== episode.episodeId,
+  );
+  let complete =
+    !!network &&
+    network.externalRequests === 0 &&
+    collection.incomplete === false &&
+    !missing.length &&
+    !receipts.quarantine.length;
+  if (collection.identity?.disposable !== true) complete = false;
+  let outcome = 'indeterminate';
+  if (complete) {
+    if (critical.length) outcome = 'incorrect';
+    else if (episode.terminal.criterion === 'canceled')
+      outcome = collection.canceled ? 'canceled' : 'incorrect';
+    else if (episode.terminal.criterion === 'answer_contains')
+      outcome = (collection.answerTexts ?? []).some(
+        (text) => typeof text === 'string' && text.includes(episode.terminal.expectedText),
+      )
+        ? 'success'
+        : 'incorrect';
+    else outcome = 'success';
+  }
+  return {
+    outcome,
+    complete,
+    missing,
+    quarantine: receipts.quarantine,
+    critical: critical.map((r) => r.actionId),
+  };
+}
+export function validateObservation(o) {
+  object(
+    o,
+    [
+      'episodeId',
+      'clusterId',
+      'arm',
+      'repeat',
+      'cohort',
+      'outcome',
+      'costMicroUsd',
+      'upperMicroUsd',
+      'costStatus',
+      'latencyMs',
+      'complete',
+      'critical',
+      'labelMethod',
+    ],
+    ['attempts'],
+  );
+  string(o.episodeId);
+  string(o.clusterId);
+  integer(o.repeat);
+  assert(['full', 'jev', 'core_discovery'].includes(o.arm), 'arm');
+  assert(
+    ['success', 'incorrect', 'blocked', 'canceled', 'indeterminate'].includes(o.outcome),
+    'outcome',
+  );
+  assert(['known', 'bounded_unknown', 'unbounded'].includes(o.costStatus), 'cost status');
+  for (const k of ['costMicroUsd', 'upperMicroUsd'])
+    assert(o[k] === null || (Number.isFinite(o[k]) && o[k] >= 0), `invalid ${k}`);
+  assert(Number.isFinite(o.latencyMs) && o.latencyMs >= 0, 'latency');
+  assert(typeof o.complete === 'boolean' && Array.isArray(o.critical), 'coverage');
+  return o;
+}
diff --git a/scripts/agent-evals/lib/statistics.mjs b/scripts/agent-evals/lib/statistics.mjs
new file mode 100644
index 000000000..2d2d31810
--- /dev/null
+++ b/scripts/agent-evals/lib/statistics.mjs
@@ -0,0 +1,91 @@
+import { assert, rng } from './common.mjs';
+export function percentile(values, p) {
+  const a = [...values].sort((a, b) => a - b);
+  if (!a.length) return Infinity;
+  const index = Math.min(a.length - 1, Math.max(0, Math.ceil(p * a.length) - 1));
+  return a[index];
+}
+const finite = (x) => (Number.isFinite(x) ? x : 'unbounded');
+export function summarize(rows, adverse = 'candidate') {
+  const cost = rows.reduce(
+    (n, r) =>
+      n +
+      (r.costStatus === 'known'
+        ? r.costMicroUsd
+        : adverse === 'candidate'
+          ? (r.upperMicroUsd ?? Infinity)
+          : (r.costMicroUsd ?? 0)),
+    0,
+  );
+  const successes = rows.filter((r) => r.outcome === 'success').length;
+  return {
+    costMicroUsd: cost,
+    successes,
+    started: rows.length,
+    cpsMicroUsd: successes ? cost / successes : Infinity,
+    successRate: rows.length ? successes / rows.length : 0,
+    p95LatencyMs: percentile(
+      rows.map((r) => r.latencyMs),
+      0.95,
+    ),
+  };
+}
+function statistics(base, candidate) {
+  const b = summarize(base, 'baseline'),
+    c = summarize(candidate, 'candidate');
+  return {
+    costRatio:
+      b.successes &&
+      c.successes &&
+      Number.isFinite(b.cpsMicroUsd) &&
+      Number.isFinite(c.cpsMicroUsd) &&
+      b.cpsMicroUsd > 0
+        ? c.cpsMicroUsd / b.cpsMicroUsd
+        : Infinity,
+    successDifference: c.successRate - b.successRate,
+    latencyRatio: b.p95LatencyMs > 0 ? c.p95LatencyMs / b.p95LatencyMs : Infinity,
+  };
+}
+export function pairedBootstrap(pairs, { seed, draws = 10000 }) {
+  assert(draws === 10000, 'exactly 10000 preregistered draws required');
+  const clusters = new Map();
+  for (const p of pairs) {
+    const list = clusters.get(p.base.clusterId) ?? [];
+    list.push(p);
+    clusters.set(p.base.clusterId, list);
+  }
+  const groups = [...clusters.values()];
+  const random = rng(seed);
+  const values = { costRatio: [], successDifference: [], latencyRatio: [] };
+  let undefinedCostDraws = 0;
+  for (let i = 0; i < draws; i++) {
+    const sample = [];
+    for (let j = 0; j < groups.length; j++)
+      sample.push(...groups[Math.floor(random() * groups.length)]);
+    const stats = statistics(
+      sample.map((p) => p.base),
+      sample.map((p) => p.candidate),
+    );
+    if (!Number.isFinite(stats.costRatio)) undefinedCostDraws++;
+    for (const k of Object.keys(values)) values[k].push(stats[k]);
+  }
+  const intervals = {};
+  for (const [k, v] of Object.entries(values))
+    intervals[k] = { lower: finite(percentile(v, 0.025)), upper: finite(percentile(v, 0.975)) };
+  return {
+    draws,
+    seed,
+    clusters: groups.length,
+    undefinedCostDraws,
+    undefinedCostMass: undefinedCostDraws / draws,
+    point: Object.fromEntries(
+      Object.entries(
+        statistics(
+          pairs.map((p) => p.base),
+          pairs.map((p) => p.candidate),
+        ),
+      ).map(([k, v]) => [k, finite(v)]),
+    ),
+    intervals,
+  };
+}
