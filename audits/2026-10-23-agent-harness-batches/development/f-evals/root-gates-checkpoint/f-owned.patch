+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { liveSetup, cli, ROOT } from '../fixtures/helpers.mjs';
+import { openBudget, initializeRegistry } from './budget.mjs';
+import { jsonl, writePrivate } from './common.mjs';
+const reserve = (b, s, opts = {}) =>
+  b.reserve({
+    scope: s.config.scopes[0].accountingScopeId,
+    alias: 'test-alias',
+    attemptId: crypto.randomUUID(),
+    runId: crypto.randomUUID(),
+    upperMicroUsd: 10,
+    bounds: s.m.bounds,
+    binding: { test: true },
+    ...opts,
+  });
+test('offline exclusive init returns identity only, no keys/trust/approval, reopen missing state fails', () => {
+  const s = liveSetup();
+  assert.deepEqual(fs.readdirSync(s.config.root).sort(), ['budget.jsonl', 'registry.json']);
+  assert.throws(
+    () =>
+      initializeRegistry({
+        root: s.config.root,
+        registryId: crypto.randomUUID(),
+        scopeId: crypto.randomUUID(),
+        ownerRef: 'owner',
+        purpose: 'x',
+      }),
+    /already exists/,
+  );
+  fs.unlinkSync(s.config.metadataPath);
+  assert.throws(() => openBudget(s.config), /missing path/);
+});
+test('registry single lock, unresolved reservation across new run/day aliases, double settlement, overshoot and retirement', () => {
+  const s = liveSetup(),
+    scope = s.config.scopes[0].accountingScopeId;
+  let b = openBudget(s.config);
+  assert.throws(() => openBudget(s.config), /EEXIST/);
+  const r = reserve(b, s);
+  b.dispatched(scope, r.attemptId);
+  b.received(scope, r.attemptId, {
+    costStatus: 'known',
+    costMicroUsd: 1,
+    billingComplete: true,
+    responseSha256: 'a'.repeat(64),
+    resolvedModel: 'fixture/main',
+  });
+  b.settle(scope, r.attemptId);
+  assert.throws(() => b.settle(scope, r.attemptId), /cannot settle/);
+  b.close();
+  b = openBudget(s.config);
+  reserve(b, s, { alias: 'other', day: '2099-01-01' });
+  b.close();
+  b = openBudget(s.config);
+  assert.throws(() => reserve(b, s, { alias: 'fresh', day: '2099-01-02' }), /unknown exposure/);
+  b.retire('test-alias');
+  b.close();
+  b = openBudget(s.config);
+  assert.throws(() => reserve(b, s, { alias: 'fresh' }), /retired/);
+  b.close();
+});
+test('received result recovers local settlement without transport recall; corrupt/truncated journal rejects', () => {
+  const s = liveSetup(),
+    scope = s.config.scopes[0].accountingScopeId;
+  let b = openBudget(s.config);
+  const r = reserve(b, s);
+  b.dispatched(scope, r.attemptId);
+  b.received(scope, r.attemptId, {
+    costStatus: 'known',
+    costMicroUsd: 1,
+    billingComplete: true,
+    responseSha256: 'a'.repeat(64),
+    resolvedModel: 'fixture/main',
+  });
+  b.close();
+  b = openBudget(s.config);
+  assert.equal(b.status(scope).attempts.get(r.attemptId).state, 'settled');
+  b.close();
+  fs.appendFileSync(s.config.journalPath, '{"truncated"');
+  assert.throws(() => openBudget(s.config), /truncated/);
+});
+test('actual CLI killed after dispatch leaves stale lock + admission fence and never auto-replays', () => {
+  const s = liveSetup();
+  const first = cli(s, [], 'crash');
+  assert.equal(first.signal, 'SIGKILL');
+  assert.equal(jsonl(s.counter).length, 1);
+  assert(fs.existsSync(path.join(s.config.root, 'writer.lock')));
+  s.out = path.join(s.root, 'new-run');
+  const second = cli(s);
+  assert.equal(second.status, 1);
+  assert.equal(jsonl(s.counter).length, 1);
+  assert.equal(jsonl(s.config.journalPath).filter((e) => e.kind === 'reserved').length, 1);
+});
+test('actual CLI offline initializer has no transport or trust generation', () => {
+  const s = liveSetup(),
+    root = path.join(s.root, 'offline-new');
+  const r = spawnSync(
+    process.execPath,
+    [
+      path.join(ROOT, 'scripts/agent-evals/run.mjs'),
+      'init-budget-registry',
+      '--root',
+      root,
+      '--registry-id',
+      crypto.randomUUID(),
+      '--scope-id',
+      crypto.randomUUID(),
+      '--owner-ref',
+      'owner',
+      '--purpose',
+      'router',
+    ],
+    { encoding: 'utf8' },
+  );
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(fs.readdirSync(root).sort(), ['budget.jsonl', 'registry.json']);
+});
+test('exhausted scope budget and unknown fence survive next-day/new run aliases, known overshoot persists', () => {
+  const s = liveSetup(),
+    scope = s.config.scopes[0].accountingScopeId;
+  let b = openBudget(s.config);
+  const r = reserve(b, s, { upperMicroUsd: 10 });
+  b.dispatched(scope, r.attemptId);
+  b.received(scope, r.attemptId, {
+    costStatus: 'known',
+    costMicroUsd: 11,
+    billingComplete: true,
+    responseSha256: 'a'.repeat(64),
+    resolvedModel: 'fixture/main',
+  });
+  assert.throws(() => b.settle(scope, r.attemptId), /exceeded/);
+  b.close();
+  b = openBudget(s.config);
+  assert.throws(() => reserve(b, s, { alias: 'next-day', day: '2099-01-02' }), /overshoot/);
+  b.close();
+});
diff --git a/scripts/agent-evals/lib/common.mjs b/scripts/agent-evals/lib/common.mjs
new file mode 100644
index 000000000..47c362ec8
--- /dev/null
+++ b/scripts/agent-evals/lib/common.mjs
@@ -0,0 +1,224 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+export const fail = (message) => {
+  throw new Error(message);
+};
+export function assert(value, message) {
+  if (!value) fail(message);
+}
+export function object(value, required, optional = []) {
+  assert(value && typeof value === 'object' && !Array.isArray(value), 'expected object');
+  for (const key of required) assert(Object.hasOwn(value, key), `missing ${key}`);
+  for (const key of Object.keys(value))
+    assert([...required, ...optional].includes(key), `unknown field ${key}`);
+  return value;
+}
+export function string(v, name = 'string') {
+  assert(typeof v === 'string' && v.length > 0 && v.length <= 4096, `invalid ${name}`);
+  return v;
+}
+export function number(v, min = 0, max = Number.MAX_SAFE_INTEGER) {
+  assert(Number.isFinite(v) && v >= min && v <= max, 'invalid number');
+  return v;
+}
+export function integer(v, min = 0, max = Number.MAX_SAFE_INTEGER) {
+  number(v, min, max);
+  assert(Number.isSafeInteger(v), 'invalid integer');
+  return v;
+}
+export function one(v, values) {
+  assert(values.includes(v), `unsupported value ${v}`);
+  return v;
+}
+export function hash(v) {
+  assert(typeof v === 'string' && /^[a-f0-9]{64}$/.test(v), 'invalid sha256');
+  return v;
+}
+export function uuid(v) {
+  assert(
+    typeof v === 'string' &&
+      /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(v),
+    'invalid uuid',
+  );
+  return v;
+}
+export const digest = (v) =>
+  crypto
+    .createHash('sha256')
+    .update(typeof v === 'string' || Buffer.isBuffer(v) ? v : canonical(v))
+    .digest('hex');
+export function canonical(v) {
+  if (v === null || typeof v === 'string' || typeof v === 'boolean') return JSON.stringify(v);
+  if (typeof v === 'number') {
+    assert(Number.isFinite(v), 'nonfinite number');
+    return JSON.stringify(v);
+  }
+  if (Array.isArray(v)) return `[${v.map(canonical).join(',')}]`;
+  assert(v && typeof v === 'object', 'unsupported JSON value');
+  return `{${Object.keys(v)
+    .sort()
+    .map((k) => `${JSON.stringify(k)}:${canonical(v[k])}`)
+    .join(',')}}`;
+}
+// Scan keys before JSON.parse so duplicate-key intent cannot disappear at the boundary.
+export function parse(text) {
+  assert(Buffer.byteLength(text) <= 16 * 1024 * 1024, 'JSON too large');
+  let i = 0;
+  const ws = () => {
+    while (/\s/.test(text[i] ?? '') && i < text.length) i++;
+  };
+  function str() {
+    const start = i++;
+    while (i < text.length) {
+      if (text[i] === '\\') i += 2;
+      else if (text[i++] === '"') return JSON.parse(text.slice(start, i));
+    }
+    fail('invalid JSON string');
+  }
+  function value() {
+    ws();
+    if (text[i] === '{') {
+      i++;
+      ws();
+      const keys = new Set();
+      if (text[i] === '}') {
+        i++;
+        return;
+      }
+      while (i < text.length) {
+        assert(text[i] === '"', 'invalid JSON key');
+        const k = str();
+        assert(!keys.has(k), `duplicate JSON key ${k}`);
+        keys.add(k);
+        ws();
+        assert(text[i++] === ':', 'invalid JSON');
+        value();
+        ws();
+        const c = text[i++];
+        if (c === '}') return;
+        assert(c === ',', 'invalid JSON');
+        ws();
+      }
+    } else if (text[i] === '[') {
+      i++;
+      ws();
+      if (text[i] === ']') {
+        i++;
+        return;
+      }
+      while (i < text.length) {
+        value();
+        ws();
+        const c = text[i++];
+        if (c === ']') return;
+        assert(c === ',', 'invalid JSON');
+      }
+    } else if (text[i] === '"') str();
+    else {
+      const start = i;
+      while (i < text.length && !/[\s,\]}]/.test(text[i])) i++;
+      assert(i > start, 'invalid JSON');
+      JSON.parse(text.slice(start, i));
+    }
+  }
+  value();
+  ws();
+  assert(i === text.length, 'trailing JSON');
+  return JSON.parse(text);
+}
+export function safePath(p, { existing = true, directory = false } = {}) {
+  assert(path.isAbsolute(p) && path.normalize(p) === p, 'absolute canonical path required');
+  let current = path.parse(p).root;
+  for (const segment of p.slice(current.length).split(path.sep).filter(Boolean)) {
+    current = path.join(current, segment);
+    if (!fs.existsSync(current)) {
+      assert(!existing, 'missing path');
+      continue;
+    }
+    const s = fs.lstatSync(current);
+    assert(!s.isSymbolicLink(), 'symlink forbidden');
+  }
+  if (existing) {
+    assert(fs.realpathSync(p) === p, 'path alias forbidden');
+    const s = fs.statSync(p);
+    assert(directory ? s.isDirectory() : s.isFile(), 'wrong path type');
+  }
+  return p;
+}
+export function readJSON(p) {
+  safePath(path.resolve(p));
+  return parse(fs.readFileSync(p, 'utf8'));
+}
+export function writePrivate(p, v, exclusive = true) {
+  const fd = fs.openSync(p, exclusive ? 'wx' : 'w', 0o600);
+  try {
+    fs.writeFileSync(fd, typeof v === 'string' ? v : `${canonical(v)}\n`);
+    fs.fsyncSync(fd);
+  } finally {
+    fs.closeSync(fd);
+  }
+}
+export function append(p, v) {
+  const fd = fs.openSync(
+    p,
+    fs.constants.O_WRONLY | fs.constants.O_APPEND | fs.constants.O_NOFOLLOW,
+  );
+  try {
+    fs.writeSync(fd, `${canonical(v)}\n`);
+    fs.fsyncSync(fd);
+  } finally {
+    fs.closeSync(fd);
+  }
+}
+export function syncDir(p) {
+  const fd = fs.openSync(p, 'r');
+  try {
+    fs.fsyncSync(fd);
+  } finally {
+    fs.closeSync(fd);
+  }
+}
+export function jsonl(p) {
+  const s = fs.readFileSync(p, 'utf8');
+  assert(!s || s.endsWith('\n'), 'truncated journal');
+  return s.split('\n').filter(Boolean).map(parse);
+}
+export function args(argv) {
+  const out = { _: [] };
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i];
+    if (!a.startsWith('--')) {
+      out._.push(a);
+      continue;
+    }
+    assert(!Object.hasOwn(out, a.slice(2)), 'duplicate argument');
+    out[a.slice(2)] = argv[i + 1]?.startsWith('--') || !argv[i + 1] ? true : argv[++i];
+  }
+  return out;
+}
+export const main = (fn) =>
+  fn().catch((error) => {
+    process.stderr.write(`${error.message}\n`);
+    process.exitCode = 1;
+  });
+export function direct(url) {
+  return process.argv[1] && url === new URL(`file://${path.resolve(process.argv[1])}`).href;
+}
+export function rng(seed) {
+  let x = integer(seed, 0, 0xffffffff) || 1;
+  return () => {
+    x ^= x << 13;
+    x ^= x >>> 17;
+    x ^= x << 5;
+    return (x >>> 0) / 4294967296;
+  };
+}
+export function shuffled(items, random) {
+  const a = [...items];
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = Math.floor(random() * (i + 1));
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
diff --git a/scripts/agent-evals/lib/hub-adapter.mjs b/scripts/agent-evals/lib/hub-adapter.mjs
new file mode 100644
index 000000000..52f5fbb65
--- /dev/null
+++ b/scripts/agent-evals/lib/hub-adapter.mjs
@@ -0,0 +1,152 @@
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { createInterface } from 'node:readline';
+import crypto from 'node:crypto';
+import { assert, object, canonical, parse } from './common.mjs';
+import { verifyCheckout } from './manifest.mjs';
+export class HubAdapter {
+  constructor({ root, pin, bounds, onProvider, onDiagnostic = () => {}, unitCommand }) {
+    if (!unitCommand) verifyCheckout(root, pin, true);
+    this.maxBytes = bounds.maxBodyBytes;
+    this.timeout = bounds.maxDurationMs;
+    this.pin = pin;
+    this.pending = new Map();
+    this.seen = new Map();
+    this.onProvider = onProvider;
+    this.failure = null;
+    this.providerTasks = new Set();
+    const command = unitCommand ?? [
+      process.execPath,
+      path.join(root, 'tests/fixtures/critical-journeys/eval-adapter.mjs'),
+      '--stdio',
+    ];
+    this.child = spawn(command[0], command.slice(1), {
+      cwd: root,
+      env: {
+        PATH: process.env.PATH,
+        HOME: process.env.HOME,
+        LANG: 'C.UTF-8',
+        MINION_EVAL_FIXTURE: '1',
+      },
+      stdio: ['pipe', 'pipe', 'pipe'],
+    });
+    this.child.stdout.on('data', (chunk) => {
+      this.currentBytes = (this.currentBytes ?? 0) + chunk.length;
+      if (this.currentBytes > 64 * 1024 * 1024) this.abort(new Error('adapter output overflow'));
+      let start = 0;
+      for (let index = 0; index < chunk.length; index++)
+        if (chunk[index] === 10) {
+          this.lineBytes = (this.lineBytes ?? 0) + index - start;
+          if (this.lineBytes > this.maxBytes) this.abort(new Error('adapter frame overflow'));
+          this.lineBytes = 0;
+          start = index + 1;
+        }
+      this.lineBytes = (this.lineBytes ?? 0) + chunk.length - start;
+      if (this.lineBytes > this.maxBytes) this.abort(new Error('adapter frame overflow'));
+    });
+    this.child.stdin.on('error', (error) => this.abort(error));
+    createInterface({ input: this.child.stdout, crlfDelay: Infinity }).on('line', (line) => {
+      try {
+        assert(Buffer.byteLength(line) <= this.maxBytes, 'adapter line too large');
+        const msg = parse(line);
+        object(msg, ['version', 'id', 'type', 'payload']);
+        assert(msg.version === 1 && typeof msg.id === 'string', 'adapter protocol');
+        if (this.seen.has(msg.id)) {
+          assert(this.seen.get(msg.id) === canonical(msg), 'conflicting duplicate adapter reply');
+          return;
+        }
+        this.seen.set(msg.id, canonical(msg));
+        if (msg.type === 'provider_request') {
+          assert(this.helloDone, 'provider before handshake');
+          const task = this.handleProvider(msg).catch((e) => this.abort(e));
+          this.providerTasks.add(task);
+          task.finally(() => this.providerTasks.delete(task));
+        } else {
+          assert(['result', 'error'].includes(msg.type), 'unexpected adapter type');
+          const p = this.pending.get(msg.id);
+          assert(p, 'uncorrelated adapter reply');
+          this.pending.delete(msg.id);
+          clearTimeout(p.timer);
+          if (msg.type === 'error') p.reject(new Error(`adapter error: ${canonical(msg.payload)}`));
+          else p.resolve(msg.payload);
+        }
+      } catch (e) {
+        this.abort(e);
+      }
+    });
+    this.child.stderr.on('data', (c) => onDiagnostic(c.toString().slice(0, 4096)));
+    this.child.once('error', (e) => this.abort(e));
+    this.child.once('exit', (code, signal) => {
+      if (!this.closing) this.abort(new Error(`adapter exited ${code ?? signal}`));
+    });
+  }
+  abort(e) {
+    this.failure ??= e;
+    for (const p of this.pending.values()) {
+      clearTimeout(p.timer);
+      p.reject(e);
+    }
+    this.pending.clear();
+    this.child.kill('SIGTERM');
+  }
+  async handleProvider(msg) {
+    const result = await this.onProvider(msg.payload);
+    await this.send('provider_result', { requestId: msg.payload.requestId, ...result });
+  }
+  send(type, payload) {
+    if (this.failure) return Promise.reject(this.failure);
+    const id = crypto.randomUUID();
+    const message = canonical({ version: 1, id, type, payload });
+    assert(Buffer.byteLength(message) <= this.maxBytes, 'command too large');
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        reject(new Error(`adapter ${type} deadline`));
+        this.abort(new Error('adapter timeout'));
+      }, this.timeout);
+      this.pending.set(id, { resolve, reject, timer });
+      this.child.stdin.write(`${message}\n`);
+    });
+  }
+  async hello() {
+    const result = await this.send('hello', {
+      protocol: 'minion-agent-eval-fixture/v1',
+      lockHash: this.pin.lockSha256,
+      adapterHash: this.pin.adapterSha256,
+    });
+    return this.adoptHello(result);
+  }
+  adoptHello(result) {
+    assert(
+      result.protocol === 'minion-agent-eval-fixture/v1' && result.disposable === true,
+      'unqualified adapter',
+    );
+    assert(
+      result.sourceSha === this.pin.commit &&
+        result.lockHash === this.pin.lockSha256 &&
+        result.adapterHash === this.pin.adapterSha256 &&
+        result.sourceHash === this.pin.sourceSha256 &&
+        result.buildHash === this.pin.buildSha256,
+      'adapter provenance drift',
+    );
+    this.helloDone = true;
+    return result;
+  }
+  async drain() {
+    await Promise.all([...this.providerTasks]);
+    if (this.failure) throw this.failure;
+  }
+  async close() {
+    if (this.closed) return;
+    this.closed = true;
+    this.closing = true;
+    try {
+      if (!this.failure) await this.send('close', {});
+    } finally {
+      this.child.stdin.end();
+      this.child.kill('SIGTERM');
+      for (const p of this.pending.values()) clearTimeout(p.timer);
+      this.pending.clear();
+    }
+  }
+}
diff --git a/scripts/agent-evals/lib/live-provider.mjs b/scripts/agent-evals/lib/live-provider.mjs
new file mode 100644
index 000000000..510291ad3
--- /dev/null
+++ b/scripts/agent-evals/lib/live-provider.mjs
@@ -0,0 +1,264 @@
+import { assert, object, canonical, digest, integer, parse } from './common.mjs';
+export const ENDPOINTS = Object.freeze({
+  main: 'https://openrouter.ai/api/v1/chat/completions',
+  classifier: 'https://openrouter.ai/api/alpha/decisions',
+});
+export function shapeRequest(request, manifest) {
+  assert(request.kind === 'main' || request.kind === 'classifier', 'provider request kind');
+  const p = manifest.provenance.provider,
+    b = manifest.bounds;
+  assert(
+    p.profile === 'openrouter-v1' && p.boundPolicy === 'utf8-bytes-v1',
+    'unsupported provider policy',
+  );
+  const model =
+    request.kind === 'classifier'
+      ? manifest.provenance.model.classifier
+      : manifest.provenance.model;
+  assert(model && request.model === model.requested, 'requested model drift');
+  assert(
+    typeof request.boundDescriptor === 'string' && request.boundDescriptor.length > 0,
+    'missing bound descriptor',
+  );
+  let body;
+  if (request.kind === 'main') {
+    assert(request.boundDescriptor === p.boundPolicy, 'unsupported main bound descriptor');
+    assert(
+      Array.isArray(request.messages) && request.messages.length,
+      'actual provider messages required',
+    );
+    for (const m of request.messages) {
+      object(m, ['role', 'content']);
+      assert(
+        ['system', 'user', 'assistant', 'tool'].includes(m.role) && typeof m.content === 'string',
+        'unsupported message',
+      );
+    }
+    body = {
+      model: model.requested,
+      messages: request.messages,
+      max_tokens: b.maxOutputTokens,
+      stream: false,
+      provider: { allow_fallbacks: false, require_parameters: true },
+    };
+  } else {
+    assert(request.state && request.questions, 'actual classifier state/questions required');
+    assert(request.boundDescriptor === 'decisions/v1', 'unsupported classifier bound');
+    body = {
+      model: model.requested,
+      state: request.state,
+      questions: request.questions,
+      max_tokens: b.maxOutputTokens,
+      provider: { allow_fallbacks: false, require_parameters: true },
+    };
+  }
+  const serialized = canonical(body),
+    bytes = Buffer.byteLength(serialized);
+  assert(bytes <= b.maxRequestBytes, 'request byte bound exceeded');
+  assert(b.maxOutputTokens > 0, 'output bound');
+  // Versioned conservative policy: every serialized UTF-8 byte may consume one input token.
+  // Provider fixed overhead is included explicitly rather than estimated from historical usage.
+  const inputUpper = bytes + 1024,
+    upperMicroUsd = Math.ceil(
+      inputUpper * p.prices.inputMicroUsdPerToken +
+        b.maxOutputTokens * p.prices.outputMicroUsdPerToken,
+    );
+  integer(upperMicroUsd, 1);
+  assert(upperMicroUsd <= b.perCallMicroUsd, 'per-call exposure bound exceeded');
+  return {
+    url: ENDPOINTS[request.kind],
+    serialized,
+    upperMicroUsd,
+    model,
+    inputUpper,
+    requestSha256: digest(serialized),
+  };
+}
+export async function liveProvider({
+  request,
+  manifest,
+  credential,
+  budget,
+  scope,
+  alias,
+  attemptId,
+  runId,
+  signal,
+  onReceipt,
+  fetcher = globalThis.fetch,
+}) {
+  assert(
+    typeof credential === 'string' && credential.length >= 4 && !/[\r\n]/.test(credential),
+    'explicit provider credential required',
+  );
+  const shaped = shapeRequest(request, manifest);
+  budget.reserve({
+    scope,
+    alias,
+    attemptId,
+    runId,
+    upperMicroUsd: shaped.upperMicroUsd,
+    bounds: manifest.bounds,
+    binding: {
+      requestSha256: shaped.requestSha256,
+      model: shaped.model.requested,
+      profile: manifest.provenance.provider.revision,
+    },
+  });
+  let received = false;
+  const timeout = AbortSignal.timeout(manifest.bounds.maxDurationMs);
+  const combined = signal ? AbortSignal.any([timeout, signal]) : timeout;
+  try {
+    assert(!combined.aborted, 'canceled before transport entry');
+    budget.validate();
+    budget.dispatched(scope, attemptId);
+    // One fetch, redirects rejected. No SDK retries/fallback or application replay.
+    const response = await fetcher(shaped.url, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${credential}`, 'Content-Type': 'application/json' },
+      body: shaped.serialized,
+      redirect: 'error',
+      signal: combined,
+    });
+    assert(response.url === '' || response.url === shaped.url, 'provider redirect');
+    let total = 0;
+    const buffers = [];
+    assert(response.body, 'missing response body');
+    const reader = response.body.getReader();
+    try {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        total += value.byteLength;
+        assert(total <= manifest.bounds.maxBodyBytes, 'provider response body exceeded bound');
+        buffers.push(Buffer.from(value));
+      }
+    } finally {
+      if (total > manifest.bounds.maxBodyBytes) await reader.cancel();
+      reader.releaseLock();
+    }
+    const raw = Buffer.concat(buffers).toString('utf8');
+    let result = null;
+    try {
+      result = parse(raw);
+    } catch {
+      /* Persist malformed bounded reply and unknown billing before validation. */
+    }
+    const usage = result?.usage;
+    const cost = usage?.cost;
+    const costKnown = typeof cost === 'number' && Number.isFinite(cost) && cost >= 0;
+    const resolved = typeof result?.model === 'string' ? result.model : null;
+    const costMicroUsd = costKnown ? Math.ceil(cost * 1e6) : null;
+    const receipt = {
+      costStatus: costKnown ? 'known' : 'unknown',
+      costMicroUsd,
+      billingComplete: costKnown,
+      responseSha256: digest(raw),
+      resolvedModel: resolved,
+    };
+    // Raw received evidence must be durable before interpretation/settlement. The callback writes/fsyncs the run receipt.
+    await onReceipt({
+      kind: 'provider_received',
+      attemptId,
+      requestSha256: shaped.requestSha256,
+      raw,
+      result,
+      usage: usage ?? null,
+      exactCostUsd: costKnown ? cost : null,
+      ...receipt,
+    });
+    budget.received(scope, attemptId, receipt);
+    received = true;
+    if (costKnown) budget.settle(scope, attemptId);
+    else {
+      budget.unknown(scope, attemptId, 'missing_complete_bill');
+      throw new Error('unknown provider billing');
+    }
+    assert(response.ok, 'provider HTTP failure; known charge retained');
+    assert(result && resolved && shaped.model.resolved.includes(resolved), 'resolved model drift');
+    const outputTokens = usage?.completion_tokens ?? usage?.output_tokens;
+    assert(
+      Number.isSafeInteger(outputTokens) &&
+        outputTokens >= 0 &&
+        outputTokens <= manifest.bounds.maxOutputTokens,
+      'invalid output usage bound',
+    );
+    const inputTokens = usage?.prompt_tokens ?? usage?.input_tokens;
+    assert(
+      Number.isSafeInteger(inputTokens) && inputTokens >= 0 && inputTokens <= shaped.inputUpper,
+      'invalid input usage bound',
+    );
+    if (request.kind === 'main')
+      assert(
+        typeof result.choices?.[0]?.message?.content === 'string',
+        'malformed provider main result',
+      );
+    else assert(result.answers && typeof result.answers === 'object', 'malformed decisions result');
+    return {
+      result,
+      requestedModel: shaped.model.requested,
+      resolvedModel: resolved,
+      usage: { inputTokens, outputTokens, costUsd: cost, costStatus: 'known' },
+      upperMicroUsd: shaped.upperMicroUsd,
+    };
+  } catch (error) {
+    const state = budget.status(scope).attempts.get(attemptId)?.state;
+    if (['reserved', 'dispatched', 'received'].includes(state))
+      budget.unknown(
+        scope,
+        attemptId,
+        received
+          ? 'received_unsettled'
+          : combined.aborted
+            ? 'canceled_or_timeout'
+            : 'transport_or_partial_body',
+      );
+    await onReceipt({
+      kind: 'provider_terminal',
+      attemptId,
+      status: state === 'settled' ? 'known_failure' : 'indeterminate',
+      reason: error.message,
+    });
+    throw error;
+  }
+}
+export async function fixtureProvider({ request, episode, index = 0 }) {
+  const sequence = episode.providerFixture?.[request.kind];
+  if (sequence) assert(index < sequence.length, 'provider fixture sequence exhausted');
+  const entry = sequence?.[index];
+  const result =
+    entry ??
+    (request.kind === 'classifier'
+      ? {
+          model: request.model,
+          answers: {
+            mode: { choice: 'chat', probabilities: { chat: 1 } },
+            pages: { noul: 0 },
+            forms: { noul: 0 },
+            data: { noul: 0 },
+            brain: { noul: 0 },
+            changelog: { noul: 0 },
+            sandbox: { noul: 0 },
+          },
+          usage: { input_tokens: 1, output_tokens: 1, cost: 0 },
+        }
+      : {
+          model: request.model,
+          choices: [
+            {
+              message: {
+                role: 'assistant',
+                content: episode.terminal.expectedText ?? 'synthetic fixture response',
+              },
+            },
+          ],
+          usage: { prompt_tokens: 1, completion_tokens: 1, cost: 0 },
+        });
+  return {
+    result,
+    requestedModel: request.model,
+    resolvedModel: request.model,
+    usage: { inputTokens: 1, outputTokens: 1, costUsd: 0, costStatus: 'known' },
+    upperMicroUsd: 0,
+  };
+}
