+import crypto from 'node:crypto';
+import readline from 'node:readline';
+import { execFileSync } from 'node:child_process';
+const h = (v) => crypto.createHash('sha256').update(v).digest('hex');
+let reset,
+  pending,
+  answer = '';
+const send = (id, payload) =>
+  console.log(JSON.stringify({ version: 1, id, type: 'result', payload }));
+readline.createInterface({ input: process.stdin }).on('line', (line) => {
+  const m = JSON.parse(line),
+    p = m.payload;
+  if (m.type === 'hello')
+    send(m.id, {
+      protocol: 'minion-agent-eval-fixture/v1',
+      sourceSha: execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(),
+      lockHash: h(fs.readFileSync('bun.lock')),
+      adapterHash: h(fs.readFileSync(import.meta.filename)),
+      buildHash: 'b'.repeat(64),
+      sourceHash: 'a'.repeat(64),
+      disposable: true,
+      features: ['unit_only'],
+      evidenceRoot: '/synthetic-unit-only',
+    });
+  else if (m.type === 'reset') {
+    reset = p;
+    pending = null;
+    answer = '';
+    send(m.id, {
+      initialStateHash: h(
+        JSON.stringify({ fixture: p.initialState, seed: p.seed, persona: p.persona }),
+      ),
+      episodeId: p.episodeId,
+      arm: p.arm,
+    });
+  } else if (m.type === 'turn') {
+    send(m.id, { submittedIntent: true });
+    pending = crypto.randomUUID();
+    console.log(
+      JSON.stringify({
+        version: 1,
+        id: pending,
+        type: 'provider_request',
+        payload: {
+          requestId: pending,
+          kind: 'main',
+          model: reset.model.requestedModel,
+          boundDescriptor: reset.model.boundDescriptor,
+          messages: [{ role: 'user', content: p.text }],
+        },
+      }),
+    );
+  } else if (m.type === 'provider_result') {
+    answer = p.result?.choices?.[0]?.message?.content ?? p.result?.text ?? '';
+    pending = null;
+    send(m.id, { received: true });
+  } else if (m.type === 'collect')
+    send(m.id, {
+      episodeId: reset.episodeId,
+      arm: reset.arm,
+      observations: [],
+      receipts: [],
+      answerTexts: [answer],
+      finalStateHash: h('state'),
+      network: { externalRequests: 0, boundary: 'synthetic-unit-only' },
+      identity: { disposable: true },
+      inference: [],
+      pendingProviders: pending ? 1 : 0,
+      pendingReloads: 0,
+      incomplete: !!pending,
+    });
+  else if (m.type === 'close') {
+    send(m.id, { closed: true });
+    process.exit(0);
+  } else send(m.id, {});
+});
diff --git a/scripts/agent-evals/lib/approval.mjs b/scripts/agent-evals/lib/approval.mjs
new file mode 100644
index 000000000..0f16ed43a
--- /dev/null
+++ b/scripts/agent-evals/lib/approval.mjs
@@ -0,0 +1,170 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import {
+  assert,
+  object,
+  string,
+  hash,
+  uuid,
+  safePath,
+  readJSON,
+  canonical,
+  digest,
+  integer,
+} from './common.mjs';
+function outsideRunTree(file) {
+  for (
+    let parent = path.dirname(file);
+    parent !== path.dirname(parent);
+    parent = path.dirname(parent)
+  )
+    assert(
+      !fs.existsSync(path.join(parent, 'result.json')) &&
+        !fs.existsSync(path.join(parent, 'active-writer.json')) &&
+        !(
+          fs.existsSync(path.join(parent, 'manifest.json')) &&
+          fs.existsSync(path.join(parent, 'events.jsonl'))
+        ),
+      'trusted authority must be outside generated run trees',
+    );
+}
+export function validateConfig(c) {
+  object(c, [
+    'version',
+    'ownerRef',
+    'keySha256',
+    'accountingRegistryId',
+    'root',
+    'metadataPath',
+    'journalPath',
+    'genesisSha256',
+    'identities',
+    'scopes',
+  ]);
+  assert(c.version === 1, 'operator config version');
+  string(c.ownerRef);
+  hash(c.keySha256);
+  uuid(c.accountingRegistryId);
+  for (const k of ['root', 'metadataPath', 'journalPath'])
+    safePath(c[k], { directory: k === 'root' });
+  hash(c.genesisSha256);
+  assert(
+    c.metadataPath === `${c.root}/registry.json` && c.journalPath === `${c.root}/budget.jsonl`,
+    'fixed canonical registry files',
+  );
+  object(c.identities, ['root', 'metadata', 'journal']);
+  for (const identity of Object.values(c.identities)) {
+    object(identity, ['dev', 'ino']);
+    integer(identity.dev);
+    integer(identity.ino, 1);
+  }
+  assert(Array.isArray(c.scopes) && c.scopes.length, 'configured scopes');
+  const ids = new Set();
+  for (const s of c.scopes) {
+    object(s, ['accountingScopeId', 'ownerRef', 'purpose']);
+    uuid(s.accountingScopeId);
+    string(s.ownerRef);
+    string(s.purpose);
+    assert(s.ownerRef === c.ownerRef && !ids.has(s.accountingScopeId), 'scope authority');
+    ids.add(s.accountingScopeId);
+  }
+  return c;
+}
+export function loadConfig(p) {
+  safePath(p);
+  outsideRunTree(p);
+  return validateConfig(readJSON(p));
+}
+export function verifyApproval({
+  manifest,
+  manifestSha256,
+  approvalPath,
+  configPath,
+  keyPath,
+  ownerRef,
+  now = Date.now(),
+}) {
+  const config = loadConfig(configPath);
+  safePath(keyPath);
+  outsideRunTree(keyPath);
+  safePath(approvalPath);
+  assert(
+    ownerRef === config.ownerRef && ownerRef === manifest.operatorRef,
+    'trusted owner mismatch',
+  );
+  const key = fs.readFileSync(keyPath);
+  const publicKey = crypto.createPublicKey(key);
+  assert(publicKey.asymmetricKeyType === 'ed25519', 'Ed25519 required');
+  assert(
+    digest(publicKey.export({ type: 'spki', format: 'der' })) === config.keySha256,
+    'trusted key mismatch',
+  );
+  const approval = readJSON(approvalPath);
+  object(approval, ['algorithm', 'payload', 'signature']);
+  assert(approval.algorithm === 'Ed25519', 'approval algorithm');
+  const p = approval.payload;
+  object(p, [
+    'version',
+    'manifestSha256',
+    'approvalRef',
+    'ownerRef',
+    'issuedAt',
+    'expiresAt',
+    'permittedMode',
+    'scopeHash',
+    'budgetHash',
+    'approvalNamespace',
+    'accountingRegistryId',
+    'accountingScopeId',
+    'trustedOperatorConfigSha256',
+  ]);
+  assert(p.version === 1 && p.permittedMode === 'live', 'approval mode');
+  hash(p.manifestSha256);
+  hash(p.scopeHash);
+  hash(p.budgetHash);
+  hash(p.trustedOperatorConfigSha256);
+  string(p.approvalNamespace);
+  const issued = Date.parse(p.issuedAt),
+    expires = Date.parse(p.expiresAt);
+  assert(
+    Number.isFinite(issued) &&
+      Number.isFinite(expires) &&
+      issued <= now &&
+      now < expires &&
+      expires > issued,
+    'expired or future approval',
+  );
+  assert(
+    p.manifestSha256 === manifestSha256 &&
+      p.approvalRef === manifest.approvalRef &&
+      p.ownerRef === ownerRef,
+    'approval manifest binding',
+  );
+  assert(
+    p.scopeHash === digest(manifest.scope) && p.budgetHash === digest(manifest.bounds),
+    'approval scope/budget binding',
+  );
+  for (const k of ['accountingRegistryId', 'accountingScopeId', 'trustedOperatorConfigSha256'])
+    assert(p[k] === manifest.accounting[k], 'approval accounting binding');
+  assert(
+    p.accountingRegistryId === config.accountingRegistryId &&
+      p.trustedOperatorConfigSha256 === digest(config),
+    'trusted config binding',
+  );
+  const scope = config.scopes.find((s) => s.accountingScopeId === p.accountingScopeId);
+  assert(
+    scope && scope.ownerRef === ownerRef && scope.purpose === manifest.purpose,
+    'unconfigured scope authority',
+  );
+  assert(
+    typeof approval.signature === 'string' && /^[A-Za-z0-9+/]+={0,2}$/.test(approval.signature),
+    'invalid signature encoding',
+  );
+  const signature = Buffer.from(approval.signature, 'base64');
+  assert(
+    signature.length === 64 && crypto.verify(null, Buffer.from(canonical(p)), publicKey, signature),
+    'invalid detached approval signature',
+  );
+  return { config, approval, payload: p, approvalSha256: digest(approval) };
+}
diff --git a/scripts/agent-evals/lib/approval.test.mjs b/scripts/agent-evals/lib/approval.test.mjs
new file mode 100644
index 000000000..3f894207a
--- /dev/null
+++ b/scripts/agent-evals/lib/approval.test.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { liveSetup } from '../fixtures/helpers.mjs';
+import { verifyApproval } from './approval.mjs';
+import { readJSON, writePrivate, digest } from './common.mjs';
+const verify = (s) =>
+  verifyApproval({
+    manifest: s.m,
+    manifestSha256: digest(s.m),
+    approvalPath: s.approvalPath,
+    configPath: s.configPath,
+    keyPath: s.keyPath,
+    ownerRef: 'test-owner',
+  });
+test('detached test attestation binds exact manifest, owner/key, trusted config, registry/scope', () => {
+  const s = liveSetup();
+  assert.equal(verify(s).payload.approvalRef, 'test-only-approval');
+});
+test('self approved/expired/wrong owner/tamper/config/self-key/circular manifest all reject', () => {
+  for (const mutate of [
+    (s) => {
+      s.m.approved = true;
+    },
+    (s) => {
+      const a = readJSON(s.approvalPath);
+      a.payload.expiresAt = '2020-01-01T00:00:00Z';
+      writePrivate(s.approvalPath, a, false);
+    },
+    (s) => (s.m.operatorRef = 'wrong'),
+    (s) => s.m.bounds.dayMicroUsd++,
+    (s) => {
+      const c = readJSON(s.configPath);
+      c.ownerRef = 'other';
+      writePrivate(s.configPath, c, false);
+    },
+    (s) => {
+      const p = crypto.generateKeyPairSync('ed25519');
+      writePrivate(s.keyPath, p.publicKey.export({ type: 'spki', format: 'pem' }), false);
+    },
+    (s) => (s.m.approvalSha256 = digest(readJSON(s.approvalPath))),
+  ]) {
+    const s = liveSetup();
+    mutate(s);
+    assert.throws(() => verify(s));
+  }
+});
+
+test('trusted config/public key in a previous generated run never supplies operational authority', () => {
+  const s = liveSetup();
+  const old = path.join(s.root, 'old-run');
+  fs.mkdirSync(old, { mode: 0o700 });
+  writePrivate(path.join(old, 'manifest.json'), {});
+  writePrivate(path.join(old, 'events.jsonl'), '');
+  for (const kind of ['config', 'key']) {
+    const copy = path.join(old, kind);
+    fs.copyFileSync(kind === 'config' ? s.configPath : s.keyPath, copy);
+    assert.throws(
+      () =>
+        verifyApproval({
+          manifest: s.m,
+          manifestSha256: digest(s.m),
+          approvalPath: s.approvalPath,
+          configPath: kind === 'config' ? copy : s.configPath,
+          keyPath: kind === 'key' ? copy : s.keyPath,
+          ownerRef: 'test-owner',
+        }),
+      /outside generated run/,
+    );
+  }
+});
diff --git a/scripts/agent-evals/lib/budget.mjs b/scripts/agent-evals/lib/budget.mjs
new file mode 100644
index 000000000..3d21129d9
--- /dev/null
+++ b/scripts/agent-evals/lib/budget.mjs
@@ -0,0 +1,351 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import {
+  assert,
+  object,
+  uuid,
+  string,
+  integer,
+  digest,
+  canonical,
+  safePath,
+  writePrivate,
+  syncDir,
+  jsonl,
+} from './common.mjs';
+export const identity = (s) => ({ dev: s.dev, ino: s.ino });
+const equalIdentity = (actual, expected) =>
+  actual.dev === expected.dev && actual.ino === expected.ino;
+export function initializeRegistry({ root, registryId, scopeId, ownerRef, purpose }) {
+  for (
+    let ancestor = path.dirname(root);
+    ancestor !== path.dirname(ancestor);
+    ancestor = path.dirname(ancestor)
+  )
+    assert(
+      !['result.json', 'active-writer.json', 'events.jsonl'].some((f) =>
+        fs.existsSync(path.join(ancestor, f)),
+      ),
+      'registry cannot initialize inside generated run outputs',
+    );
+  safePath(root, { existing: false, directory: true });
+  assert(!fs.existsSync(root), 'registry already exists');
+  assert(!root.split(path.sep).includes('runs'), 'registry must be outside generated runs');
+  uuid(registryId);
+  uuid(scopeId);
+  string(ownerRef);
+  string(purpose);
+  safePath(path.dirname(root), { directory: true });
+  fs.mkdirSync(root, { mode: 0o700 });
+  const metadata = {
+    version: 1,
+    accountingRegistryId: registryId,
+    scopes: [{ accountingScopeId: scopeId, ownerRef, purpose }],
+    nonce: crypto.randomUUID(),
+  };
+  const genesis = {
+    version: 1,
+    sequence: 0,
+    kind: 'genesis',
+    previous: null,
+    metadataSha256: digest(metadata),
+  };
+  const metadataPath = path.join(root, 'registry.json'),
+    journalPath = path.join(root, 'budget.jsonl');
+  writePrivate(metadataPath, metadata);
+  writePrivate(journalPath, `${canonical(genesis)}\n`);
+  syncDir(root);
+  syncDir(path.dirname(root));
+  return {
+    version: 1,
+    accountingRegistryId: registryId,
+    root,
+    metadataPath,
+    journalPath,
+    genesisSha256: digest(genesis),
+    identities: {
+      root: identity(fs.statSync(root)),
+      metadata: identity(fs.statSync(metadataPath)),
+      journal: identity(fs.statSync(journalPath)),
+    },
+    scopes: metadata.scopes,
+  };
+}
+export function openBudget(config, { journalAssertion } = {}) {
+  if (journalAssertion !== undefined)
+    assert(
+      journalAssertion === config.journalPath,
+      'budget journal is only a canonical path assertion',
+    );
+  const opened = [];
+  let lockFd,
+    lockOwned = false;
+  function validatePaths() {
+    for (const [kind, p] of [
+      ['root', config.root],
+      ['metadata', config.metadataPath],
+      ['journal', config.journalPath],
+    ]) {
+      safePath(p, { directory: kind === 'root' });
+      const s = fs.statSync(p);
+      assert(
+        equalIdentity(identity(s), config.identities[kind]),
+        `registry ${kind} identity replaced`,
+      );
+      assert((s.mode & 0o077) === 0, 'registry permissions must be private');
+    }
+    for (const { fd, kind } of opened)
+      assert(
+        equalIdentity(identity(fs.fstatSync(fd)), config.identities[kind]),
+        'opened registry identity mismatch',
+      );
+  }
+  function release() {
+    for (const { fd } of opened.splice(0)) fs.closeSync(fd);
+    if (lockFd !== undefined) {
+      fs.closeSync(lockFd);
+      lockFd = undefined;
+    }
+    if (lockOwned) {
+      fs.unlinkSync(path.join(config.root, 'writer.lock'));
+      syncDir(config.root);
+      lockOwned = false;
+    }
+  }
+  try {
+    validatePaths();
+    for (const [kind, p, flags] of [
+      ['metadata', config.metadataPath, fs.constants.O_RDONLY],
+      ['journal', config.journalPath, fs.constants.O_RDWR | fs.constants.O_APPEND],
+    ])
+      opened.push({ kind, fd: fs.openSync(p, flags | fs.constants.O_NOFOLLOW) });
+    validatePaths();
+    const meta = JSON.parse(fs.readFileSync(opened.find((x) => x.kind === 'metadata').fd, 'utf8'));
+    assert(
+      meta.version === 1 && meta.accountingRegistryId === config.accountingRegistryId,
+      'registry id mismatch',
+    );
+    assert(
+      canonical(meta.scopes) === canonical(config.scopes),
+      'registry scope authority mismatch',
+    );
+    const lockPath = path.join(config.root, 'writer.lock');
+    lockFd = fs.openSync(lockPath, 'wx', 0o600);
+    lockOwned = true;
+    fs.writeSync(lockFd, canonical({ pid: process.pid, at: new Date().toISOString() }));
+    fs.fsyncSync(lockFd);
+    syncDir(config.root);
+    validatePaths();
+    let entries = jsonl(config.journalPath);
+    assert(
+      entries.length &&
+        digest(entries[0]) === config.genesisSha256 &&
+        entries[0].metadataSha256 === digest(meta),
+      'registry genesis mismatch',
+    );
+    for (let i = 1; i < entries.length; i++) {
+      const e = entries[i];
+      assert(
+        e.sequence === i && e.previous === digest(entries[i - 1]) && e.version === 1,
+        'journal corruption',
+      );
+      assert(
+        ['alias', 'reserved', 'dispatched', 'received', 'settled', 'unknown', 'retired'].includes(
+          e.kind,
+        ),
+        'unknown journal record',
+      );
+    }
+    const journalFd = opened.find((x) => x.kind === 'journal').fd;
+    function push(data) {
+      validatePaths();
+      const entry = {
+        version: 1,
+        sequence: entries.length,
+        previous: digest(entries.at(-1)),
+        at: new Date().toISOString(),
+        ...data,
+      };
+      fs.writeSync(journalFd, `${canonical(entry)}\n`);
+      fs.fsyncSync(journalFd);
+      entries.push(entry);
+      return entry;
+    }
+    function attempts(scope) {
+      const map = new Map();
+      for (const e of entries.filter((x) => x.scope === scope && x.attemptId)) {
+        if (e.kind === 'reserved') {
+          assert(!map.has(e.attemptId), 'duplicate reservation');
+          map.set(e.attemptId, { reservation: e, state: e.kind, received: null, settled: null });
+        } else {
+          const a = map.get(e.attemptId);
+          assert(a, 'orphan attempt');
+          if (e.kind === 'dispatched')
+            assert(a.state === 'reserved', 'invalid dispatch transition');
+          if (e.kind === 'received') {
+            assert(a.state === 'dispatched', 'invalid receive transition');
+            a.received = e;
+          }
+          if (e.kind === 'settled') {
+            assert(a.state === 'received' && !a.settled, 'duplicate settlement');
+            assert(
+              e.costMicroUsd === a.received.costMicroUsd &&
+                Number.isSafeInteger(e.costMicroUsd) &&
+                e.costMicroUsd >= 0,
+              'invalid settled bill',
+            );
+            a.settled = e;
+          }
+          if (e.kind === 'unknown')
+            assert(
+              ['reserved', 'dispatched', 'received'].includes(a.state),
+              'invalid unknown transition',
+            );
+          a.state = e.kind;
+        }
+      }
+      return map;
+    }
+    // A persisted known response can settle locally. Missing response is fenced forever.
+    for (const scope of config.scopes)
+      for (const [id, a] of attempts(scope.accountingScopeId))
+        if (
+          a.state === 'received' &&
+          a.received.costStatus === 'known' &&
+          a.received.billingComplete === true
+        )
+          push({
+            kind: 'settled',
+            scope: scope.accountingScopeId,
+            attemptId: id,
+            costMicroUsd: a.received.costMicroUsd,
+            recovered: true,
+          });
+    function status(scope) {
+      const map = attempts(scope);
+      return {
+        attempts: map,
+        retired: entries.some((e) => e.scope === scope && e.kind === 'retired'),
+        unknown: [...map.values()].some((a) => a.state !== 'settled'),
+        overshoot: [...map.values()].some(
+          (a) => a.settled && a.settled.costMicroUsd > a.reservation.upperMicroUsd,
+        ),
+      };
+    }
+    return {
+      get entries() {
+        return [...entries];
+      },
+      validate: validatePaths,
+      close: release,
+      reserve({
+        scope,
+        alias,
+        attemptId,
+        runId,
+        upperMicroUsd,
+        bounds,
+        day = new Date().toISOString().slice(0, 10),
+        binding,
+      }) {
+        uuid(attemptId);
+        uuid(runId);
+        integer(upperMicroUsd, 1);
+        assert(
+          config.scopes.some((s) => s.accountingScopeId === scope),
+          'unknown scope',
+        );
+        string(alias);
+        const s = status(scope);
+        assert(!s.retired, 'scope permanently retired');
+        assert(!s.unknown, 'unknown exposure fence');
+        assert(!s.overshoot, 'billing overshoot fence');
+        assert(!s.attempts.has(attemptId), 'attempt already admitted');
+        const rows = [...s.attempts.values()];
+        const cost = (a) => (a.settled ? a.settled.costMicroUsd : a.reservation.upperMicroUsd);
+        const runTotal = rows
+            .filter((a) => a.reservation.runId === runId)
+            .reduce((v, a) => v + cost(a), 0),
+          dayTotal = rows.filter((a) => a.reservation.day === day).reduce((v, a) => v + cost(a), 0);
+        assert(
+          upperMicroUsd <= bounds.perCallMicroUsd &&
+            runTotal + upperMicroUsd <= bounds.runMicroUsd &&
+            dayTotal + upperMicroUsd <= bounds.dayMicroUsd,
+          'budget exhausted',
+        );
+        const prior = entries.find((e) => e.kind === 'alias' && e.alias === alias);
+        if (prior) assert(prior.scope === scope, 'approval alias authority conflict');
+        else push({ kind: 'alias', scope, alias });
+        return push({
+          kind: 'reserved',
+          scope,
+          alias,
+          attemptId,
+          runId,
+          day,
+          upperMicroUsd,
+          binding,
+        });
+      },
+      dispatched(scope, attemptId) {
+        const a = attempts(scope).get(attemptId);
+        assert(a?.state === 'reserved', 'dispatch without reservation');
+        return push({ kind: 'dispatched', scope, attemptId });
+      },
+      received(scope, attemptId, receipt) {
+        const a = attempts(scope).get(attemptId);
+        assert(a?.state === 'dispatched', 'response without dispatch');
+        object(receipt, [
+          'costStatus',
+          'costMicroUsd',
+          'billingComplete',
+          'responseSha256',
+          'resolvedModel',
+        ]);
+        assert(['known', 'unknown'].includes(receipt.costStatus), 'receipt cost status');
+        if (receipt.costStatus === 'known') integer(receipt.costMicroUsd);
+        else assert(receipt.costMicroUsd === null, 'unknown bill');
+        return push({ kind: 'received', scope, attemptId, ...receipt });
+      },
+      settle(scope, attemptId) {
+        const a = attempts(scope).get(attemptId);
+        assert(
+          a?.state === 'received' &&
+            a.received.costStatus === 'known' &&
+            a.received.billingComplete === true,
+          'cannot settle unknown bill',
+        );
+        const row = push({
+          kind: 'settled',
+          scope,
+          attemptId,
+          costMicroUsd: a.received.costMicroUsd,
+        });
+        assert(
+          row.costMicroUsd <= a.reservation.upperMicroUsd,
+          'provider exceeded reserved exposure; admission fenced',
+        );
+        return row;
+      },
+      unknown(scope, attemptId, reason) {
+        const a = attempts(scope).get(attemptId);
+        assert(
+          a && ['reserved', 'dispatched', 'received'].includes(a.state),
+          'unknown attempt state',
+        );
+        return push({ kind: 'unknown', scope, attemptId, reason });
+      },
+      retire(alias) {
+        const record = entries.find((e) => e.kind === 'alias' && e.alias === alias);
+        assert(record, 'unknown approval namespace');
+        if (!status(record.scope).retired) push({ kind: 'retired', scope: record.scope, alias });
+        return { scope: record.scope, retired: true };
+      },
+      status,
+    };
+  } catch (e) {
+    release();
+    throw e;
+  }
+}
