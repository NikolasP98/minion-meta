+      'readiness',
+      '--input',
+      root,
+      '--holdout',
+      '--split-sha256',
+      digest(split),
+      '--unblinding',
+      unblinding,
+    ],
+    { encoding: 'utf8' },
+  );
+  assert.equal(r.status, 0, r.stderr);
