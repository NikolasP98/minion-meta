@@ -488,3 +488,60 @@ describe("loadOpenClawPlugins", () => {
     expect(overridden?.origin).toBe("bundled");
   });
 });
+
+it("validates the real alert-watcher experiment manifest before registration", () => {
+  const manifest = JSON.parse(
+    fs.readFileSync(
+      new URL("../../extensions/alert-watcher/minion.plugin.json", import.meta.url),
+      "utf8",
+    ),
+  );
+  const resolverPath = new URL(
+    "../../extensions/alert-watcher/src/jev-shadow-eligibility.ts",
+    import.meta.url,
+  ).pathname;
+  for (const complaintExperiment of [
+    undefined,
+    {},
+    { mode: "off" },
+    { mode: "census" },
+    { mode: "shadow" },
+    null,
+    { mode: "active" },
+    { mode: "shadow", approved: true },
+  ]) {
+    const dir = makeTempDir();
+    const fixture = writePlugin({
+      id: "alert-watcher",
+      dir,
+      body: `import { resolveComplaintExperiment } from ${JSON.stringify(resolverPath)};
+export default { id: "alert-watcher", register(api) { const value=resolveComplaintExperiment(api.pluginConfig.complaintExperiment); api.registerGatewayMethod("watcherFixture.mode", ({respond})=>respond(true,value)); }};`,
+    });
+    fs.writeFileSync(
+      path.join(dir, "openclaw.plugin.json"),
+      JSON.stringify({ id: manifest.id, configSchema: manifest.configSchema }),
+    );
+    const config = complaintExperiment === undefined ? {} : { complaintExperiment };
+    const registry = loadOpenClawPlugins({
+      cache: false,
+      config: {
+        plugins: {
+          enabled: true,
+          allow: ["alert-watcher"],
+          load: { paths: [fixture.file] },
+          entries: { "alert-watcher": { enabled: true, config } },
+        },
+      },
+    });
+    const plugin = registry.plugins.find((p) => p.id === "alert-watcher");
+    const valid =
+      complaintExperiment === undefined ||
+      (complaintExperiment !== null &&
+        typeof complaintExperiment === "object" &&
+        !Object.hasOwn(complaintExperiment, "approved") &&
+        (!Object.hasOwn(complaintExperiment, "mode") ||
+          ["off", "census", "shadow"].includes(complaintExperiment.mode ?? "")));
+    expect(plugin?.status).toBe(valid ? "loaded" : "error");
+    expect(Boolean(registry.gatewayHandlers["watcherFixture.mode"])).toBe(valid);
+  }
+});
