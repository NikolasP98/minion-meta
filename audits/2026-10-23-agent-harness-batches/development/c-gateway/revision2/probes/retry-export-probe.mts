import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createRequire} from 'node:module';
import {pathToFileURL} from 'node:url';
const root=process.argv[2],froot=process.argv[3];
const at=(p:string)=>pathToFileURL(path.join(root,p)).href;
await import(at('src/plugins/runtime.ts'));
const {testDb,workFixture}=await import(at('extensions/alert-watcher/src/work-test-fixtures.ts'));
const {admitSource,claimWork,admitInvocation,receiveInvocation,retryNoCredentials,finishWork}=await import(at('extensions/alert-watcher/src/classification-work.ts'));
const {classifyMessage}=await import(at('extensions/alert-watcher/src/classifier.ts'));
const {exportComplaintEvaluation}=await import(at('extensions/alert-watcher/src/complaint-evaluation.ts'));
const {reconcileComplaints}=await import(pathToFileURL(path.join(froot,'scripts/agent-evals/complaint.mjs')).href);
const require=createRequire(path.join(froot,'package.json'));
const Ajv=require('ajv');
const ajv=new Ajv({strict:true,allErrors:true});
ajv.addFormat('uuid',/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i);
const check=ajv.compile(JSON.parse(fs.readFileSync(path.join(root,'extensions/alert-watcher/src/complaint-evaluation.schema.json'),'utf8')));
const validate=(r:unknown)=>assert.ok(check(r),ajv.errorsText(check.errors));
const db=testDb();
try {
 const snapshot=workFixture();
 const a=admitSource(db,'retry-export-probe',snapshot);
 assert.equal(a.kind,'admitted');
 let lease=claimWork(db,a.work.id,'probe');
 let attemptId=admitInvocation(db,lease);
 const host={resolveApiKey:async()=>{throw Error('stub has no credentials');},resolveSkillsPrompt:()=>''};
 await classifyMessage([{role:'user',content:'fixture',ts:Date.now()}],host,snapshot.model,undefined,'es',{}, {attemptId,purpose:'classification',onTerminal:(result,usage)=>receiveInvocation(db,lease,result,usage)}).catch(()=>{});
 retryNoCredentials(db,lease);
 const queued=exportComplaintEvaluation(db,a.work.id);validate(queued);
 await new Promise(r=>setTimeout(r,5100));
 lease=claimWork(db,a.work.id,'probe-retry');assert.ok(lease);
 attemptId=admitInvocation(db,lease);
 const result={ok:true,data:{is_complaint:false,severity:'low',category:'other',summary:''},usage:{inputTokens:1,outputTokens:1,cacheReadTokens:0,cacheCreationTokens:0},durationMs:1,resolvedModel:{provider:'anthropic',model:snapshot.model}};
 receiveInvocation(db,lease,result,{attemptId,purpose:'classification',requestedModel:result.resolvedModel,resolvedModel:result.resolvedModel,usage:result.usage,costStatus:'known',costUsd:0.000001,costCoverage:'complete',elapsedMs:1});
 finishWork(db,lease,'completed');
 const completed=exportComplaintEvaluation(db,a.work.id);validate(completed);
 const reconciled=reconcileComplaints([queued,completed],validate);
 console.log(JSON.stringify({sameRecord:queued.recordId===completed.recordId,queued:{receiptRevision:queued.receiptRevision,resultId:queued.resultId,baseline:queued.baseline},completed:{receiptRevision:completed.receiptRevision,resultId:completed.resultId,baseline:completed.baseline},reconciled},null,2));
 assert.equal(reconciled.quarantine.length,0,'legal safe retry must extend the C/F receipt instead of replacing a terminal result identity');
} finally {db.close();}
