import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
const root=process.argv[2],at=(p:string)=>pathToFileURL(path.join(root,p)).href;
await import(at('src/plugins/runtime.ts'));
const {positiveFixture}=await import(at('extensions/alert-watcher/src/work-test-fixtures.ts'));
const {drainDeliveryReceipts}=await import(at('extensions/alert-watcher/src/delivery-bridge.ts'));
const {createCertifiedWatcher}=await import(at('extensions/alert-watcher/src/certified-runtime.ts'));
const {enqueueDelivery,checkpointQueuedPayload}=await import(at('src/infra/outbound/delivery-queue-store.ts'));
const {acquireDeliveryEntryLease,releaseDeliveryQueueLease,readQueuedDelivery,readDeliveryTombstone,resolveEntryPath}=await import(at('src/infra/outbound/delivery-queue-files.ts'));
const {snapshotHash}=await import(at('extensions/alert-watcher/src/provenance.ts'));
const dir=fs.mkdtempSync(path.join(os.tmpdir(),'astra-terminal-retention-'));
const f=positiveFixture(dir);
let watcher;
const originalNow=Date.now;
try {
 const row=f.db.prepare('SELECT * FROM alert_delivery_receipts').get();
 f.db.prepare("UPDATE alert_delivery_receipts SET state='admitted',admitted_at=? WHERE id=?").run(Date.now(),row.id);
 await enqueueDelivery({id:row.id,channel:'telegram',to:'owner',accountId:'default',payloads:JSON.parse(row.payload_json),completionPolicy:'caller',callerRetention:{version:1,owner:'alert-watcher',namespaceHash:snapshotHash('namespace'),receiptId:row.id,payloadHash:row.payload_hash,recipientHash:row.recipient_hash,expiresAt:row.payload_expires_at}},dir);
 const lease=await acquireDeliveryEntryLease(row.id,dir);
 const entry=await readQueuedDelivery(row.id,dir);
 await checkpointQueuedPayload({id:row.id,payloadId:entry.payloads[0].id,expectedGeneration:entry.generation,nextState:'in-flight',lease,stateDir:dir});
 await releaseDeliveryQueueLease(lease);
 await drainDeliveryReceipts(f.db,{stateDir:dir,config:()=>({}),authority:async()=>f.snapshot.authority,destinations:()=>f.snapshot.destinations,send:async()=>{throw Error('must not resend');}});
 assert.equal(f.db.prepare('SELECT state FROM alert_delivery_receipts').get().state,'indeterminate');
 assert.equal((await readQueuedDelivery(row.id,dir)).payloads[0].state,'uncertain');
 const future=Date.now()+8*86400000;Date.now=()=>future;
 const api={config:{},runtime:{config:{loadConfig:()=>({})}},logger:{warn:()=>{},info:()=>{},error:()=>{}}};
 const cfg={subscriptions:[],destinations:[],replyFlow:{enabled:false}};
 watcher=createCertifiedWatcher(api,f.db,dir,()=>cfg,()=>{throw Error('must not classify');});
 await watcher.tick();
 const rawExists=fs.existsSync(resolveEntryPath(row.id,dir));
 const rawContainsPrivate=rawExists&&fs.readFileSync(resolveEntryPath(row.id,dir),'utf8').includes('private alert');
 const tombstone=await readDeliveryTombstone(row.id,dir);
 const work=f.db.prepare('SELECT snapshot,redacted_at FROM classification_work').get();
 console.log(JSON.stringify({sqliteRedacted:work.snapshot===null&&work.redacted_at===future,recipientState:f.db.prepare('SELECT state FROM alert_delivery_receipts').get().state,rawExists,rawContainsPrivate,tombstone:tombstone??null},null,2));
 assert.equal(rawContainsPrivate,false,'live watcher housekeeping must redact expired terminal/indeterminate queue copies without requiring restart');
 assert.ok(tombstone,'replay evidence must remain after bounded cleanup');
} finally {Date.now=originalNow;await watcher?.stop();f.db.close();fs.rmSync(dir,{recursive:true,force:true});}
