+      ? {
+          ...usage,
+          dispatchStatus: "not_submitted",
+          costStatus: "known",
+          costUsd: 0,
+          costCoverage: "complete",
+        }
+      : {
+          ...usage,
+          dispatchStatus: "may_have_submitted",
+          ...(!result.ok
+            ? ({ costStatus: "unknown", costUsd: null, costCoverage: "incomplete" } as const)
+            : {}),
+        };
+    attempts[attempts.length - 1] = {
+      ...recordedUsage,
+      disposition: result.ok ? "received" : "failed",
+      ...(!result.ok ? { errorCode: result.error.code } : {}),
+    };
+    db.prepare(
+      "UPDATE classification_work SET state='received',terminal_result=?,usage_json=?,attempts_json=?,received_at=?,receipt_revision=receipt_revision+1 WHERE id=?",
