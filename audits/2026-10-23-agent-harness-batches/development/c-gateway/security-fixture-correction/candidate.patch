+export function markSuggestionDispatch(
+  db: DatabaseSync,
+  lease: WorkLease,
+  attemptId: string,
+): void {
+  immediate(db, () => {
+    const row = assertWorkLease(db, lease),
+      suggestion = JSON.parse(row.suggestion_json) as SuggestionReceipt;
+    if (
+      suggestion.state !== "admitted" ||
+      suggestion.attemptId !== attemptId ||
+      suggestion.dispatchStatus !== "preparing"
+    ) {
+      throw new Error("invalid_suggestion_dispatch_fence");
+    }
+    suggestion.dispatchStatus = "may_have_submitted";
+    db.prepare(
+      "UPDATE classification_work SET suggestion_json=?,receipt_revision=receipt_revision+1 WHERE id=?",
+    ).run(boundedJson(suggestion, 16384), row.id);
+  });
+}
+export function receiveInvocation(
+  db: DatabaseSync,
+  lease: WorkLease,
+  result: DroneRunResult<unknown>,
+  usage: InvocationUsage,
+  now = Date.now(),
+): void {
+  immediate(db, () => {
+    const row = assertWorkLease(db, lease, now);
+    if (row.state !== "admitted" || row.attempt_id !== usage.attemptId) {
+      throw new Error("invalid_receipt");
+    }
+    let terminal: string;
+    try {
+      terminal = boundedJson(result);
+    } catch {
+      terminal = boundedJson({
+        ok: false,
+        error: { code: "RESULT_TOO_LARGE" },
+        usage: result.usage,
+        durationMs: result.durationMs,
+      });
+    }
+    const attempts = JSON.parse(row.attempts_json) as Array<Record<string, unknown>>;
+    const previous = attempts[attempts.length - 1];
+    const notSubmitted =
+      previous.dispatchStatus === "preparing" &&
+      usage.dispatchStatus !== "may_have_submitted" &&
+      !result.ok &&
+      result.error.code === "NO_API_KEY";
