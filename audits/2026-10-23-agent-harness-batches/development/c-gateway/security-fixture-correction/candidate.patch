+          payload.receipt.providerMessageIdCount < 0 ||
+          !Array.isArray(payload.receipt.providerMessageIds) ||
+          payload.receipt.providerMessageIds.length > 32 ||
+          payload.receipt.providerMessageIds.some(
+            (messageId) => typeof messageId !== "string" || messageId.length > 2048,
+          ))
+      ) {
+        throw new DeliveryQueueHealthError("Malformed retained acceptance");
+      }
+    }
+    return value;
+  } catch (err) {
+    if (errorCode(err) === "ENOENT") {
+      return undefined;
+    }
+    throw err;
+  }
+}
+/** Fence replay durably before removing any private payload. The entry lease remains held. */
+export async function retainDeliveryTombstone(
+  entry: QueuedDelivery,
+  lease: DeliveryQueueLease,
+  reason: "expired" | "settled",
+  stateDir?: string,
+  settled?: {
+    generation: number;
+    payloads: DeliveryTombstone["payloads"];
+    receiptsHashed?: boolean;
+  },
+): Promise<void> {
+  await assertEntryLease(entry.id, lease);
+  const guard = entry.callerRetention;
+  if (!guard) {
+    throw new DeliveryQueueHealthError("Retention requires a bound caller");
+  }
+  const value: DeliveryTombstone = {
+    version: 1,
+    id: entry.id,
+    generation: Math.max(entry.generation, settled?.generation ?? 0),
+    namespaceHash: guard.namespaceHash,
+    payloadHash: guard.payloadHash,
+    recipientHash: guard.recipientHash,
+    retiredAt: Date.now(),
+    reason,
+    payloads: entry.payloads.map(({ id, state, acceptedAt, receipt }) => ({
+      id,
+      state: state === "in-flight" ? "uncertain" : state,
+      acceptedAt,
+      receipt: receipt
+        ? {
+            ...receipt,
+            providerMessageIds: receipt.providerMessageIds.map((id) =>
+              crypto.createHash("sha256").update(id).digest("hex"),
+            ),
+          }
+        : undefined,
+    })),
+  };
+  // A stale atomic backup cannot erase a newer acceptance already committed by
+  // the caller. Merge only those authoritative facts; other payloads stay uncertain.
+  for (const payload of settled?.payloads ?? []) {
+    if (
+      payload.state !== "accepted" ||
+      !Number.isSafeInteger(payload.acceptedAt) ||
+      !payload.receipt
+    ) {
+      throw new DeliveryQueueHealthError("Invalid settled acceptance evidence");
+    }
+    const known = {
+      ...payload,
+      receipt: payload.receipt
+        ? {
+            ...payload.receipt,
+            providerMessageIds: payload.receipt.providerMessageIds.map((id) =>
+              settled?.receiptsHashed ? id : crypto.createHash("sha256").update(id).digest("hex"),
+            ),
+          }
+        : undefined,
+    };
+    const index = value.payloads.findIndex((existing) => existing.id === payload.id);
+    if (index >= 0) {
+      value.payloads[index] = known;
+    } else {
+      value.payloads.push(known);
+    }
+  }
+  if (value.payloads.length > 256) {
+    throw new DeliveryQueueHealthError("Retained payload capacity exceeded");
+  }
+  await writeDeliveryTombstone(value, stateDir);
+  // A failed cleanup leaves the tombstone authoritative; reads/enqueues still reject.
+  await cleanupRetainedDeliveryFiles(entry.id, lease, stateDir);
+}
+async function writeDeliveryTombstone(value: DeliveryTombstone, stateDir?: string): Promise<void> {
+  const finalPath = tombstonePath(value.id, stateDir),
+    directory = path.dirname(finalPath);
+  await fs.promises.mkdir(directory, { recursive: true, mode: 0o700 });
+  const temporary = `${finalPath}.tmp-${crypto.randomUUID()}`;
+  const handle = await fs.promises.open(temporary, "wx", 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value));
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  await fs.promises.rename(temporary, finalPath);
+  await syncDirectory(directory);
+}
+export async function enforceDeliveryRetention(
+  entry: QueuedDelivery,
+  lease: DeliveryQueueLease,
+  stateDir?: string,
+): Promise<boolean> {
+  await assertEntryLease(entry.id, lease);
+  if (await readDeliveryTombstone(entry.id, stateDir)) {
+    return false;
+  }
+  if (!entry.callerRetention || Date.now() < entry.callerRetention.expiresAt) {
+    return true;
+  }
+  await retainDeliveryTombstone(entry, lease, "expired", stateDir);
+  return false;
+}
+
+/** Exact names produced by writeEntryAtomic, never an arbitrary prefix match. */
+function artifactEntryId(name: string): string | undefined {
+  const match =
+    /^([A-Za-z0-9_-]+)\.json(?:\.(?:tmp|bak)-[1-9][0-9]*-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$/.exec(
+      name,
+    );
+  return match?.[1];
+}
+async function queueCopyPaths(id: string | undefined, stateDir?: string): Promise<string[]> {
+  const paths: string[] = [];
+  for (const root of [resolveQueueDir(stateDir), resolveFailedDir(stateDir)]) {
+    let names: string[];
+    try {
+      names = await fs.promises.readdir(root);
+    } catch (err) {
+      if (errorCode(err) === "ENOENT") {
+        continue;
+      }
+      throw err;
+    }
+    if (names.length > 10000) {
+      throw new DeliveryQueueHealthError("Retention cleanup capacity exceeded");
+    }
+    for (const name of names) {
+      const owner = artifactEntryId(name);
+      if (owner && (!id || owner === id)) {
+        paths.push(path.join(root, name));
+      }
+    }
+  }
+  return paths;
+}
+/** Tombstone first, then every exact writer-owned copy under the same entry lease. */
+export async function cleanupRetainedDeliveryFiles(
+  id: string,
+  lease: DeliveryQueueLease,
+  stateDir?: string,
+): Promise<void> {
+  await assertEntryLease(id, lease);
+  if (!(await readDeliveryTombstone(id, stateDir))) {
+    throw new DeliveryQueueHealthError("Raw cleanup requires a retained tombstone");
+  }
+  for (const file of await queueCopyPaths(id, stateDir)) {
+    await fs.promises.unlink(file).catch((err) => {
+      if (errorCode(err) !== "ENOENT") {
+        throw err;
+      }
+    });
+    await syncDirectory(path.dirname(file));
+  }
+}
+/** Retry raw cleanup after tombstone commit even if a previous unlink/fsync failed. */
+export async function cleanupRetainedQueueFiles(stateDir?: string): Promise<void> {
+  const ids = new Set(
+    (await queueCopyPaths(undefined, stateDir)).map(
+      (file) => artifactEntryId(path.basename(file))!,
+    ),
+  );
+  for (const id of ids) {
+    if (!(await readDeliveryTombstone(id, stateDir))) {
+      continue;
+    }
+    const lease = await acquireDeliveryEntryLease(id, stateDir);
+    try {
+      await cleanupRetainedDeliveryFiles(id, lease, stateDir);
+    } finally {
+      await releaseDeliveryQueueLease(lease);
+    }
+  }
+}
+/** Retire an expired caller receipt without executing it, including failed/orphan copies. */
+export async function retireExpiredCallerDelivery(
+  binding: NonNullable<QueuedDelivery["callerRetention"]>,
+  lease: DeliveryQueueLease,
+  stateDir?: string,
+  terminalEvidence?: {
+    generation: number;
+    payloads: DeliveryTombstone["payloads"];
+    receiptsHashed?: boolean;
+  },
+): Promise<void> {
+  const id = binding.receiptId;
+  await assertEntryLease(id, lease);
+  if (binding.expiresAt > Date.now()) {
+    throw new DeliveryQueueHealthError("Caller receipt is not expired");
+  }
+  const matches = (value: { namespaceHash: string; payloadHash: string; recipientHash: string }) =>
+    value.namespaceHash === binding.namespaceHash &&
+    value.payloadHash === binding.payloadHash &&
+    value.recipientHash === binding.recipientHash;
+  const tombstone = await readDeliveryTombstone(id, stateDir);
+  if (tombstone) {
+    if (!matches(tombstone)) {
+      throw new DeliveryQueueHealthError("Retained caller binding mismatch");
+    }
+    await cleanupRetainedDeliveryFiles(id, lease, stateDir);
+    return;
+  }
+  const copies = await queueCopyPaths(id, stateDir);
+  // Canonical checkpoints are authoritative; a lone stale backup cannot prove no send.
+  copies.sort((a, b) => Number(!a.endsWith(".json")) - Number(!b.endsWith(".json")));
+  let entry: QueuedDelivery | undefined;
+  for (const file of copies) {
+    try {
+      const candidate = parseQueuedDelivery(
+        await readBoundedFile(file, MAX_QUEUE_FILE_BYTES),
+        `${id}.json`,
+      );
+      if (
+        candidate.id !== id ||
+        !candidate.callerRetention ||
+        !matches(candidate.callerRetention) ||
+        candidate.callerRetention.expiresAt !== binding.expiresAt
+      ) {
+        throw new DeliveryQueueHealthError("Expired caller binding mismatch");
+      }
+      entry = candidate;
+      if (!file.endsWith(".json")) {
+        entry.payloads = entry.payloads.map((payload) =>
+          payload.state === "accepted" ? payload : { ...payload, state: "uncertain" },
+        );
+      }
+      break;
+    } catch (err) {
+      // An interrupted temporary write may be partial; only a valid bound copy can fence it.
+      if (file.endsWith(".json")) {
+        throw err;
+      }
+    }
+  }
+  if (!entry) {
+    if (copies.length) {
+      if (!terminalEvidence) {
+        throw new DeliveryQueueHealthError("No valid expired caller checkpoint");
+      }
+      // The durable caller has already settled. Fence partial orphan bytes without
+      // inventing missing payload IDs, acceptance, or a no-effect disposition.
+      await writeDeliveryTombstone(
+        {
+          version: 1,
+          id,
+          generation: Math.max(0, terminalEvidence.generation),
+          namespaceHash: binding.namespaceHash,
+          payloadHash: binding.payloadHash,
+          recipientHash: binding.recipientHash,
+          retiredAt: Date.now(),
+          reason: "expired",
+          outcomeUncertain: true,
+          payloads: terminalEvidence.payloads.map((payload) => ({
+            ...payload,
+            receipt: payload.receipt
+              ? {
+                  ...payload.receipt,
+                  providerMessageIds: payload.receipt.providerMessageIds.map((id) =>
+                    terminalEvidence.receiptsHashed
+                      ? id
+                      : crypto.createHash("sha256").update(id).digest("hex"),
+                  ),
+                }
+              : undefined,
+          })),
+        },
+        stateDir,
+      );
+      await cleanupRetainedDeliveryFiles(id, lease, stateDir);
+    }
+    return;
+  }
+  await retainDeliveryTombstone(entry, lease, "expired", stateDir, terminalEvidence);
+}
+export async function expireRetainedFailedDeliveries(stateDir?: string): Promise<void> {
+  let names: string[];
+  try {
+    names = await fs.promises.readdir(resolveFailedDir(stateDir));
+  } catch (err) {
+    if (errorCode(err) === "ENOENT") {
+      return;
+    }
+    throw err;
+  }
+  if (names.length > 10000) {
+    throw new DeliveryQueueHealthError("Failed retention capacity exceeded");
+  }
+  for (const name of names) {
+    if (!name.endsWith(".json")) {
+      continue;
+    }
+    const id = name.slice(0, -5);
+    if (await readDeliveryTombstone(id, stateDir)) {
+      continue;
+    }
+    const entry = parseQueuedDelivery(
+      await readBoundedFile(path.join(resolveFailedDir(stateDir), name), MAX_QUEUE_FILE_BYTES),
+      name,
+    );
+    if (!entry.callerRetention || entry.callerRetention.expiresAt > Date.now()) {
+      continue;
+    }
+    const lease = await acquireDeliveryEntryLease(id, stateDir);
+    try {
+      await enforceDeliveryRetention(entry, lease, stateDir);
+    } finally {
+      await releaseDeliveryQueueLease(lease);
+    }
+  }
+}
