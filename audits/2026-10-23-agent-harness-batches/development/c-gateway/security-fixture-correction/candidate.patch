+export function retryNoCredentials(db: DatabaseSync, lease: WorkLease, now = Date.now()): void {
+  const row = assertWorkLease(db, lease, now);
+  if (
+    row.state !== "received" ||
+    JSON.parse(row.terminal_result ?? "null")?.error?.code !== "NO_API_KEY" ||
+    JSON.parse(row.attempts_json).at(-1)?.dispatchStatus !== "not_submitted"
+  ) {
+    throw new Error("retry_not_proven_safe");
+  }
+  if (row.attempt_count >= 3) {
+    finishWork(db, lease, "failed", "no_credentials", now);
+    return;
+  }
+  db.prepare(
+    "UPDATE classification_work SET state='queued',next_attempt_at=?,lease_owner=NULL,lease_expires_at=NULL,receipt_revision=receipt_revision+1 WHERE id=?",
+  ).run(now + (row.attempt_count === 1 ? 5000 : 30000), row.id);
