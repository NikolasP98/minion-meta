@@ -0,0 +1,546 @@
+import crypto from "node:crypto";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, it, expect, vi } from "vitest";
+import {
+  acquireDeliveryEntryLease,
+  releaseDeliveryQueueLease,
+  readQueuedDelivery,
+  readDeliveryTombstone,
+  resolveEntryPath,
+  resolveFailedDir,
+} from "../../../src/infra/outbound/delivery-queue-files.js";
+import {
+  enqueueDelivery,
+  checkpointQueuedPayload,
+} from "../../../src/infra/outbound/delivery-queue-store.js";
+import type { MinionPluginApi } from "../../../src/plugins/types.js";
+import type { ResolvedConfig } from "../index.js";
+import { createCertifiedWatcher } from "./certified-runtime.js";
+import { redactExpiredWork, type DeliveryRow } from "./classification-work.js";
+import { drainDeliveryReceipts } from "./delivery-bridge.js";
+import { snapshotHash } from "./provenance.js";
+import { positiveFixture } from "./work-test-fixtures.js";
+const dirs: string[] = [];
+afterEach(() => {
+  vi.restoreAllMocks();
+  for (const dir of dirs.splice(0)) {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+function fixture(count = 1) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "live-retention-"));
+  dirs.push(dir);
+  return {
+    dir,
+    ...positiveFixture(
+      dir,
+      Array.from({ length: count }, (_, i) => ({
+        channel: "telegram",
+        accountId: "default",
+        to: `owner-${i}`,
+      })),
+    ),
+  };
+}
+async function enqueue(f: ReturnType<typeof fixture>, row: DeliveryRow) {
+  await enqueueDelivery(
+    {
+      id: row.id,
+      channel: "telegram",
+      accountId: "default",
+      to: JSON.parse(row.recipient_json!).to,
+      payloads: JSON.parse(row.payload_json!),
+      completionPolicy: "caller",
+      callerRetention: {
+        version: 1,
+        owner: "alert-watcher",
+        namespaceHash: snapshotHash("namespace"),
+        receiptId: row.id,
+        payloadHash: row.payload_hash,
+        recipientHash: row.recipient_hash,
+        expiresAt: row.payload_expires_at,
+      },
+    },
+    f.dir,
+  );
+}
+function watcher(f: ReturnType<typeof fixture>) {
+  const api = {
+    config: {},
+    runtime: { config: { loadConfig: () => ({}) } },
+    logger: { warn: vi.fn() },
+  } as unknown as MinionPluginApi;
+  return createCertifiedWatcher(
+    api,
+    f.db,
+    f.dir,
+    () => ({ subscriptions: [], destinations: [] }) as unknown as ResolvedConfig,
+    () => {
+      throw Error("must not classify");
+    },
+  );
+}
+for (const state of ["indeterminate", "failed", "canceled", "sent"] as const) {
+  it(`live tick expires ${state} raw/failed copies without changing external-effect truth`, async () => {
+    const f = fixture(),
+      row = f.db.prepare("SELECT * FROM alert_delivery_receipts").get() as DeliveryRow;
+    await enqueue(f, row);
+    let acceptedAt: number | undefined;
+    if (state === "indeterminate" || state === "sent") {
+      const lease = await acquireDeliveryEntryLease(row.id, f.dir);
+      let entry = await readQueuedDelivery(row.id, f.dir);
+      entry = await checkpointQueuedPayload({
+        id: row.id,
+        payloadId: entry.payloads[0].id,
+        expectedGeneration: entry.generation,
+        nextState: "in-flight",
+        lease,
+        stateDir: f.dir,
+      });
+      if (state === "sent") {
+        entry = await checkpointQueuedPayload({
+          id: row.id,
+          payloadId: entry.payloads[0].id,
+          expectedGeneration: entry.generation,
+          nextState: "accepted",
+          providerMessageIds: ["private-provider-id"],
+          lease,
+          stateDir: f.dir,
+        });
+        acceptedAt = entry.payloads[0].acceptedAt;
+      }
+      await releaseDeliveryQueueLease(lease);
+    }
+    f.db
+      .prepare(
+        "UPDATE alert_delivery_receipts SET state=?,queue_generation=0,admitted_at=?,safe_reason='fixture_terminal',provider_receipts='[]' WHERE id=?",
+      )
+      .run(state, Date.now(), row.id);
+    // Failed-directory copies carry the same body, mirror and errors; expiry
+    // cannot depend on the normal executable root file still existing.
+    const raw = resolveEntryPath(row.id, f.dir),
+      failed = path.join(resolveFailedDir(f.dir), `${row.id}.json`);
+    if (state === "failed") {
+      fs.renameSync(raw, failed);
+    } else {
+      fs.copyFileSync(raw, raw + `.bak-${process.pid}-${crypto.randomUUID()}`);
+    }
+    vi.spyOn(Date, "now").mockReturnValue(row.payload_expires_at + 1);
+    const w = watcher(f);
+    await w.tick();
+    await w.stop();
+    expect(fs.existsSync(raw)).toBe(false);
+    expect(fs.existsSync(failed)).toBe(false);
+    const tombstone = await readDeliveryTombstone(row.id, f.dir);
+    expect(tombstone?.reason).toBe("expired");
+    expect(tombstone?.payloads[0].state).toBe(
+      state === "sent" ? "accepted" : state === "indeterminate" ? "uncertain" : "pending",
+    );
+    if (state === "sent") {
+      expect(tombstone?.payloads[0].acceptedAt).toBe(acceptedAt);
+    }
+    expect(
+      f.db.prepare("SELECT state,queue_generation FROM alert_delivery_receipts").get(),
+    ).toEqual({ state, queue_generation: -1 });
+    expect(f.db.prepare("SELECT snapshot FROM classification_work").get()).toEqual({
+      snapshot: null,
+    });
+    expect(f.db.prepare("SELECT count(*) n FROM pending_replies").get()).toEqual({ n: 0 });
+    f.db.close();
+  });
+}
+it("live terminal housekeeping retries unlink failures behind tombstone and bounds each tick to ten receipts", async () => {
+  const f = fixture(11),
+    rows = f.db
+      .prepare("SELECT * FROM alert_delivery_receipts ORDER BY rowid")
+      .all() as DeliveryRow[];
+  for (const row of rows) {
+    await enqueue(f, row);
+  }
+  f.db
+    .prepare(
+      "UPDATE alert_delivery_receipts SET state='indeterminate',admitted_at=1,safe_reason='fixture_terminal'",
+    )
+    .run();
+  let clock = rows[0].payload_expires_at + 1;
+  vi.spyOn(Date, "now").mockImplementation(() => clock);
+  const original = fs.promises.unlink.bind(fs.promises),
+    fault = vi.spyOn(fs.promises, "unlink").mockImplementation(async (file) => {
+      if (String(file) === resolveEntryPath(rows[0].id, f.dir)) {
+        throw Error("unlink fault");
+      }
+      return original(file);
+    });
+  const w = watcher(f);
+  await w.tick();
+  expect(await readDeliveryTombstone(rows[0].id, f.dir)).toBeDefined();
+  await expect(readQueuedDelivery(rows[0].id, f.dir)).rejects.toThrow("tombstone");
+  expect(
+    f.db.prepare("SELECT count(*) n FROM alert_delivery_receipts WHERE queue_generation=-1").get(),
+  ).toEqual({ n: 9 });
+  expect(fs.existsSync(resolveEntryPath(rows[10].id, f.dir))).toBe(true);
+  fault.mockRestore();
+  clock += 5001;
+  await w.tick();
+  await w.stop();
+  expect(
+    f.db.prepare("SELECT count(*) n FROM alert_delivery_receipts WHERE queue_generation=-1").get(),
+  ).toEqual({ n: 11 });
+  for (const row of rows) {
+    expect(fs.existsSync(resolveEntryPath(row.id, f.dir))).toBe(false);
+  }
+  expect(f.db.prepare("SELECT count(*) n FROM pending_replies").get()).toEqual({ n: 0 });
+  f.db.close();
+});
+
+it("actual recovered uncertain bridge outcome is cleaned by later watcher tick without restart", async () => {
+  const f = fixture(),
+    row = f.db.prepare("SELECT * FROM alert_delivery_receipts").get() as DeliveryRow;
+  await enqueue(f, row);
+  const lease = await acquireDeliveryEntryLease(row.id, f.dir),
+    entry = await readQueuedDelivery(row.id, f.dir);
+  await checkpointQueuedPayload({
+    id: row.id,
+    payloadId: entry.payloads[0].id,
+    expectedGeneration: entry.generation,
+    nextState: "in-flight",
+    lease,
+    stateDir: f.dir,
+  });
+  await releaseDeliveryQueueLease(lease);
+  f.db.prepare("UPDATE alert_delivery_receipts SET state='admitted',admitted_at=1").run();
+  const send = vi.fn();
+  await drainDeliveryReceipts(f.db, {
+    stateDir: f.dir,
+    config: () => ({}),
+    authority: async () => f.snapshot.authority,
+    destinations: () => f.snapshot.destinations,
+    send,
+  });
+  expect(f.db.prepare("SELECT state FROM alert_delivery_receipts").get()).toEqual({
+    state: "indeterminate",
+  });
+  vi.spyOn(Date, "now").mockReturnValue(row.payload_expires_at + 1);
+  const w = watcher(f);
+  await w.tick();
+  await w.stop();
+  expect(send).not.toHaveBeenCalled();
+  expect(fs.existsSync(resolveEntryPath(row.id, f.dir))).toBe(false);
+  expect((await readDeliveryTombstone(row.id, f.dir))?.payloads[0].state).toBe("uncertain");
+  f.db.close();
+});
+
