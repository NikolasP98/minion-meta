+export function assertWorkLease(db: DatabaseSync, lease: WorkLease, now = Date.now()): WorkRow {
+  const row = getWork(db, lease.id);
+  if (
+    !row ||
+    row.lease_owner !== lease.owner ||
+    row.generation !== lease.generation ||
+    (row.lease_expires_at ?? 0) <= now ||
+    row.namespace_retired
+  ) {
+    throw new Error("work_lease_lost");
+  }
+  return row;
+}
+export function renewWork(db: DatabaseSync, lease: WorkLease, now = Date.now()): void {
+  const r = db
+    .prepare(
+      "UPDATE classification_work SET lease_expires_at=? WHERE id=? AND lease_owner=? AND generation=? AND lease_expires_at>?",
+    )
+    .run(now + 30000, lease.id, lease.owner, lease.generation, now);
+  if (!r.changes) {
+    throw new Error("work_lease_lost");
+  }
