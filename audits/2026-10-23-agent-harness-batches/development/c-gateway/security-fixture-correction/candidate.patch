+} from "../../plugins/hook-runner-global.js";
+import {
+  acquireDeliveryEntryLease,
+  releaseDeliveryQueueLease,
+  readQueuedDelivery,
+  readDeliveryTombstone,
+  resolveEntryPath,
+} from "./delivery-queue-files.js";
+import { recoverPendingDeliveries } from "./delivery-queue-recovery.js";
+import { enqueueDelivery, checkpointQueuedPayload } from "./delivery-queue-store.js";
+import { recipientBinding, retentionHash } from "./delivery-retention.js";
+const dirs: string[] = [];
+afterEach(() => {
+  resetGlobalHookRunner();
+  vi.restoreAllMocks();
+  for (const d of dirs.splice(0)) {
+    fs.rmSync(d, { recursive: true, force: true });
+  }
+});
+function dir() {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), "queue-retention-"));
+  dirs.push(d);
+  return d;
+}
+function params(expiresAt: number) {
+  const id = crypto.randomUUID(),
+    payloads = [{ text: "private body" }],
+    target = { channel: "telegram" as const, accountId: "default", to: "private-owner" };
+  return {
+    id,
+    ...target,
+    payloads,
+    completionPolicy: "caller" as const,
+    callerRetention: {
+      version: 1 as const,
+      owner: "alert-watcher" as const,
+      namespaceHash: retentionHash("n"),
+      receiptId: id,
+      payloadHash: retentionHash(payloads),
+      recipientHash: recipientBinding(target),
+      expiresAt,
+    },
+  };
+}
+const log = { info: () => {}, warn: () => {}, error: () => {} };
+it("generic recovery before watcher startup expires an unredacted caller entry and fences reenqueues", async () => {
+  const stateDir = dir(),
+    p = params(Date.now() - 1);
+  await enqueueDelivery(p, stateDir);
+  expect(fs.readFileSync(resolveEntryPath(p.id, stateDir), "utf8")).toContain("private body");
+  const deliver = vi.fn();
+  await recoverPendingDeliveries({ stateDir, cfg: {}, log, deliver, delay: async () => {} });
+  expect(deliver).not.toHaveBeenCalled();
+  const tombstone = await readDeliveryTombstone(p.id, stateDir);
+  expect(tombstone?.reason).toBe("expired");
+  expect(JSON.stringify(tombstone)).not.toContain("private");
+  expect(fs.existsSync(resolveEntryPath(p.id, stateDir))).toBe(false);
+  await expect(
+    enqueueDelivery(
+      { ...p, callerRetention: { ...p.callerRetention, expiresAt: Date.now() + 100000 } },
+      stateDir,
+    ),
+  ).rejects.toThrow();
+});
+it("retains acceptedAt and uncertain evidence while deleting expired content", async () => {
+  const stateDir = dir(),
+    p = params(Date.now() + 10000);
+  await enqueueDelivery(p, stateDir);
+  const lease = await acquireDeliveryEntryLease(p.id, stateDir);
+  let entry = await readQueuedDelivery(p.id, stateDir);
+  entry = await checkpointQueuedPayload({
+    id: entry.id,
+    payloadId: entry.payloads[0].id,
+    expectedGeneration: entry.generation,
+    nextState: "in-flight",
+    stateDir,
+    lease,
+  });
+  entry = await checkpointQueuedPayload({
+    id: entry.id,
+    payloadId: entry.payloads[0].id,
+    expectedGeneration: entry.generation,
+    nextState: "accepted",
+    providerMessageIds: ["private-provider-id"],
+    stateDir,
+    lease,
+  });
+  const acceptedAt = entry.payloads[0].acceptedAt;
+  await releaseDeliveryQueueLease(lease);
+  const raw = JSON.parse(fs.readFileSync(resolveEntryPath(p.id, stateDir), "utf8"));
+  raw.callerRetention.expiresAt = Date.now() - 1;
+  fs.writeFileSync(resolveEntryPath(p.id, stateDir), JSON.stringify(raw));
+  const deliver = vi.fn();
+  await recoverPendingDeliveries({ stateDir, cfg: {}, log, deliver, delay: async () => {} });
+  expect((await readDeliveryTombstone(p.id, stateDir))?.payloads[0]).toMatchObject({
+    state: "accepted",
