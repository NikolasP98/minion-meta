+/** A provider-capable invocation must cross this owner/generation fence first. */
+export function markInvocationDispatch(
+  db: DatabaseSync,
+  lease: WorkLease,
+  attemptId: string,
+): void {
+  immediate(db, () => {
+    const row = assertWorkLease(db, lease);
+    if (row.state !== "admitted" || row.attempt_id !== attemptId) {
+      throw new Error("invalid_dispatch_fence");
+    }
+    const attempts = JSON.parse(row.attempts_json) as Array<Record<string, unknown>>;
+    const current = attempts[attempts.length - 1];
+    if (current.attemptId !== attemptId) {
+      throw new Error("invalid_dispatch_fence");
+    }
+    if (current.dispatchStatus === "may_have_submitted") {
+      return;
+    }
+    if (current.dispatchStatus !== "preparing") {
+      throw new Error("invalid_dispatch_fence");
+    }
+    current.dispatchStatus = "may_have_submitted";
+    db.prepare(
+      "UPDATE classification_work SET attempts_json=?,receipt_revision=receipt_revision+1 WHERE id=?",
+    ).run(boundedJson(attempts), row.id);
+  });
