+export function recoverExpiredInvocations(db: DatabaseSync, now = Date.now()): void {
+  immediate(db, () => {
+    db.prepare(
+      "UPDATE classification_work SET state='indeterminate',safe_error='admitted_owner_expired',lease_owner=NULL,lease_expires_at=NULL,completed_at=?,receipt_revision=receipt_revision+1 WHERE state='admitted' AND lease_expires_at<=?",
