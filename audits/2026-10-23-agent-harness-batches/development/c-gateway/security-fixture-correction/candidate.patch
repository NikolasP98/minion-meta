+      stateDir: dir,
+    });
+    await releaseDeliveryQueueLease(lease);
+    const send = vi.fn(),
+      deps = {
+        stateDir: dir,
+        config: () => ({}),
+        authority: async () => f.snapshot.authority,
+        destinations: () => f.snapshot.destinations,
+        send,
+      };
+    await drainDeliveryReceipts(f.db, deps);
+    await drainDeliveryReceipts(f.db, deps);
+    const result = f.db
+      .prepare("SELECT state,provider_receipts FROM alert_delivery_receipts")
+      .get()!;
+    expect(result.state).toBe(mixed === "suppressed" ? "canceled" : "indeterminate");
+    expect(JSON.parse(String(result.provider_receipts))[0].receipt.providerMessageIds).toEqual([
+      "known-accepted",
+    ]);
+    expect(send).not.toHaveBeenCalled();
+    expect(f.db.prepare("SELECT first_sent_at FROM classification_work").get()).toEqual({
+      first_sent_at: null,
+    });
+    expect(f.db.prepare("SELECT count(*) n FROM pending_replies").get()).toEqual({ n: 0 });
+    if (mixed === "suppressed") {
+      expect((await readDeliveryTombstone(row.id, dir))?.payloads.map((p) => p.state)).toEqual([
+        "accepted",
+        "suppressed",
+      ]);
+    }
+    f.db.close();
+  });
+}
