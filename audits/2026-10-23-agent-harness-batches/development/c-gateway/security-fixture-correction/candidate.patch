@@ -0,0 +1,899 @@
+import crypto from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import type { DroneRunResult } from "@minion-stack/drone";
+import type { InvocationUsage } from "../../../src/drones/run-with-usage.js";
+import type { CanonicalTransportSourceUnit } from "../../../src/plugins/types/hooks.js";
+import { type BoundAuthority, type WatcherAuthority, sameAuthority } from "./authority.js";
+import type { ClassifierOverrides } from "./classifier.js";
+import type { CooldownConfig } from "./cooldown.js";
+import { redactDeliveryEvidence } from "./delivery-evidence.js";
+import type { Destination } from "./destinations.js";
+import type { ExperimentMode } from "./jev-shadow-eligibility.js";
+import {
+  admissionIdentity,
+  canonicalSnapshot,
+  snapshotHash,
+  sourceIdentity,
+  WATCHER_POLICY_ID,
+  classifierInput,
+} from "./provenance.js";
+import type { ReplyFlowConfig } from "./reply-flow/types.js";
+import type { ComplaintResult } from "./types.js";
+
+export const RAW_RETENTION_MS = 7 * 24 * 60 * 60 * 1000;
+export type WorkState =
+  | "queued"
+  | "admitted"
+  | "received"
+  | "completed"
+  | "failed"
+  | "canceled"
+  | "indeterminate";
+export type WorkSnapshot = {
+  sourceCertification?: "uncertified" | "idless";
+  qualifiedModelRevision?: string;
+  invocationPurpose?: "classification" | "suggestion";
+  source: CanonicalTransportSourceUnit;
+  authority: BoundAuthority;
+  agentId?: string;
+  model: string;
+  language: "en" | "es";
+  overrides: ClassifierOverrides;
+  minSeverity: "low" | "med" | "high";
+  cooldown: CooldownConfig;
+  destinations: Destination[];
+  destinationAuthorities?: Record<string, BoundAuthority>;
+  replyFlow: ReplyFlowConfig;
+  mode: ExperimentMode;
+  policyHash: string;
+  defaultPolicyHash: string;
+  customPolicy: boolean;
+};
+export type SuggestionReceipt = {
+  state: "not_requested" | "queued" | "admitted" | "received" | "indeterminate";
+  attemptId?: string;
+  result?: DroneRunResult<unknown>;
+  usage?: InvocationUsage;
+  suggestions?: string[];
+  reason?: string;
+  dispatchStatus?: "preparing" | "may_have_submitted" | "not_submitted";
+};
+export type WorkRow = {
+  id: string;
+  namespace: string;
+  policy_id: string;
+  admission_key: string;
+  source_key: string;
+  source_hash: string;
+  input_hash: string;
+  policy_hash: string;
+  computation_key: string;
+  reevaluation_generation: number;
+  prior_work_id: string | null;
+  snapshot: string | null;
+  state: WorkState;
+  lease_owner: string | null;
+  generation: number;
+  lease_expires_at: number | null;
+  attempt_count: number;
+  next_attempt_at: number;
+  attempt_id: string | null;
+  admitted_at: number | null;
+  received_at: number | null;
+  completed_at: number | null;
+  terminal_result: string | null;
+  usage_json: string | null;
+  attempts_json: string;
+  safe_error: string | null;
+  source_counted_at: number;
+  first_sent_at: number | null;
+  complaint_id: number | null;
+  suggestion_json: string;
+  created_at: number;
+  payload_expires_at: number;
+  redacted_at: number | null;
+  namespace_retired: number;
+  receipt_revision: number;
+  authority_observation: string | null;
+};
+export type WorkLease = { id: string; owner: string; generation: number };
+export type DeliveryRow = {
+  id: string;
+  work_id: string;
+  result_revision: number;
+  recipient_hash: string;
+  policy_hash: string;
+  recipient_json: string | null;
+  payload_json: string | null;
+  payload_hash: string;
+  state: "queued" | "admitted" | "sent" | "failed" | "canceled" | "indeterminate";
+  lease_owner: string | null;
+  generation: number;
+  lease_expires_at: number | null;
+  admitted_at: number | null;
+  settled_at: number | null;
+  queue_generation: number | null;
+  next_attempt_at: number;
+  provider_receipts: string | null;
+  safe_reason: string | null;
+  payload_expires_at: number;
+  redacted_at: number | null;
+};
+export function boundedJson(value: unknown, max = 65536): string {
+  const text = canonicalSnapshot(value);
+  if (Buffer.byteLength(text) > max) {
+    throw new Error("snapshot_too_large");
+  }
+  return text;
+}
+export function immediate<T>(db: DatabaseSync, fn: () => T): T {
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    const value = fn();
+    db.exec("COMMIT");
+    return value;
+  } catch (err) {
+    db.exec("ROLLBACK");
+    throw err;
+  }
+}
+export function initWorkSchema(db: DatabaseSync): void {
+  db.exec(`PRAGMA busy_timeout=5000;
+    CREATE TABLE IF NOT EXISTS classification_work (
+      id TEXT PRIMARY KEY, namespace TEXT NOT NULL, policy_id TEXT NOT NULL,
+      admission_key TEXT NOT NULL UNIQUE, source_key TEXT NOT NULL, source_hash TEXT NOT NULL,
+      input_hash TEXT NOT NULL, policy_hash TEXT NOT NULL, computation_key TEXT NOT NULL UNIQUE,
+      reevaluation_generation INTEGER NOT NULL DEFAULT 0 CHECK(reevaluation_generation>=0), prior_work_id TEXT,
+      evaluation_binding TEXT NOT NULL,
+      authority_observation TEXT CHECK(authority_observation IS NULL OR length(CAST(authority_observation AS BLOB))<=1024),
+      snapshot TEXT CHECK(snapshot IS NULL OR length(CAST(snapshot AS BLOB))<=65536),
+      state TEXT NOT NULL CHECK(state IN ('queued','admitted','received','completed','failed','canceled','indeterminate')),
+      lease_owner TEXT, generation INTEGER NOT NULL DEFAULT 0 CHECK(generation>=0), lease_expires_at INTEGER,
+      attempt_count INTEGER NOT NULL DEFAULT 0 CHECK(attempt_count BETWEEN 0 AND 3), next_attempt_at INTEGER NOT NULL,
+      attempt_id TEXT, admitted_at INTEGER, received_at INTEGER, completed_at INTEGER,
+      terminal_result TEXT CHECK(terminal_result IS NULL OR length(CAST(terminal_result AS BLOB))<=65536),
+      usage_json TEXT, attempts_json TEXT NOT NULL DEFAULT '[]', safe_error TEXT CHECK(length(safe_error)<=128),
+      source_counted_at INTEGER NOT NULL, first_sent_at INTEGER, complaint_id INTEGER,
+      shadow_json TEXT NOT NULL DEFAULT 'null' CHECK(length(CAST(shadow_json AS BLOB))<=16384),
+      suggestion_json TEXT NOT NULL DEFAULT '{"state":"not_requested"}' CHECK(length(CAST(suggestion_json AS BLOB))<=16384),
+      created_at INTEGER NOT NULL, payload_expires_at INTEGER NOT NULL, redacted_at INTEGER,
+      namespace_retired INTEGER NOT NULL DEFAULT 0 CHECK(namespace_retired IN (0,1)),
+      receipt_revision INTEGER NOT NULL DEFAULT 1 CHECK(receipt_revision>0),
+      CHECK(state NOT IN ('admitted','indeterminate') OR (admitted_at IS NOT NULL AND attempt_id IS NOT NULL)),
+      CHECK(state NOT IN ('received','completed') OR terminal_result IS NOT NULL OR redacted_at IS NOT NULL)
+    );
+    CREATE INDEX IF NOT EXISTS idx_work_due ON classification_work(state,next_attempt_at,lease_expires_at);
+    CREATE INDEX IF NOT EXISTS idx_work_retention ON classification_work(payload_expires_at) WHERE redacted_at IS NULL;
+    CREATE TABLE IF NOT EXISTS alert_delivery_receipts (
+      id TEXT PRIMARY KEY, work_id TEXT NOT NULL REFERENCES classification_work(id), result_revision INTEGER NOT NULL,
+      recipient_hash TEXT NOT NULL, policy_hash TEXT NOT NULL, recipient_json TEXT,
+      payload_json TEXT CHECK(payload_json IS NULL OR length(CAST(payload_json AS BLOB))<=65536), payload_hash TEXT NOT NULL,
+      state TEXT NOT NULL CHECK(state IN ('queued','admitted','sent','failed','canceled','indeterminate')),
+      lease_owner TEXT, generation INTEGER NOT NULL DEFAULT 0, lease_expires_at INTEGER,
+      admitted_at INTEGER, settled_at INTEGER, queue_generation INTEGER, provider_receipts TEXT, next_attempt_at INTEGER NOT NULL DEFAULT 0,
+      safe_reason TEXT CHECK(length(safe_reason)<=128), payload_expires_at INTEGER NOT NULL, redacted_at INTEGER,
+      UNIQUE(work_id,result_revision,policy_hash,recipient_hash),
+      CHECK(state!='sent' OR provider_receipts IS NOT NULL),
+      CHECK(state!='indeterminate' OR (admitted_at IS NOT NULL AND safe_reason IS NOT NULL))
+    );
+    CREATE INDEX IF NOT EXISTS idx_delivery_work ON alert_delivery_receipts(work_id,state);
+  `);
+  const columns = db.prepare("PRAGMA table_info(classification_work)").all() as Array<{
+    name: string;
+  }>;
+  if (!columns.some((column) => column.name === "authority_observation")) {
+    db.exec(
+      "ALTER TABLE classification_work ADD COLUMN authority_observation TEXT CHECK(authority_observation IS NULL OR length(CAST(authority_observation AS BLOB))<=1024)",
+    );
+  }
+}
+export type AuthorityObservation = {
+  status: "valid" | "disabled" | "unmatched" | "invalid";
+  source: "db_mirror" | "json_config" | "unavailable";
+  reason: string | null;
+  observedAt: number;
+};
+/** Persist only source-qualified authority facts, fenced against a successor generation. */
+export function observeWorkAuthority(
+  db: DatabaseSync,
+  row: WorkRow,
+  snapshot: WorkSnapshot,
+  current: WatcherAuthority,
+  now = Date.now(),
+): boolean {
+  const valid = sameAuthority(snapshot.authority, current);
+  const reason =
+    current.kind === "unavailable" && /^[a-z_]{1,128}$/.test(current.reason)
+      ? current.reason
+      : null;
+  const observation: AuthorityObservation = {
+    status: valid
+      ? "valid"
+      : reason === "plugin_disabled"
+        ? "disabled"
+        : reason === "policy_unmatched"
+          ? "unmatched"
+          : "invalid",
+    source: current.kind === "unavailable" ? "unavailable" : current.source,
+    reason,
+    observedAt: now,
+  };
+  const prior = row.authority_observation
+    ? (JSON.parse(row.authority_observation) as AuthorityObservation)
+    : null;
+  if (
+    !prior ||
+    prior.status !== observation.status ||
+    prior.source !== observation.source ||
+    prior.reason !== reason
+  ) {
+    db.prepare(
+      "UPDATE classification_work SET authority_observation=?,receipt_revision=receipt_revision+1 WHERE id=? AND generation=?",
+    ).run(boundedJson(observation, 1024), row.id, row.generation);
+  }
+  return valid;
+}
+export function getWork(db: DatabaseSync, id: string): WorkRow | undefined {
+  return db.prepare("SELECT * FROM classification_work WHERE id=?").get(id) as WorkRow | undefined;
+}
+export function admitSource(
+  db: DatabaseSync,
+  namespace: string,
+  snapshot: WorkSnapshot,
+  now = Date.now(),
+  reevaluation?: { generation: number; priorWorkId: string; actor: string; reason: string },
+): { kind: "admitted" | "existing"; work: WorkRow } | { kind: "identity_conflict" | "retired" } {
+  const sourceKey = snapshotHash(sourceIdentity(snapshot.source)),
+    sourceHash = snapshotHash(snapshot.source);
+  const generation = reevaluation?.generation ?? 0;
+  const admissionKey = admissionIdentity(namespace, snapshot.source, generation);
+  return immediate(db, () => {
+    if (
+      db
+        .prepare(
+          "SELECT 1 FROM classification_work WHERE namespace=? AND namespace_retired=1 LIMIT 1",
+        )
+        .get(namespace)
+    ) {
+      return { kind: "retired" };
+    }
+    const existing = db
+      .prepare("SELECT * FROM classification_work WHERE admission_key=?")
+      .get(admissionKey) as WorkRow | undefined;
+    if (existing) {
+      return existing.source_hash !== sourceHash
+        ? { kind: "identity_conflict" }
+        : { kind: "existing", work: existing };
+    }
+    if (reevaluation) {
+      const previous = getWork(db, reevaluation.priorWorkId);
+      if (
+        !previous ||
