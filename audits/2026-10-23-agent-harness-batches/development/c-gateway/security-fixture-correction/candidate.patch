+    await f.stop();
+    const { resolveConfig } = await import("../index.js");
+    const { buildClassifierDrone } = await import("./classifier.js");
+    const { snapshotHash } = await import("./provenance.js");
+    const { createCertifiedWatcher } = await import("./certified-runtime.js");
+    const { exportComplaintEvaluation } = await import("./complaint-evaluation.js");
+    const cfg = resolveConfig(f.api.pluginConfig!);
+    const policyHash = snapshotHash(
+      buildClassifierDrone(cfg.classifier.model, cfg.language, undefined).definition,
+    );
+    const gate = vi.fn(async ({ attemptId }: { attemptId: string }) => ({
+      disposition: "negative" as const,
+      usage: {
+        attemptId,
+        purpose: "classification" as const,
+        requestedModel: { provider: "fixture", model: "gate" },
+        resolvedModel: { provider: "fixture", model: "gate" },
+        usage: { inputTokens: 1, outputTokens: 1 },
+        costStatus: "known" as const,
+        costUsd: 0.000001,
+        costCoverage: "complete" as const,
+        elapsedMs: 1,
+      },
+    }));
+    const watcher = createCertifiedWatcher(
+      f.api,
+      f.db,
+      path.join(f.dir, "plugins/alert-watcher"),
+      () => cfg,
+      () => "positive baseline",
+      {
+        context: {
+          manifestHash: "a".repeat(64),
+          policyHash,
+          modelRevision: "fixture-classifier-v1",
+          gateRevision: "fixture-gate-v1",
+          remainingExposureUsd: 0.01,
+          expiresAt: Date.now() + 60000,
+          maxInvocationCostUsd: 0.001,
+          classifierModel: cfg.classifier.model,
+          requestedGateModel: { provider: "fixture", model: "gate", revision: "fixture-gate-v1" },
+        },
+        run: gate,
+      },
+    );
+    transport.complete.mockImplementation(async () => {
+      if (revoke) {
+        f.cfg.plugins!.entries!["alert-watcher"]!.enabled = false;
+      }
+      return {
+        role: "assistant",
+        content: [
+          {
+            type: "toolCall",
+            id: "r",
+            name: "result",
+            arguments: {
+              is_complaint: true,
+              severity: "high",
+              category: "other",
+              summary: "positive",
+            },
+          },
+        ],
+        usage: { input: 10, output: 5, cacheRead: 0, cacheWrite: 0 },
+        stopReason: "toolUse",
+      };
+    });
+    try {
+      await watcher.admit(inbound());
+      const row = f.db.prepare("SELECT id FROM classification_work").get() as { id: string };
+      const record = exportComplaintEvaluation(f.db, row.id);
+      expect(transport.complete).toHaveBeenCalledTimes(1);
+      expect(record.baseline.disposition).toBe("positive");
+      expect(record.attempts.filter((a) => a.purpose === "baseline")).toHaveLength(1);
+      if (revoke) {
+        expect(gate).not.toHaveBeenCalled();
+        expect(record.enabled).toBe(false);
+        expect(f.db.prepare("SELECT count(*) n FROM complaints").get()).toEqual({ n: 0 });
+      } else {
+        expect(gate).toHaveBeenCalledTimes(1);
+        expect(record.gate?.disposition).toBe("negative");
+        expect(record.attempts.filter((a) => a.purpose === "gate")).toHaveLength(1);
+        expect(record.forwardedBaselineAttemptIds).toEqual([]);
+        expect(record.eligibility.status).toBe("eligible");
+        expect(f.db.prepare("SELECT count(*) n FROM complaints").get()).toEqual({ n: 1 });
+        await watcher.tick();
+        expect(gate).toHaveBeenCalledTimes(1);
+        expect(transport.complete).toHaveBeenCalledTimes(1);
+      }
+    } finally {
+      await watcher.stop();
+    }
+  },
+);
diff --git a/extensions/alert-watcher/src/authority.ts b/extensions/alert-watcher/src/authority.ts
new file mode 100644
index 00000000000..63cd499f3a9
--- /dev/null
+++ b/extensions/alert-watcher/src/authority.ts
@@ -0,0 +1,131 @@
+import { getChannelPlugin } from "../../../src/channels/plugins/index.js";
+import type { MinionConfig } from "../../../src/config/config.js";
+import { getMirrorEntry, mirrorMeta, orgScopeSource } from "../../../src/gateway/channel-mirror.js";
+import { retentionHash } from "../../../src/infra/outbound/delivery-retention.js";
+import { isPluginEnabledForAnyOrg } from "../../../src/plugins/org-enforcement.js";
+import { normalizeAccountId } from "../../../src/routing/session-key.js";
+
+export type WatcherAuthority =
+  | { kind: "scoped"; source: "db_mirror" | "json_config"; orgIds: string[]; evidenceHash: string }
+  | { kind: "local_unscoped"; source: "json_config"; evidenceHash: string }
+  | { kind: "unavailable"; reason: string };
+export type BoundAuthority = Exclude<WatcherAuthority, { kind: "unavailable" }>;
+const unavailable = (reason: string): WatcherAuthority => ({ kind: "unavailable", reason });
+/** This deliberately does not use the compatibility resolver's JSON fallback. */
+export async function resolveWatcherAuthority(
+  cfg: MinionConfig,
+  channel: string,
+  accountId: string,
+  now = Date.now(),
+): Promise<WatcherAuthority> {
+  if (!channel || !accountId || channel.trim() !== channel || accountId.trim() !== accountId) {
+    return unavailable("invalid_account");
+  }
+  if (cfg.plugins?.entries?.["alert-watcher"]?.enabled === false) {
+    return unavailable("plugin_disabled");
+  }
+  if (orgScopeSource() === "db") {
+    const entry = getMirrorEntry(channel, accountId);
+    const at = mirrorMeta().lastHydratedAt;
+    if (
+      !entry ||
+      entry.type !== channel ||
+      entry.accountId !== accountId ||
+      typeof entry.orgId !== "string" ||
+      !entry.orgId.trim() ||
+      entry.orgId.trim() !== entry.orgId ||
+      !Object.is(entry.projection?.enabled, true) ||
+      !Number.isSafeInteger(at) ||
+      at <= 0 ||
+      at > now ||
+      now - at > 300000
+    ) {
+      return unavailable("unavailable_mirror");
+    }
+    const orgIds = [entry.orgId];
+    if (
+      !isPluginEnabledForAnyOrg(cfg, "alert-watcher", orgIds) ||
+      !isPluginEnabledForAnyOrg(cfg, channel, orgIds)
+    ) {
+      return unavailable("plugin_disabled");
+    }
+    return {
+      kind: "scoped",
+      source: "db_mirror",
+      orgIds,
+      evidenceHash: retentionHash([channel, accountId, "db_mirror", orgIds]),
+    };
+  }
+  const plugin = getChannelPlugin(channel);
+  const section = cfg.channels?.[channel] as Record<string, unknown> | undefined;
+  if (!plugin || !section || typeof section !== "object" || section.enabled === false) {
+    return unavailable("missing_account");
+  }
+  const accounts = section.accounts as Record<string, unknown> | undefined;
+  if (
+    accounts &&
+    Object.keys(accounts).filter((key) => normalizeAccountId(key) === normalizeAccountId(accountId))
+      .length > 1
+  ) {
+    return unavailable("ambiguous_account");
+  }
+  const exact = accounts && Object.hasOwn(accounts, accountId);
+  // A synthesized default from account enumeration is not a configured account.
+  if (
+    !exact &&
+    !(
+      accountId === "default" &&
+      (typeof section.botToken === "string" ||
+        typeof section.tokenFile === "string" ||
+        typeof section.token === "string")
+    )
+  ) {
+    return unavailable("missing_account");
+  }
+  const ids = plugin.config.listAccountIds(cfg);
+  if (
+    ids.filter((id) => id.toLowerCase() === accountId.toLowerCase()).length !== 1 ||
+    !ids.includes(accountId)
+  ) {
+    return unavailable("ambiguous_account");
+  }
+  try {
+    const resolved = plugin.config.resolveAccount(cfg, accountId);
+    const described = plugin.config.describeAccount?.(resolved, cfg);
+    if (
+      (plugin.config.isEnabled && !plugin.config.isEnabled(resolved, cfg)) ||
+      described?.enabled === false ||
+      !plugin.config.isConfigured ||
+      !(await plugin.config.isConfigured(resolved, cfg))
+    ) {
+      return unavailable("unconfigured_account");
+    }
+  } catch {
+    return unavailable("unconfigured_account");
+  }
+  const mapping = cfg.channels?.accountOrgs?.[channel];
+  if (!mapping || !Object.hasOwn(mapping, accountId)) {
+    return unavailable("missing_mapping");
+  }
+  const raw = mapping[accountId];
+  if (
+    !Array.isArray(raw) ||
+    raw.some((id) => typeof id !== "string" || !id.trim() || id.trim() !== id)
+  ) {
+    return unavailable("invalid_mapping");
+  }
+  const orgIds = [...new Set(raw)].sort();
+  if (
+    !isPluginEnabledForAnyOrg(cfg, "alert-watcher", orgIds) ||
+    !isPluginEnabledForAnyOrg(cfg, channel, orgIds)
+  ) {
+    return unavailable("plugin_disabled");
+  }
+  const evidenceHash = retentionHash([channel, accountId, "json_config", orgIds]);
+  return orgIds.length
+    ? { kind: "scoped", source: "json_config", orgIds, evidenceHash }
+    : { kind: "local_unscoped", source: "json_config", evidenceHash };
+}
+export function sameAuthority(bound: BoundAuthority, current: WatcherAuthority): boolean {
+  return current.kind !== "unavailable" && bound.evidenceHash === current.evidenceHash;
+}
diff --git a/extensions/alert-watcher/src/certified-runtime.ts b/extensions/alert-watcher/src/certified-runtime.ts
new file mode 100644
index 00000000000..fc18d5374dd
--- /dev/null
+++ b/extensions/alert-watcher/src/certified-runtime.ts
@@ -0,0 +1,499 @@
+import crypto from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { createGatewayDroneHost } from "../../../src/drones/host.js";
+import type { MinionPluginApi } from "../../../src/plugins/types.js";
+import type { PluginHookMessageMetadata } from "../../../src/plugins/types/hooks.js";
+import type { ResolvedConfig } from "../index.js";
+import { resolveWatcherAuthority, sameAuthority } from "./authority.js";
+import {
+  admitSource,
+  admitInvocation,
+  receiveInvocation,
+  markInvocationDispatch,
+  markSuggestionDispatch,
+  getWork,
+  createWorkDispatcher,
+  assertWorkLease,
+  observeWorkAuthority,
+  retryNoCredentials,
+  finishWork,
+  setSuggestion,
+  materializePositive,
+  type WorkLease,
+  type WorkSnapshot,
+  type SuggestionReceipt,
+  type WorkRow,
+} from "./classification-work.js";
+import { buildClassifierDrone, classifyMessage } from "./classifier.js";
+import { drainDeliveryReceipts } from "./delivery-bridge.js";
+import { certifiedOriginals, snapshotHash } from "./provenance.js";
+import { appendSuggestionsBlock } from "./reply-flow/format.js";
+import { runSuggestionsDrone } from "./reply-flow/suggestions-drone.js";
+import {
+  completeShadowReceipt,
+  qualifiedShadowContext,
+  type TrustedShadowAdapter,
+} from "./shadow-receipt.js";
+import { matchesChannelSub, matchesAgentSub } from "./subscriptions.js";
+import type { ComplaintResult } from "./types.js";
+
+const severity = { low: 0, med: 1, high: 2 };
+async function boundedOperation<T>(
+  parent: AbortSignal,
+  operation: (signal: AbortSignal) => Promise<T>,
+  timeoutMs = 30000,
+): Promise<T> {
+  const controller = new AbortController(),
+    timer = setTimeout(() => controller.abort(), timeoutMs);
+  timer.unref();
+  const signal = AbortSignal.any([parent, controller.signal]);
+  let rejectAbort: () => void = () => {};
+  const aborted = new Promise<never>((_, reject) => {
+    rejectAbort = () => reject(new Error("operation_interrupted"));
+    if (signal.aborted) {
+      rejectAbort();
+    } else {
+      signal.addEventListener("abort", rejectAbort, { once: true });
+    }
+  });
+  try {
+    return await Promise.race([operation(signal), aborted]);
+  } finally {
+    clearTimeout(timer);
+    signal.removeEventListener("abort", rejectAbort);
+  }
+}
+export function createCertifiedWatcher(
+  api: MinionPluginApi,
+  db: DatabaseSync,
+  stateDir: string,
+  config: () => ResolvedConfig,
+  format: (snapshot: WorkSnapshot, result: ComplaintResult) => string,
+  trustedShadow?: TrustedShadowAdapter,
+) {
+  const namespace = snapshotHash(["alert-watcher", stateDir]);
+  const currentConfig = () => api.runtime.config?.loadConfig?.() ?? api.config;
+  const authority = (s: WorkSnapshot) => {
+    const current = config();
+    if (
+      !matchesChannelSub(current.subscriptions, {
+        channel: s.source.channel,
+        accountId: s.source.accountId,
+      }) &&
+      !matchesAgentSub(current.subscriptions, s.agentId)
+    ) {
+      return Promise.resolve({ kind: "unavailable" as const, reason: "policy_unmatched" });
+    }
+    return resolveWatcherAuthority(currentConfig(), s.source.channel, s.source.accountId);
+  };
+  const stillAuthorized = async (lease: WorkLease, s: WorkSnapshot) => {
+    const current = await authority(s);
+    return observeWorkAuthority(db, assertWorkLease(db, lease), s, current);
+  };
+  function suppressed(snapshot: WorkSnapshot, result: ComplaintResult, row: WorkRow): boolean {
+    if (!snapshot.cooldown.enabled) {
+      return false;
+    }
+    const recent = db
+      .prepare(
+        "SELECT * FROM classification_work WHERE namespace=? AND first_sent_at IS NOT NULL ORDER BY first_sent_at DESC LIMIT 5000",
+      )
+      .all(namespace) as WorkRow[];
+    for (const previous of recent) {
+      if (!previous.snapshot) {
+        continue;
+      }
+      const p = JSON.parse(previous.snapshot) as WorkSnapshot;
+      if (
+        snapshotHash([
+          p.source.channel,
+          p.source.accountId,
+          p.source.conversationId,
+          p.source.senderId ?? "unknown",
+        ]) !==
+        snapshotHash([
+          snapshot.source.channel,
+          snapshot.source.accountId,
+          snapshot.source.conversationId,
+          snapshot.source.senderId ?? "unknown",
+        ])
+      ) {
+        continue;
+      }
+      const elapsed = Date.now() - previous.first_sent_at!;
+      if (elapsed >= snapshot.cooldown.windowMinutes * 60000) {
+        return false;
+      }
+      const originals = db
+        .prepare(
+          "SELECT snapshot FROM classification_work WHERE namespace=? AND source_counted_at>=? AND source_counted_at<=? AND id!=?",
+        )
+        .all(namespace, previous.first_sent_at!, row.source_counted_at, previous.id) as Array<{
+        snapshot: string | null;
+      }>;
+      const count = originals.filter((r) => {
+        if (!r.snapshot) {
+          return false;
+        }
+        const source = (JSON.parse(r.snapshot) as WorkSnapshot).source;
+        return (
+          snapshotHash([
+            source.channel,
+            source.accountId,
+            source.conversationId,
+            source.senderId ?? "unknown",
+          ]) ===
+          snapshotHash([
+            snapshot.source.channel,
+            snapshot.source.accountId,
+            snapshot.source.conversationId,
+            snapshot.source.senderId ?? "unknown",
+          ])
+        );
+      }).length;
+      const terminal = JSON.parse(previous.terminal_result ?? "null");
+      return (
+        count < snapshot.cooldown.maxMessages &&
+        !(
+          snapshot.cooldown.allowEscalation !== false &&
+          severity[result.severity] > severity[terminal?.data?.severity as keyof typeof severity]
+        )
+      );
+    }
+    return false;
+  }
+  async function process(lease: WorkLease, signal: AbortSignal) {
+    let row = assertWorkLease(db, lease);
+    if (!row.snapshot) {
+      throw new Error("missing_snapshot");
+    }
+    const snapshot = JSON.parse(row.snapshot) as WorkSnapshot;
+    if (signal.aborted) {
+      throw new Error("work_stopped");
+    }
+    if (!(await stillAuthorized(lease, snapshot))) {
+      finishWork(db, lease, "canceled", "authority_unavailable");
+      return;
+    }
+    if (row.state === "queued") {
+      const attemptId = admitInvocation(db, lease);
+      const host = createGatewayDroneHost({ config: currentConfig(), usageMode: "result" });
+      const timeoutController = new AbortController();
+      const deadline = setTimeout(() => timeoutController.abort(), 30000);
+      deadline.unref();
+      const combined = AbortSignal.any([signal, timeoutController.signal]);
+      try {
+        await Promise.race([
+          classifyMessage(
+            [{ role: "user", content: snapshot.source.text, ts: row.created_at }],
+            host,
+            snapshot.model,
+            combined,
+            snapshot.language,
+            snapshot.overrides,
+            {
+              attemptId,
+              purpose: "classification",
+              onDispatch: () => markInvocationDispatch(db, lease, attemptId),
+              onTerminal: (result, usage) => receiveInvocation(db, lease, result, usage),
+            },
+          ),
+          new Promise<never>((_, reject) =>
+            combined.addEventListener(
+              "abort",
+              () => reject(new Error("classification_interrupted")),
+              { once: true },
+            ),
+          ),
+        ]);
+      } catch {
+        if (getWork(db, row.id)?.state !== "received") {
+          throw new Error("classification_receipt_missing");
+        }
+      } finally {
+        clearTimeout(deadline);
+      }
+
+      row = assertWorkLease(db, lease);
+    }
+    const terminal = JSON.parse(row.terminal_result ?? "null") as {
+      ok: boolean;
+      data?: ComplaintResult;
+      error?: { code: string };
+    } | null;
+    if (!terminal) {
+      finishWork(db, lease, "failed", "missing_terminal_result");
+      return;
+    }
+    if (!terminal.ok) {
+      if (terminal.error?.code === "NO_API_KEY") {
+        retryNoCredentials(db, lease);
+        return;
+      }
+      finishWork(db, lease, "failed", terminal.error?.code ?? "invalid_sdk_result");
+      return;
+    }
+    if (signal.aborted) {
+      throw new Error("work_stopped");
+    }
+    if (!(await stillAuthorized(lease, snapshot))) {
+      finishWork(db, lease, "canceled", "authority_unavailable");
+      return;
+    }
+    await completeShadowReceipt(db, lease, snapshot, signal, trustedShadow);
+    const result = terminal.data;
+    if (
+      !result ||
+      typeof result.is_complaint !== "boolean" ||
+      !(result.severity in severity) ||
+      typeof result.category !== "string" ||
+      typeof result.summary !== "string"
+    ) {
+      finishWork(db, lease, "failed", "invalid_classification");
+      return;
+    }
+    if (signal.aborted) {
+      throw new Error("work_stopped");
+    }
+    if (!(await stillAuthorized(lease, snapshot))) {
+      finishWork(db, lease, "canceled", "authority_unavailable");
+      return;
+    }
+    if (
+      !result.is_complaint ||
+      severity[result.severity] < severity[snapshot.minSeverity] ||
+      suppressed(snapshot, result, row)
+    ) {
+      finishWork(db, lease, "completed");
+      return;
+    }
+    let suggestion = JSON.parse(row.suggestion_json) as SuggestionReceipt;
+    if (suggestion.state === "not_requested") {
+      if (snapshot.replyFlow.enabled && snapshot.replyFlow.suggestions.enabled) {
+        setSuggestion(db, lease, { state: "queued" });
+        suggestion = { state: "queued" };
+      } else {
+        suggestion = { state: "received", suggestions: [] };
+        setSuggestion(db, lease, suggestion);
+      }
+    }
+    if (suggestion.state === "queued") {
+      if (signal.aborted) {
+        throw new Error("work_stopped");
+      }
+      if (!(await stillAuthorized(lease, snapshot))) {
+        finishWork(db, lease, "canceled", "authority_unavailable");
+        return;
+      }
+      const attemptId = crypto.randomUUID();
+      suggestion = { state: "admitted", attemptId, dispatchStatus: "preparing" };
+      setSuggestion(db, lease, suggestion);
+      try {
+        await boundedOperation(signal, (suggestionSignal) =>
+          runSuggestionsDrone(
+            createGatewayDroneHost({ config: currentConfig(), usageMode: "result" }),
+            snapshot.model,
+            {
+              language: snapshot.language,
+              severity: result.severity,
+              category: result.category,
+              summary: result.summary,
+              senderMessage: snapshot.source.text,
+              systemPrompt: snapshot.overrides.systemPrompt ?? "",
+              count: snapshot.replyFlow.suggestions.count,
+              maxChars: snapshot.replyFlow.suggestions.maxChars,
+            },
+            {
+              attemptId,
+              purpose: "suggestion",
+              onDispatch: () => markSuggestionDispatch(db, lease, attemptId),
+              signal: suggestionSignal,
+              onTerminal: (terminalResult, usage) => {
+                if (suggestionSignal.aborted) {
+                  throw new Error("suggestion_interrupted");
+                }
+                const replies = terminalResult.ok
+                  ? (terminalResult.data as { replies?: unknown }).replies
+                  : undefined;
+                const suggestions = Array.isArray(replies)
+                  ? replies
+                      .filter((s): s is string => typeof s === "string")
+                      .map((s) => s.trim())
+                      .filter(Boolean)
+                      .slice(0, snapshot.replyFlow.suggestions.count)
+                  : [];
+                setSuggestion(db, lease, {
+                  state: "received",
+                  attemptId,
+                  result: terminalResult,
+                  usage,
+                  suggestions,
+                  ...(!terminalResult.ok ? { reason: "suggestions_unavailable" } : {}),
+                });
+              },
+            },
+          ),
+        );
+      } catch {
+        const latest = JSON.parse(getWork(db, row.id)!.suggestion_json) as SuggestionReceipt;
+        if (latest.state !== "received") {
+          setSuggestion(db, lease, {
+            state: "indeterminate",
+            attemptId,
+            suggestions: [],
+            reason: "suggestions_unavailable",
+          });
+        }
+      }
+      row = assertWorkLease(db, lease);
+      suggestion = JSON.parse(row.suggestion_json) as SuggestionReceipt;
+    }
+    if (signal.aborted) {
+      throw new Error("work_stopped");
+    }
+    if (!(await stillAuthorized(lease, snapshot))) {
+      finishWork(db, lease, "canceled", "authority_unavailable");
+      return;
+    }
+    let text = format(snapshot, result);
+    if (snapshot.replyFlow.enabled) {
+      text = appendSuggestionsBlock(text, suggestion.suggestions ?? [], snapshot.language);
+    }
+    if (suggestion.reason) {
+      text +=
+        snapshot.language === "es" ? "\nSugerencias no disponibles." : "\nSuggestions unavailable.";
+    }
+    const configured = config().destinations;
+    const recipients = snapshot.destinations.filter((d) =>
+      configured.some(
+        (c) =>
+          snapshotHash([c.channel, c.accountId ?? "default", c.to]) ===
+          snapshotHash([d.channel, d.accountId ?? "default", d.to]),
+      ),
+    );
+    materializePositive(db, lease, result, text, recipients);
+    finishWork(db, lease, "completed");
+  }
+  const dispatcher = createWorkDispatcher(db, {
+    authority,
+    process,
+    deliver: (signal) =>
+      drainDeliveryReceipts(db, {
+        stateDir,
+        signal,
+        config: currentConfig,
+        recipientAllowed: async (snapshot, recipient) => {
+          const bound =
+            snapshot.destinationAuthorities?.[
+              snapshotHash([recipient.channel, recipient.accountId ?? "default", recipient.to])
+            ];
+          if (!bound) {
+            return false;
+          }
+          const current = await resolveWatcherAuthority(
+            currentConfig(),
+            recipient.channel,
+            recipient.accountId ?? "default",
+          );
+          return sameAuthority(bound, current);
+        },
+        authority,
+        destinations: () => config().destinations,
+      }),
+    onError: () =>
+      api.logger.warn("alert-watcher: durable work processing failed; receipt retained"),
+  });
+  return {
+    async admit(
+      event: {
+        channel: string;
+        accountId: string;
+        chatId: string;
+        metadata?: PluginHookMessageMetadata;
+      },
+      agentId?: string,
+    ): Promise<boolean> {
+      const sources = certifiedOriginals(event.metadata?.sourceProvenance, {
+        channel: event.channel,
+        accountId: event.accountId,
+        conversationId: event.chatId,
+      });
+      if (!sources) {
+        return false;
+      }
+      for (const source of sources) {
+        const cfg = config();
+        const resolved = await resolveWatcherAuthority(
+          currentConfig(),
+          source.channel,
+          source.accountId,
+        );
+        if (resolved.kind === "unavailable") {
+          continue;
+        }
+        const overrides = {
+          systemPrompt: cfg.classifier.systemPrompt,
+          severityRubric: cfg.classifier.severityRubric,
+          categories: cfg.classifier.categories,
+        };
+        const policyHash = snapshotHash(
+          buildClassifierDrone(cfg.classifier.model, cfg.language, overrides).definition,
+        );
+        const defaultPolicyHash = snapshotHash(
+          buildClassifierDrone(cfg.classifier.model, cfg.language, undefined).definition,
+        );
+        const destinationAuthorities: NonNullable<WorkSnapshot["destinationAuthorities"]> = {};
+        for (const recipient of cfg.destinations) {
+          const target = await resolveWatcherAuthority(
+            currentConfig(),
+            recipient.channel,
+            recipient.accountId ?? "default",
+          );
+          if (target.kind === "unavailable") {
+            continue;
+          }
+          if (
+            resolved.kind === "scoped" &&
+            target.kind === "scoped" &&
+            snapshotHash(resolved.orgIds) !== snapshotHash(target.orgIds)
+          ) {
+            continue;
+          }
+          destinationAuthorities[
+            snapshotHash([recipient.channel, recipient.accountId ?? "default", recipient.to])
+          ] = target;
+        }
+        admitSource(db, namespace, {
+          source,
+          authority: resolved,
+          agentId,
+          model: cfg.classifier.model,
+          language: cfg.language,
+          overrides,
+          minSeverity: cfg.classifier.minSeverity,
+          cooldown: cfg.cooldown,
+          destinations: cfg.destinations,
+          destinationAuthorities,
+          replyFlow: cfg.replyFlow,
+          mode: cfg.complaintExperiment.mode,
+          policyHash,
+          defaultPolicyHash,
+          qualifiedModelRevision: qualifiedShadowContext(
+            { model: cfg.classifier.model, policyHash },
+            trustedShadow,
+          )
+            ? trustedShadow!.context.modelRevision
+            : undefined,
+          customPolicy:
+            cfg.classifier.systemPrompt !== undefined ||
+            cfg.classifier.severityRubric !== undefined ||
+            cfg.classifier.categories !== undefined,
+        });
+      }
+      await dispatcher.tick();
+      return true;
+    },
+    tick: dispatcher.tick,
+    stop: dispatcher.stop,
+  };
+}
