+        db.prepare(
+          "UPDATE classification_work SET shadow_json=?,receipt_revision=receipt_revision+1 WHERE id=?",
+        ).run(
+          boundedJson({ ...shadow, state: "indeterminate", disposition: "unavailable" }),
+          row.id,
+        );
+      }
+      const s = JSON.parse(row.suggestion_json) as SuggestionReceipt;
+      if (s.state === "admitted") {
+        db.prepare(
+          "UPDATE classification_work SET suggestion_json=?,receipt_revision=receipt_revision+1 WHERE id=?",
+        ).run(
+          boundedJson(
+            { ...s, state: "indeterminate", suggestions: [], reason: "admitted_owner_expired" },
+            16384,
+          ),
+          row.id,
+        );
+      }
+    }
+  });
+}
+export function setSuggestion(
+  db: DatabaseSync,
+  lease: WorkLease,
+  suggestion: SuggestionReceipt,
+): void {
+  const row = assertWorkLease(db, lease);
+  const previous = JSON.parse(row.suggestion_json) as SuggestionReceipt;
+  const allowed: Record<SuggestionReceipt["state"], SuggestionReceipt["state"][]> = {
+    not_requested: ["queued", "received"],
+    queued: ["admitted"],
+    admitted: ["received", "indeterminate"],
+    received: [],
+    indeterminate: [],
+  };
+  if (!allowed[previous.state].includes(suggestion.state)) {
+    throw new Error("invalid_suggestion_transition");
+  }
+  if (previous.attemptId && suggestion.attemptId !== previous.attemptId) {
+    throw new Error("suggestion_identity_conflict");
+  }
+  if (suggestion.state === "received" && suggestion.result) {
+    const notSubmitted =
+      previous.dispatchStatus === "preparing" &&
+      suggestion.usage?.dispatchStatus !== "may_have_submitted" &&
+      !suggestion.result.ok &&
+      suggestion.result.error.code === "NO_API_KEY";
+    suggestion = {
+      ...suggestion,
+      dispatchStatus: notSubmitted ? "not_submitted" : "may_have_submitted",
+      ...(suggestion.usage && !suggestion.result.ok
+        ? {
+            usage: {
+              ...suggestion.usage,
+              dispatchStatus: notSubmitted ? "not_submitted" : "may_have_submitted",
+              costStatus: notSubmitted ? "known" : "unknown",
+              costUsd: notSubmitted ? 0 : null,
+              costCoverage: notSubmitted ? "complete" : "incomplete",
+            },
+          }
+        : {}),
+    };
+  }
+  let serialized: string;
+  try {
+    serialized = boundedJson(suggestion, 16384);
+  } catch {
+    if (suggestion.state !== "received" || !suggestion.result) {
+      throw new Error("suggestion_snapshot_too_large");
+    }
+    serialized = boundedJson(
+      {
+        ...suggestion,
+        suggestions: [],
+        reason: "suggestions_result_too_large",
+        result: {
+          ok: false,
+          error: { code: "RESULT_TOO_LARGE", message: "bounded result unavailable" },
+          durationMs: suggestion.result.durationMs,
+          usage: suggestion.result.usage,
+        },
+      },
+      16384,
+    );
+  }
+  db.prepare(
+    "UPDATE classification_work SET suggestion_json=?,receipt_revision=receipt_revision+1 WHERE id=?",
+  ).run(serialized, row.id);
+}
