+      "UPDATE classification_work SET state='admitted',attempt_id=?,attempt_count=attempt_count+1,admitted_at=?,attempts_json=?,terminal_result=NULL,usage_json=NULL,received_at=NULL,receipt_revision=receipt_revision+1 WHERE id=?",
