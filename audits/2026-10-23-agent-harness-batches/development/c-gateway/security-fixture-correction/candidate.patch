+export type WorkDispatcherDeps = {
+  authority: (snapshot: WorkSnapshot) => Promise<WatcherAuthority>;
+  process: (lease: WorkLease, signal: AbortSignal) => Promise<void>;
+  deliver: (signal: AbortSignal) => Promise<void>;
+  onError: (error: unknown) => void;
+};
+/** Bounded local lifecycle; SQLite remains the cross-process owner. */
+export function createWorkDispatcher(db: DatabaseSync, deps: WorkDispatcherDeps) {
+  const owner = crypto.randomUUID();
+  let stopped = false;
+  let current: Promise<void> | undefined;
+  let controller: AbortController | undefined;
+  const tick = (): Promise<void> => {
+    if (stopped) {
+      return Promise.resolve();
+    }
+    if (current) {
+      return current;
+    }
+    current = (async () => {
+      recoverExpiredInvocations(db);
+      redactExpiredWork(db);
+      const rows = db
+        .prepare(
+          "SELECT * FROM classification_work WHERE state IN ('queued','received') AND next_attempt_at<=? AND namespace_retired=0 ORDER BY next_attempt_at,created_at LIMIT 10",
+        )
+        .all(Date.now()) as WorkRow[];
+      for (const row of rows) {
+        if (stopped) {
+          break;
+        }
+        if (!row.snapshot) {
+          continue;
+        }
+        const snapshot = JSON.parse(row.snapshot) as WorkSnapshot;
+        const authority = await deps.authority(snapshot);
+        if (!observeWorkAuthority(db, row, snapshot, authority)) {
+          // A fenced deferral preserves the frozen receipt without starving later sources.
+          db.prepare(
+            "UPDATE classification_work SET next_attempt_at=? WHERE id=? AND generation=? AND state=? AND (lease_owner IS NULL OR lease_expires_at<=?)",
+          ).run(Date.now() + 5000, row.id, row.generation, row.state, Date.now());
+          continue;
+        }
+        const lease = claimWork(db, row.id, owner);
+        if (!lease) {
+          continue;
+        }
+        controller = new AbortController();
+        let leaseLost = false;
+        const renewal = setInterval(() => {
+          try {
+            renewWork(db, lease);
+          } catch {
+            leaseLost = true;
+            controller?.abort();
+          }
+        }, 10000);
+        renewal.unref();
+        try {
+          await deps.process(lease, controller.signal);
+        } catch (err) {
+          deps.onError(err);
+          if (!leaseLost) {
+            const latest = getWork(db, row.id);
+            try {
+              if (latest?.state === "admitted") {
+                finishWork(db, lease, "indeterminate", "invocation_interrupted");
+              } else if (latest?.state === "received") {
+                finishWork(db, lease, "failed", "local_processing_failed");
+              } else {
+                finishWork(db, lease, "failed", "dispatch_failed");
+              }
+            } catch {
+              /* Successor owns settlement. */
+            }
+          }
+        } finally {
+          clearInterval(renewal);
+          controller = undefined;
+        }
+      }
+      if (!stopped) {
+        controller = new AbortController();
+        try {
+          await deps.deliver(controller.signal);
+        } finally {
+          controller = undefined;
+        }
+      }
+    })()
+      .catch(deps.onError)
+      .finally(() => {
+        current = undefined;
+      });
+    return current;
+  };
+  const interval = setInterval(() => {
+    void tick();
+  }, 5000);
+  interval.unref();
+  return {
+    tick,
+    async stop() {
+      stopped = true;
+      clearInterval(interval);
+      controller?.abort();
+      if (current) {
+        await Promise.race([
+          current,
+          new Promise<void>((resolve) => {
+            const timer = setTimeout(resolve, 31000);
+            timer.unref();
+          }),
+        ]);
+      }
+      return current === undefined;
+    },
+  };
+}
