+import fs from "node:fs";
+import { Ajv } from "ajv";
+import { it, expect, vi } from "vitest";
+import {
+  admitSource,
+  claimWork,
+  admitInvocation,
+  receiveInvocation,
+  finishWork,
+} from "./classification-work.js";
+import { exportComplaintEvaluation } from "./complaint-evaluation.js";
+import { complaintEligibility, runComplaintShadow } from "./jev-shadow-eligibility.js";
+import { testDb, workFixture } from "./work-test-fixtures.js";
+const eligible = {
+  mode: "census" as const,
+  enabled: true,
+  matched: true,
+  certified: true,
+  customPolicy: false,
+  modelQualified: true,
+  bindingValid: true,
+};
+it("qualifies certified reviewed defaults and bypasses custom, missing originals and model drift", () => {
+  expect(complaintEligibility(eligible)).toEqual({ status: "eligible", reason: "eligible" });
+  for (const [patch, reason] of [
+    [{ customPolicy: true }, "custom_policy"],
+    [{ certified: false }, "uncertified_source"],
+    [{ modelQualified: false }, "model_drift"],
+    [{ bindingValid: false }, "invalid_binding"],
+    [{ mode: "off" }, "mode_off"],
+  ] as const) {
+    expect(complaintEligibility({ ...eligible, ...patch })).toHaveProperty("reason", reason);
+  }
+});
+it("software config does not grant paid admission; missing or unbounded context is unavailable", async () => {
+  const adapter = vi.fn(async () => "negative" as const);
+  expect(
+    await runComplaintShadow(undefined, { policyHash: "x", modelRevision: "x" }, adapter),
+  ).toBe("unavailable");
+  expect(adapter).not.toHaveBeenCalled();
+});
+it("durable exporter uses monotonic revisions, schema validity and stable single-source identity", () => {
+  const db = testDb();
+  const work = admitSource(db, "namespace", workFixture());
+  if (work.kind !== "admitted") {
+    throw Error();
+  }
+  const initial = exportComplaintEvaluation(db, work.work.id);
+  const lease = claimWork(db, work.work.id, "owner")!,
+    attemptId = admitInvocation(db, lease);
+  const admitted = exportComplaintEvaluation(db, work.work.id);
+  expect(admitted.receiptRevision).toBeGreaterThan(initial.receiptRevision);
+  const result = {
+    ok: false as const,
+    error: { code: "SCHEMA_INVALID" as const, message: "stub" },
+    usage: { inputTokens: 10, outputTokens: 5 },
+    durationMs: 5,
+  };
+  receiveInvocation(db, lease, result, {
+    attemptId,
+    purpose: "classification",
+    requestedModel: { provider: "anthropic", model: workFixture().model },
+    resolvedModel: null,
+    usage: result.usage,
+    costStatus: "unknown",
+    costUsd: null,
+    costCoverage: "incomplete",
+    elapsedMs: 5,
+  });
+  finishWork(db, lease, "failed", "SCHEMA_INVALID");
+  const terminal = exportComplaintEvaluation(db, work.work.id);
+  expect(terminal.receiptRevision).toBeGreaterThan(admitted.receiptRevision);
+  expect(terminal.recordId).toBe(initial.recordId);
+  expect(terminal.logicalSourceId).toBe(initial.logicalSourceId);
+  expect(terminal.baseline.disposition).toBe("failed");
+  expect(terminal.attempts[0]).toMatchObject({ attemptId, costStatus: "unknown", costUsd: null });
+  const schema = JSON.parse(
+    fs.readFileSync(new URL("./complaint-evaluation.schema.json", import.meta.url), "utf8"),
+  );
+  const ajv = new Ajv({ strict: false, validateFormats: false });
+  const validate = ajv.compile(schema);
+  expect(validate(terminal), JSON.stringify(validate.errors)).toBe(true);
+  expect(exportComplaintEvaluation(db, work.work.id)).toEqual(terminal);
+  db.close();
+});
diff --git a/extensions/alert-watcher/src/jev-shadow-eligibility.ts b/extensions/alert-watcher/src/jev-shadow-eligibility.ts
new file mode 100644
index 00000000000..11366c1dd95
--- /dev/null
+++ b/extensions/alert-watcher/src/jev-shadow-eligibility.ts
@@ -0,0 +1,100 @@
+export type ExperimentMode = "off" | "census" | "shadow";
+export type Eligibility = {
+  status: "eligible" | "bypass" | "disabled";
+  reason:
+    | "eligible"
+    | "mode_off"
+    | "plugin_disabled"
+    | "unmatched"
+    | "uncertified_source"
+    | "custom_policy"
+    | "model_drift"
+    | "invalid_binding";
+};
+export function resolveComplaintExperiment(value: unknown): { mode: ExperimentMode } {
+  if (value === undefined) {
+    return { mode: "off" };
+  }
+  if (
+    !value ||
+    typeof value !== "object" ||
+    Array.isArray(value) ||
+    Object.keys(value).some((k) => k !== "mode")
+  ) {
+    throw new Error("invalid complaintExperiment");
+  }
+  const mode = (value as { mode?: unknown }).mode;
+  if (mode !== undefined && mode !== "off" && mode !== "census" && mode !== "shadow") {
+    throw new Error("invalid complaintExperiment.mode");
+  }
+  return { mode: mode ?? "off" };
+}
+export function complaintEligibility(i: {
+  mode: ExperimentMode;
+  enabled: boolean;
+  matched: boolean;
+  certified: boolean;
+  customPolicy: boolean;
+  modelQualified: boolean;
+  bindingValid: boolean;
+}): Eligibility {
+  if (!i.enabled) {
+    return { status: "disabled", reason: "plugin_disabled" };
+  }
+  if (i.mode === "off") {
+    return { status: "disabled", reason: "mode_off" };
+  }
+  for (const [pass, reason] of [
+    [i.matched, "unmatched"],
+    [i.certified, "uncertified_source"],
+    [!i.customPolicy, "custom_policy"],
+    [i.bindingValid, "invalid_binding"],
+    [i.modelQualified, "model_drift"],
+  ] as const) {
+    if (!pass) {
+      return { status: "bypass", reason };
+    }
+  }
+  return { status: "eligible", reason: "eligible" };
+}
+/** No config/RPC can mint this separately trusted experiment context. */
+export type ApprovedShadowContext = {
+  manifestHash: string;
+  policyHash: string;
+  modelRevision: string;
+  gateRevision: string;
+  remainingExposureUsd: number;
+  expiresAt: number;
+  maxInvocationCostUsd: number;
+};
+export async function runComplaintShadow(
+  context: ApprovedShadowContext | undefined,
+  binding: { policyHash: string; modelRevision: string },
+  adapter:
+    | ((context: ApprovedShadowContext) => Promise<"forward" | "negative" | "abstain">)
+    | undefined,
+): Promise<"forward" | "negative" | "abstain" | "unavailable"> {
+  if (
+    !context ||
+    !adapter ||
+    !/^[a-f0-9]{64}$/.test(context.manifestHash) ||
+    context.policyHash !== binding.policyHash ||
+    context.modelRevision !== binding.modelRevision ||
+    !context.gateRevision ||
+    context.expiresAt <= Date.now() ||
+    !Number.isFinite(context.remainingExposureUsd) ||
+    !Number.isFinite(context.maxInvocationCostUsd) ||
+    context.maxInvocationCostUsd < 0 ||
+    context.remainingExposureUsd < context.maxInvocationCostUsd
+  ) {
+    return "unavailable";
+  }
+  try {
+    const result = await adapter(context);
+    return result === "forward" || result === "negative" || result === "abstain"
+      ? result
+      : "unavailable";
+  } catch {
+    return "unavailable";
+  }
+}
