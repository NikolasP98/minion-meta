+export function admitInvocation(db: DatabaseSync, lease: WorkLease, now = Date.now()): string {
+  return immediate(db, () => {
+    const row = assertWorkLease(db, lease, now);
+    if (row.state !== "queued" || row.attempt_count >= 3 || row.next_attempt_at > now) {
+      throw new Error("invalid_dispatch");
+    }
+    const id = crypto.randomUUID();
+    const attempts = JSON.parse(row.attempts_json) as Array<Record<string, unknown>>;
+    attempts.push({ attemptId: id, disposition: "admitted", dispatchStatus: "preparing" });
