+  });
+}
+export function finishWork(
+  db: DatabaseSync,
+  lease: WorkLease,
+  state: "completed" | "failed" | "canceled" | "indeterminate",
+  reason?: string,
+  now = Date.now(),
+): void {
+  const row = assertWorkLease(db, lease, now);
+  db.prepare(
+    "UPDATE classification_work SET state=?,safe_error=?,completed_at=?,lease_owner=NULL,lease_expires_at=NULL,receipt_revision=receipt_revision+1 WHERE id=?",
+  ).run(state, reason?.slice(0, 128) ?? null, now, row.id);
