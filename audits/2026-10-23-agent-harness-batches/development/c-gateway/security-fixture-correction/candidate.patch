+      !row ||
+      row.namespace_retired ||
+      row.payload_expires_at <= now ||
+      !["queued", "received"].includes(row.state) ||
+      row.next_attempt_at > now ||
+      (row.lease_owner !== null && (row.lease_expires_at ?? 0) > now) ||
+      (row.attempt_count >= 3 && row.state === "queued")
+    ) {
+      return undefined;
+    }
+    const r = db
+      .prepare(
+        `UPDATE classification_work SET lease_owner=?, generation=generation+1,lease_expires_at=? WHERE id=? AND generation=? AND state=? AND next_attempt_at<=? AND (lease_owner IS NULL OR lease_expires_at<=?)`,
+      )
+      .run(owner, now + 30000, id, row.generation, row.state, now, now);
+    return r.changes ? { id, owner, generation: row.generation + 1 } : undefined;
+  });
