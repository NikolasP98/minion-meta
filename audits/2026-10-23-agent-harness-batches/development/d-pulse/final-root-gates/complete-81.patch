+            MINION_PULSE_CRASH_CHECKPOINT: checkpoint,
+          },
+          stdio: ['ignore', 'pipe', 'pipe'],
+        });
+        const timer = setTimeout(() => {
+          child.kill('SIGKILL');
+          reject(new Error('Owned crash child timed out'));
+        }, 20_000);
+        timer.unref();
+        child.once('error', (error) => {
