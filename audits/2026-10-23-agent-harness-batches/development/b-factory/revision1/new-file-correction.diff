+/** Exact binary64 encoding makes receipt numbers independent of Python/JS
+ * decimal JSON formatting. The persisted bill itself is never quantized. */
+export function jevReceiptRevision(rows: unknown[], incomplete: boolean): string {
+	const canonical = (value: unknown): unknown => {
+		if (typeof value === 'number') {
+			if (!Number.isFinite(value)) throw new Error('non-finite accounting number');
+			const bytes = Buffer.allocUnsafe(8);
+			bytes.writeDoubleBE(value);
+			return { $f64: bytes.toString('hex') };
+		}
+		return Array.isArray(value) ? value.map(canonical) : value;
+	};
+	return createHash('sha256')
+		.update(JSON.stringify(canonical([rows, incomplete])))
+		.digest('hex');
+}
