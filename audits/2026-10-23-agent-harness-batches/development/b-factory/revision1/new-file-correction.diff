+def receipt_revision(rows, incomplete):
+    # Hash the exact binary64 value, not a language's decimal JSON spelling.
+    # Typed objects cannot collide with the fixed tuple/string/null row fields.
+    def canonical(value):
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            number = float(value)
+            if not math.isfinite(number):
+                raise ValueError('non-finite accounting number')
+            return {'$f64': struct.pack('>d', number).hex()}
+        if isinstance(value, list):
+            return [canonical(v) for v in value]
+        return value
+    encoded = json.dumps(canonical([rows, incomplete]), separators=(',', ':'), ensure_ascii=False)
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+def accounting_json(text):
+    # JavaScript parses every JSON number as binary64, including integer tokens.
+    # Matching that boundary also keeps summation and hash inputs consistent.
+    return json.loads(text, parse_int=float, parse_float=float)
+
+def subtotal_text(value):
+    # Keep the old six-decimal presentation only when it preserves the bill.
+    fixed = format(value, '.6f')
