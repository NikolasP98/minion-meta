+it("tombstones erase exact atomic backup/temp, failed mirror/error copies and preserve unrelated payloads", async () => {
+  const { enforceDeliveryRetention, cleanupRetainedQueueFiles, resolveFailedDir } =
+    await import("./delivery-queue-files.js");
+  const stateDir = dir(),
+    p = params(Date.now() - 1);
+  await enqueueDelivery(p, stateDir);
+  const raw = JSON.parse(fs.readFileSync(resolveEntryPath(p.id, stateDir), "utf8"));
+  raw.mirror = { sessionKey: "private-session", text: "private mirror" };
+  raw.lastError = "private error";
+  const bytes = JSON.stringify(raw),
+    canonical = resolveEntryPath(p.id, stateDir);
+  fs.writeFileSync(canonical, bytes);
+  const copies = [
+    canonical + `.bak-${process.pid}-${crypto.randomUUID()}`,
+    canonical + `.tmp-${process.pid}-${crypto.randomUUID()}`,
+    path.join(resolveFailedDir(stateDir), `${p.id}.json`),
+    path.join(resolveFailedDir(stateDir), `${p.id}.json.tmp-${process.pid}-${crypto.randomUUID()}`),
+  ];
+  for (const file of copies) {
+    fs.writeFileSync(file, bytes);
+  }
+  const unrelated = [
+    canonical + ".bak-not-a-writer",
+    canonical + ".tmp-other",
+    path.join(path.dirname(canonical), `${crypto.randomUUID()}.json`),
+  ];
+  for (const file of unrelated) {
+    fs.writeFileSync(file, "unrelated live legacy bytes");
+  }
+  const lease = await acquireDeliveryEntryLease(p.id, stateDir);
+  try {
+    expect(
+      await enforceDeliveryRetention(await readQueuedDelivery(p.id, stateDir), lease, stateDir),
+    ).toBe(false);
+  } finally {
+    await releaseDeliveryQueueLease(lease);
+  }
+  for (const file of [canonical, ...copies]) {
+    expect(fs.existsSync(file)).toBe(false);
+  }
+  for (const file of unrelated) {
+    expect(fs.readFileSync(file, "utf8")).toBe("unrelated live legacy bytes");
+  }
+  expect(JSON.stringify(await readDeliveryTombstone(p.id, stateDir))).not.toContain("private");
+  // A new exact-format leftover after a failed cleanup is retried using the
+  // authoritative tombstone even when no canonical queue file remains.
+  fs.writeFileSync(copies[0], bytes);
+  const unlink = fs.promises.unlink.bind(fs.promises);
+  const fault = vi.spyOn(fs.promises, "unlink").mockImplementation(async (file) => {
+    if (String(file) === copies[0]) {
+      throw Error("cleanup fault");
+    }
+    return unlink(file);
+  });
+  await expect(cleanupRetainedQueueFiles(stateDir)).rejects.toThrow("cleanup fault");
+  await expect(readQueuedDelivery(p.id, stateDir)).rejects.toThrow("tombstone");
+  fault.mockRestore();
+  await cleanupRetainedQueueFiles(stateDir);
+  expect(fs.existsSync(copies[0])).toBe(false);
+  for (const file of unrelated) {
+    expect(fs.existsSync(file)).toBe(true);
+  }
+});
