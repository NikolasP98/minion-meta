    {
      "name": "prompt-permission-numeric-id-collision",
      "$comment": "The agent's permission request reuses the numeric id of the client's in-flight prompt. A correct client must treat it as a request (it has `method`), answer it under that id, and keep the prompt pending until the prompt response arrives.",
      "steps": [
        {
          "dir": "client->agent",
          "kind": "request",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": 1
            }
          },
          "match": {
            "method": "initialize"
          }
        },
        {
          "dir": "agent->client",
          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": "$last",
            "result": {
              "protocolVersion": 1,
              "agentCapabilities": {
                "loadSession": false
              },
              "authMethods": []
            }
          }
        },
        {
          "dir": "client->agent",
          "kind": "request",
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "session/new",
            "params": {
              "cwd": "/private/work",
              "mcpServers": []
            }
          },
          "match": {
            "method": "session/new"
          }
        },
        {
          "dir": "agent->client",
          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": "$last",
            "result": {
              "sessionId": "sess-a1"
            }
          }
        },
        {
          "dir": "client->agent",
          "kind": "request",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "session/prompt",
            "params": {
              "sessionId": "sess-a1",
              "prompt": [
                {
                  "type": "text",
                  "text": "update the config"
                }
              ]
            }
          },
          "match": {
            "method": "session/prompt",
            "params": {
              "sessionId": "sess-a1",
              "prompt": [
                {
                  "type": "text",
                  "text": "update the config"
                }
              ]
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "notification",
          "message": {
            "jsonrpc": "2.0",
            "method": "session/update",
            "params": {
              "sessionId": "sess-a1",
              "update": {
                "sessionUpdate": "agent_message_chunk",
                "content": {
                  "type": "text",
                  "text": "Reading config."
                }
              }
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "notification",
          "message": {
            "jsonrpc": "2.0",
            "method": "session/update",
            "params": {
              "sessionId": "sess-a1",
              "update": {
                "sessionUpdate": "tool_call",
                "toolCallId": "call_2",
                "title": "Modify config.json",
                "kind": "edit",
                "status": "pending"
              }
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "request",
          "message": {
            "jsonrpc": "2.0",
            "id": "$last",
            "method": "session/request_permission",
            "params": {
              "sessionId": "sess-a1",
              "toolCall": {
                "toolCallId": "call_2",
                "title": "Modify config.json",
                "kind": "edit",
                "status": "pending"
              },
              "options": [
                {
                  "optionId": "allow",
                  "name": "Allow once",
                  "kind": "allow_once"
                },
                {
                  "optionId": "reject",
                  "name": "Reject once",
                  "kind": "reject_once"
                }
              ]
            }
          }
        },
        {
          "dir": "client->agent",
          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "outcome": {
                "outcome": "selected",
                "optionId": "allow"
              }
            }
          },
          "match": {
            "result": {
              "outcome": {
                "outcome": "selected",
                "optionId": "allow"
              }
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "notification",
          "message": {
            "jsonrpc": "2.0",
            "method": "session/update",
            "params": {
              "sessionId": "sess-a1",
              "update": {
                "sessionUpdate": "tool_call_update",
                "toolCallId": "call_2",
                "status": "completed"
              }
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": "$last",
            "result": {
              "stopReason": "end_turn"
            }
          }
        }
      ]
