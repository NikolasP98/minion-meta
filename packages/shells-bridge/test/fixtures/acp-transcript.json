{
  "$comment": "Synthetic ACP v1 transcript. Shapes follow schema/schema.json of @agentclientprotocol/sdk@1.4.0 (gitHead e6463f444093ed7c5f1cc937c3f32afb5853e906). Every step is labelled by direction and JSON-RPC kind so a test can prove requests, responses and notifications are told apart. This is NOT a recording of a real harness; it proves adapter behaviour against a scripted peer only. Placeholders: id \"$last\" = the client's most recent request id (used to force id collisions); raw \"$oversize\" = one line longer than the client's byte ceiling; `match` = subset the client's actual line must contain.",
  "protocolVersion": 1,
  "scenarios": [
    {
      "name": "initialize",
      "steps": [
        {
          "dir": "client->agent",
          "kind": "request",
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
              "protocolVersion": 1,
              "clientCapabilities": {
                "fs": {
                  "readTextFile": false,
                  "writeTextFile": false
                },
                "terminal": false
              }
            }
          },
          "match": {
            "method": "initialize",
            "params": {
              "protocolVersion": 1
            }
          }
        },
        {
          "dir": "agent->client",
          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": "$last",
            "result": {
              "protocolVersion": 1,
              "agentCapabilities": {
                "loadSession": false,
                "promptCapabilities": {
                  "image": false,
                  "audio": false,
                  "embeddedContext": false
                }
              },
              "authMethods": []
            }
          }
        }
      ]
    },
