          "kind": "response",
          "message": {
            "jsonrpc": "2.0",
            "id": "perm-7",
            "result": {
              "outcome": {
                "outcome": "selected",
                "optionId": "no"
              }
            }
          },
          "match": {
            "id": "perm-7",
            "result": {
              "outcome": {
                "outcome": "selected",
                "optionId": "no"
